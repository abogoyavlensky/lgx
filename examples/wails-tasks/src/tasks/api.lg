(ns tasks.api
  (:require [integrant.core :as ig]
            [string :as str]
            [tasks.db :as db]
            [wails.core :as w]))

;; What the frontend calls, one fn per call. Each takes the connection
;; first, then the plain values JavaScript sends; the handlers component
;; below supplies the connection.

(defn- title! [s]
  (let [t (str/trim (str s))]
    (when (str/blank? t)
      (throw (ex-info "A task needs a title." {})))
    t))

(defn list-tasks [conn] (db/list-tasks conn))

(defn add-task [conn title] (db/add-task! conn (title! title)))

(defn update-task
  "changes is the JS object {title?, notes?}; keys arrive as strings."
  [conn id changes]
  (let [c (cond-> {}
            (contains? changes "title") (assoc :title (title! (get changes "title")))
            (contains? changes "notes") (assoc :notes (str (get changes "notes"))))]
    (or (db/update-task! conn id c)
        (throw (ex-info (str "No task " id ".") {:id id})))))

(defn toggle-task [conn id]
  (or (db/toggle-task! conn id)
      (throw (ex-info (str "No task " id ".") {:id id}))))

(defn delete-task [conn id] (db/delete-task! conn id))

(defn clear-done [conn] (db/clear-done! conn))

;; By var, not by fn value: a var reads its current definition on every
;; call, so redefining any of these from the nREPL changes what the next
;; frontend call runs, with no restart and no re-registration.
(def handlers
  {"list-tasks" #'list-tasks
   "add-task" #'add-task
   "update-task" #'update-task
   "toggle-task" #'toggle-task
   "delete-task" #'delete-task
   "clear-done" #'clear-done})

;; Registers every handler over the connection. (partial #'f db) keeps the
;; var, so it stays hot. Wails has no way to unregister; a halted system
;; leaves the handlers in place, and the process ends right after anyway.
(defmethod ig/init-key ::handlers [_ {:keys [db]}]
  (doseq [[name v] handlers]
    (w/handler! name (partial v db)))
  (set (keys handlers)))
