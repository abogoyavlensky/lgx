(ns tasks.api-test
  (:require [tasks.api :as api]
            [tasks.db-test :refer [with-conn]]
            [string :as str]
            [clojure.test :refer [deftest is]]))

;; The handlers as plain fns over a throwaway db: what the frontend calls,
;; minus the bridge (wails' own tests cover that).

(defn- message-of [f]
  (try (f) nil (catch e (ex-message e))))

(deftest handlers-round-trip
  (with-conn
    (fn [c]
      (let [{:keys [id]} (api/add-task c "  buy milk ")]
        (is (= "buy milk" (:title (first (api/list-tasks c)))))
        (is (= "oat milk" (:title (api/update-task c id {"title" "oat milk"}))))
        (is (= "2l" (:notes (api/update-task c id {"notes" "2l"}))))
        (is (true? (:done (api/toggle-task c id))))
        (is (= 1 (api/clear-done c)))
        (is (= [] (api/list-tasks c)))))))

(deftest handlers-reject-bad-input
  (with-conn
    (fn [c]
      (is (str/includes? (message-of #(api/add-task c "   ")) "title"))
      (is (str/includes? (message-of #(api/toggle-task c 999)) "No task 999"))
      (is (false? (api/delete-task c 999))))))

(deftest every-handler-is-a-var
  (is (every? var? (vals api/handlers))))
