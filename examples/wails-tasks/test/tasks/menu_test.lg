(ns tasks.menu-test
  (:require [tasks.menu :as menu]
            [wails.core :as w]
            [clojure.test :refer [deftest is]]))

;; check-menu builds the spec with Wails, which needs the application to
;; exist; nothing is run or shown.
(defonce ^:private app (delay (w/new-app {:name "tasks-test"})))

(defn- on-clicks [items]
  (mapcat (fn [item]
            (concat (when (contains? item :on-click) [(:on-click item)])
                    (on-clicks (:items item))))
          items))

(def ^:private env {:app :the-app :db :the-db})

(deftest the-spec-is-data
  (is (vector? (menu/spec env))))

;; A click runs the current export!/import! with the menu's env, so a
;; redefinition reaches it with no rebuild.
(deftest every-on-click-is-hot
  (let [clicks (on-clicks (menu/spec env))]
    (is (= 2 (count clicks)))
    (with-redefs [menu/export! (fn [e] [:export e])
                  menu/import! (fn [e] [:import e])]
      (is (= #{[:export env] [:import env]}
             (set (map #(%) clicks)))))))

(deftest wails-accepts-the-spec
  @app
  (is (true? (w/check-menu (menu/spec env)))))
