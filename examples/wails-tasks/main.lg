;; A task manager: the UI is HTML in a Wails v3 window, everything behind
;; it is let-go - handlers, sqlite storage, the menu, import and export.
;; integrant wires the parts together (src/tasks/system.lg).
(ns main
  (:require [tasks.system :as system]
            [wails.core :as w]))

(defn -main []
  (let [system (system/start!)]
    ;; Blocks on the event loop; must run on the main thread, which is why
    ;; it is here and not in a component.
    (try
      (w/run! (:tasks.app/app system))
      ;; The system halts at exit from two places, and stop! makes the
      ;; second a no-op. Here, once w/run! returns; that is the only one
      ;; in server mode, which stops serving and returns before Wails' own
      ;; shutdown hooks finish. And in the app's :on-shutdown, for a
      ;; platform that exits the process without returning from w/run!.
      (finally (system/stop!)))))

;; lg -b runs top-level forms at compile time, so without this guard
;; `lgx build` would open the database and start the event loop while
;; bundling.
(when-not *compiling-aot* (-main))
