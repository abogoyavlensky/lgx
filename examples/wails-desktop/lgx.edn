{:paths []
 ;; resources/public is the frontend; lgx build embeds it in the binary.
 :resource-paths ["resources"]
 :main "main.lg"
 :lg-version "1.13.0"
 :lg-runtime :built
 :targets {:bin {:out "bin/app"}}

 :deps {abogoyavlensky/letgo-wails
        {:git/url "https://github.com/abogoyavlensky/letgo-packages"
         :git/tag "wails-v0.2.0"
         :deps/root "wails"}}}
