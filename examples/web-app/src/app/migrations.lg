(ns app.migrations
  (:require [honey.sql :as sql]
            [ragtime.letgo :as rt]))

;; Schema migrations with the letgo-packages ragtime package: it supplies the
;; DataStore (a ragtime_migrations table over the sql layer) and the
;; Migration record; this namespace holds only the app's history. The
;; migrations are HoneySQL data, formatted here, so the whole schema is
;; readable as one vector.

(defn- migration [id up down]
  (rt/sql-migration {:id id
                     :up (mapv sql/format up)
                     :down (mapv sql/format down)}))

(def migrations
  [(migration "001-create-todos"
              [{:create-table :todos
                :with-columns [[:id :integer [:primary-key]]
                               [:title :text [:not nil]]
                               [:done :integer [:not nil] [:default 0]]]}]
              [{:drop-table :todos}])
   (migration "002-index-todos-done"
              [{:create-index [:todos_done_idx [:todos :done]]}]
              [{:drop-index :todos_done_idx}])])

(defn store
  "The ragtime DataStore over `conn`."
  [conn]
  (rt/sql-database conn))

(defn- config [conn]
  {:datastore (store conn)
   :migrations migrations})

(defn migrate!
  "Apply every migration not yet applied, in order. ragtime's default
   raise-error strategy: an applied id that is not in the history is an error."
  [conn]
  (rt/migrate (config conn)))

(defn rollback!
  "Roll back the last migration, or the last `n`."
  ([conn] (rollback! conn 1))
  ([conn n]
   (rt/rollback (config conn) n)))
