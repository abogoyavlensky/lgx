(ns app.routes
  (:require [app.db :as db]
            [integrant.core :as ig]
            [json :as json]
            [ruuter.core :as r]
            [string :as str]))

;; The HTTP handler: a Ring-style function over a db connection, and the
;; integrant component between the db and the server. Tests call `handler`
;; directly over a throwaway database, no server.

(defn- json-response [status data]
  {:status status
   :headers {"Content-Type" "application/json"}
   :body (json/write-json data)})

(defn- todo->json [row]
  ;; sqlite stores booleans as 0/1; present them as booleans.
  (update row :done pos?))

(def ^:private content-types
  {"html" "text/html; charset=utf-8"
   "js"   "text/javascript; charset=utf-8"
   "css"  "text/css; charset=utf-8"
   "svg"  "image/svg+xml"})

(defn- static-response
  "Serve `name` from resources/public. Only the text types above are served:
  io/slurp reads a string, so binaries would not survive. io/resource returns
  nil for a missing name and for one that escapes the resource root, so
  `..` cannot reach outside it."
  [name]
  (let [ct (content-types (last (str/split (str name) #"\.")))
        res (when ct (io/resource (str "public/" name)))]
    (if res
      {:status 200
       :headers {"Content-Type" ct}
       :body (io/slurp res)}
      (json-response 404 {:error "not found"}))))

(defn- parse-id [req]
  (let [id (-> req :params :id)]
    (when (re-find #"^[0-9]+$" (str id))
      (Integer/parseInt id))))

(defn- routes [conn]
  [;; The UI: one page over the JSON API below, plus its script.
   {:path "/"
    :method :get
    :response (fn [_] (static-response "index.html"))}

   {:path "/static/:file"
    :method :get
    :response (fn [req] (static-response (-> req :params :file)))}

   {:path "/todos"
    :method :get
    :response (fn [_]
                (json-response 200 (mapv todo->json (db/list-todos conn))))}

   {:path "/todos"
    :method :post
    :response (fn [req]
                (let [title (:title (json/read-json (:body req)
                                                    {:keywords? true}))]
                  (if (str/blank? (str title))
                    (json-response 400 {:error "title is required"})
                    (json-response 201 (todo->json (db/add-todo! conn title))))))}

   {:path "/todos/:id"
    :method :get
    :response (fn [req]
                (if-let [row (some->> (parse-id req) (db/get-todo conn))]
                  (json-response 200 (todo->json row))
                  (json-response 404 {:error "not found"})))}

   {:path "/todos/:id/complete"
    :method :post
    :response (fn [req]
                (if-let [row (some->> (parse-id req) (db/complete-todo! conn))]
                  (json-response 200 (todo->json row))
                  (json-response 404 {:error "not found"})))}

   {:path "/todos/:id"
    :method :delete
    :response (fn [req]
                (if (some->> (parse-id req) (db/delete-todo! conn))
                  {:status 204 :headers {} :body ""}
                  (json-response 404 {:error "not found"})))}

   {:path :not-found
    :response (fn [_] (json-response 404 {:error "not found"}))}])

(defn handler
  "A Ring-style handler over `conn`: request map in, response map out."
  [conn]
  (let [table (routes conn)]
    (fn [req]
      (r/route table req))))

(defmethod ig/init-key ::handler [_ {:keys [db]}]
  (handler db))
