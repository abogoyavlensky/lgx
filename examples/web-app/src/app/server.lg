(ns app.server
  (:require [http :as http]
            [integrant.core :as ig]))

;; The server component. http/start binds the address, serves in the
;; background and returns a record with the resolved :addr and :port (so
;; ":0" picks a free port) and the handle http/stop takes. A bind error
;; throws here, so a taken port fails ig/init instead of a goroutine.
;; halt-key! stops it gracefully: in-flight requests finish, then the
;; port is released.

(defmethod ig/init-key ::http [_ {:keys [addr handler]}]
  (let [srv (http/start handler addr)]
    (println (str "Listening on http://localhost:" (:port srv)))
    srv))

(defmethod ig/halt-key! ::http [_ srv]
  (http/stop srv))
