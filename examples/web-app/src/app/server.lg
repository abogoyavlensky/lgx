(ns app.server
  (:require [app.routes :as routes]
            [http :as http]
            [integrant.core :as ig]))

;; The server component: an http server over the handler built from the
;; db it depends on. let-go's http/serve blocks, so it runs in a future (a
;; goroutine) and the component holds that future; main derefs it to keep
;; the process alive. There is no shutdown API in http/serve yet, so
;; halt-key! has nothing to stop - the process exit ends it.

(defmethod ig/init-key ::http [_ {:keys [port db]}]
  (let [addr (str ":" port)]
    (println (str "Listening on http://localhost" addr))
    {:addr addr
     :serving (future (http/serve (routes/handler db) addr))}))

(defmethod ig/halt-key! ::http [_ _]
  nil)
