(ns main
  (:require [app.system :as system]
            [http :as http]))

;; A small todo app: a JSON API over sqlite with an Alpine.js page on top.
;; HoneySQL builds the queries, integrant wires the db connection, the
;; handler and the http server. Run with `lgx run` (PORT and DB_PATH
;; override the defaults), then open http://localhost:8080 or:
;;
;;   curl -d '{"title":"write docs"}' localhost:8080/todos
;;   curl localhost:8080/todos
;;   curl -X POST localhost:8080/todos/1/complete
;;   curl localhost:8080/todos/1
;;   curl -X DELETE localhost:8080/todos/1

(defn -main []
  (let [system (system/start!)]
    ;; http/start serves in the background; wait blocks until the server
    ;; stops, which keeps the process up.
    (http/wait (:app.server/http system))))

;; lg -b runs top-level forms at compile time, so without this guard
;; `lgx build` would open the database and start listening while bundling.
(when-not *compiling-aot* (-main))
