{:main "main.lg"
 :targets {:bin {:out "bin/with-lib"}}
 ;; malli pulls in borkdude/dynaload (via malli.sci). lgx does not yet resolve
 ;; transitive deps of a plain Clojure lib, so both are listed directly.
 :deps {metosin/malli     {:git/url "https://github.com/metosin/malli"
                           :git/tag "0.20.1"}
        borkdude/dynaload {:git/url "https://github.com/borkdude/dynaload"
                           :git/tag "v0.3.5"}}}
