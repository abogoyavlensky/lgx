(ns lgx.main
  (:require [lgx.cache :as cache]
            [lgx.cli :as cli]
            [lgx.config :as config]
            [lgx.new :as new]
            [lgx.path :as path]
            [lgx.runner :as runner]
            [lgx.tasks :as tasks]
            [lgx.test-runner :as test-runner]
            [string :as str]))

(def version "0.1.0-alpha12")

(def base-usage
  (str "lgx - project manager for let-go\n"
       "\n"
       "Usage:\n"
       "  lgx install                  Fetch dependencies declared in lgx.edn\n"
       "  lgx run [args...]            Run a script via `lg` with deps on the source path\n"
       "                               (uses :main from lgx.edn when script is omitted)\n"
       "  lgx build [args...]          Bundle :main into :targets/:bin/:out via `lg -b`\n"
       "                               (extra args forwarded to `lg` before -b)\n"
       "  lgx test [file]              Run *_test.lg / *_test.cljc / *_test.clj files under test/\n"
       "                               (one file if given, else walk test/)\n"
       "  lgx new <project-name>       Scaffold a new let-go app from the default template\n"
       "  lgx version                  Print version\n"
       "  lgx help                     Show this help\n"
       "\n"
       "Global flags:\n"
       "  --verbose                    Print the env vars lgx sets and the lg invocation before running (run/build/test/user tasks)\n"))

(defn- coord-label [c]
  (cond
    (:local/root c) (str "local:" (:local/root c))
    (:git/sha c) (str (:git/url c) "@" (:git/sha c))
    (:git/tag c) (str (:git/url c) "#" (:git/tag c))
    :else (str c)))

(defn- coord-id [base c]
  (if-let [local (:local/root c)]
    (assoc c :local/root (if (path/absolute? local)
                           (path/normalize local)
                           (path/normalize (path/join base local))))
    c))

(defn- ensure-all!
  "Resolve the project's coords and, transitively, the coords each fetched dep
   declares in its own lgx.edn. Breadth-first from the project root, so a coord
   listed closer to the root wins on conflicts (first-wins): the first coord
   seen for a lib name is kept, and a later, differing coord for the same lib is
   skipped with a warning. The `seen` set also terminates cycles. Returns the
   install results in resolution order.

   Each queue entry carries its resolution base — the directory a relative
   :local/root is resolved against. Top-level coords use the project root;
   a dep's transitive coords use that dep's own directory, so a relative
   local path in a dep means \"relative to the dep\", not to the consumer."
  [project coords]
  (loop [queue (mapv (fn [[lib c]] [lib c project]) coords)
         seen {}
         out []]
    (if (empty? queue)
      out
      (let [[lib c base] (first queue)
            id (coord-id base c)
            rest-q (vec (rest queue))]
        (if (contains? seen lib)
          (do
            (when (not= (get seen lib) id)
              (write! *err*
                      (str "warning: " lib " already resolved as "
                           (coord-label (get seen lib)) "; ignoring "
                           (coord-label id) "\n")))
            (recur rest-q seen out))
          (let [{:keys [path dir installed?]} (cache/ensure-lib! c base)
                children (mapv (fn [[clib cc]] [clib cc dir])
                               (config/coords-at dir))]
            (recur (vec (concat rest-q children))
                   (assoc seen lib id)
                   (conj out {:lib lib
                              :path path
                              :installed? installed?}))))))))

(defn- print-installs! [results]
  (let [new-installs (filter :installed? results)]
    (when (seq new-installs)
      (println "installing" (count new-installs) "dep(s)...")
      (doseq [{:keys [lib path]} new-installs]
        (println " " lib "->" path))
      (println "done"))))

(defn- cmd-install []
  (let [project (config/find-project!)
        coords (config/coords project)]
    (if (empty? coords)
      (println "no deps in lgx.edn")
      (let [results (ensure-all! project coords)]
        (if (some :installed? results)
          (print-installs! results)
          (println "all deps up to date"))))))

(defn- cmd-version []
  (println (str "lgx " version)))

(defn- resolve-project-paths [project paths]
  (mapv (fn [p]
          (let [abs (path/join project p)]
            (when-not (file-exists? abs)
              (write! *err* (str "warning: :paths entry not found: " p "\n")))
            abs))
        paths))

(defn- basis
  "Resolve `coords` and `raw-paths` into a source-path basis for the active
   project. Returns a map with the project root, the install results, and the
   joined source path vector used for `-source-paths`. `coords` is the coord
   pair list to resolve (project deps, or project+task extras merged);
   `raw-paths` is the project-relative path list (project :paths, or project
   :paths ++ a task's :extra-paths)."
  [project coords raw-paths]
  (let [results (ensure-all! project coords)
        own-paths (resolve-project-paths project raw-paths)
        paths (vec (concat own-paths (mapv :path results)))]
    {:project project
     :results results
     :paths paths}))

(defn- project-basis
  "The no-extras basis used by run/build/test: the project's own :deps and
   :paths."
  [project]
  (basis project (config/coords project) (config/paths project)))

(defn- resolve-main-script! [project main-script]
  (let [abs (path/join project main-script)]
    (when-not (file-exists? abs)
      (write! *err* (str "lgx: :main script not found: " main-script "\n"))
      (os/exit 1))
    main-script))

(defn- position
  "Index of the first occurrence of x in v, or -1 if absent."
  [v x]
  (loop [i 0
         xs (seq v)]
    (cond
      (nil? xs) -1
      (= x (first xs)) i
      :else (recur (inc i) (next xs)))))

(defn- require-main-for-double-dash! [main-script]
  (when (nil? main-script)
    (write! *err* "lgx: -- requires :main to be set in lgx.edn\n")
    (os/exit 1)))

(def ^:private script-exts [".lg" ".cljc" ".clj"])

(defn- script-arg? [s]
  (and (string? s)
       (some #(str/ends-with? s %) script-exts)))

(defn- has-script? [args]
  (some script-arg? args))

(defn- cmd-run [forward-args verbose?]
  (let [project (config/find-project!)
        {:keys [results paths]} (project-basis project)
        main-script (config/main project)
        dd (position forward-args "--")
        args (cond
               (and (empty? forward-args) main-script)
               ;; Always emit a trailing `--` so a script can use the
               ;; universal `(drop-while #(not= "--" %) os/args)` idiom
               ;; for arg parsing across dev (`lgx run`) and binary modes.
               [(resolve-main-script! project main-script) "--"]

               (neg? dd)
               forward-args

               :else
               (let [pre (vec (take dd forward-args))
                     post (vec (drop (inc dd) forward-args))]
                 (if (has-script? pre)
                   forward-args
                   (do (require-main-for-double-dash! main-script)
                       (let [script (resolve-main-script! project main-script)]
                         (vec (concat pre [script "--"] post)))))))]
    (print-installs! results)
    ;; Advertise to the spawned program that it is running under `lgx run`
    ;; (vs. as a bundled binary). Tools use this to strip runner args without
    ;; relying on the injected `--` marker, which can collide with a user
    ;; command that legitimately contains `--`. Inherited by the child via env.
    (os/setenv "LGX_RUN" "1")
    (runner/exec-lg! paths args verbose?)))

(defn- ensure-out-dir! [project rel-out]
  (let [abs (path/join project rel-out)
        parent (path/parent abs)]
    (when parent (mkdir parent))
    abs))

(defn- cmd-build [forward-args verbose?]
  (let [project (config/find-project!)
        {:keys [results paths]} (project-basis project)
        main-script (config/main project)
        bin (:bin (config/targets project))]
    (when (nil? main-script)
      (write! *err* "lgx: :main is required for build (set :main in lgx.edn)\n")
      (os/exit 1))
    (when (nil? bin)
      (write! *err* (str "lgx: :targets/:bin is required for build "
                         "(set :targets {:bin {:out \"...\"}} in lgx.edn)\n"))
      (os/exit 1))
    (resolve-main-script! project main-script)
    (let [abs-out (ensure-out-dir! project (:out bin))
          abs-main (path/join project main-script)
          args (vec (concat forward-args ["-b" abs-out abs-main]))]
      (print-installs! results)
      (let [exit (runner/invoke-lg! paths args verbose?)]
        (when (zero? exit)
          (println "built" abs-out))
        (os/exit exit)))))

(defn- validate-error-line [reason user-path]
  (case reason
    :not-found (str "lgx: test file not found: " user-path "\n")
    :bad-extension (str "lgx: not a test file (expected .lg, .cljc, or .clj): "
                        user-path "\n")
    :outside-test-dir (str "lgx: test file must be under test/: "
                           user-path "\n")
    (str "lgx: invalid test file: " user-path "\n")))

(defn- single-file-entries! [test-dir user-path project]
  (let [abs (try
              (test-runner/validate-single-test-file!
                test-dir user-path project)
              (catch e
                     (let [data (ex-data e)]
                       (write! *err* (validate-error-line (:reason data)
                                                          (:path data)))
                       (os/exit 1))))]
    [(test-runner/test-entry test-dir abs)]))

(defn- cmd-test [forward-args verbose?]
  (when (> (count forward-args) 1)
    (write! *err* "lgx: test takes at most one argument\n")
    (os/exit 1))
  (let [project (config/find-project!)
        {:keys [results paths]} (project-basis project)
        test-dir (path/join project "test")
        stat (os/stat test-dir)]
    (when (or (nil? stat) (not (:dir? stat)))
      (write! *err* "lgx: no test/ directory in project\n")
      (os/exit 1))
    (let [single? (= 1 (count forward-args))
          entries (if single?
                    (single-file-entries! test-dir (first forward-args) project)
                    (let [files (test-runner/discover-test-files test-dir)]
                      (when (empty? files)
                        (println "No tests found in test/")
                        (os/exit 0))
                      (mapv #(test-runner/test-entry test-dir %) files)))
          header (if single? (first (first entries)) "test/")
          harness (test-runner/write-harness! entries version header)
          source-paths (vec (concat paths [test-dir]))]
      (when verbose?
        (write! *err* (str "+ test runner: " harness "\n")))
      (print-installs! results)
      ;; let-go's require swallows a test file's compile error: lg prints
      ;; "error: failed to load ..." to stderr but exits 0, so the harness
      ;; reports 0 failures. Replay lg's output (minus the harness marker)
      ;; and, if a pre-harness load error slipped through a zero exit, fail.
      (let [r (runner/run-lg! source-paths [harness] verbose?)
            exit (:exit r)]
        (when (seq (:out r)) (write! *out* (:out r)))
        (let [shown-err (test-runner/strip-ready-marker (:err r))]
          (when (seq shown-err) (write! *err* shown-err)))
        (if (and (zero? exit)
                 (test-runner/load-error-before-harness? (:err r)))
          (do (write! *err* "lgx: a test file failed to load (see errors above)\n")
              (os/exit 1))
          (os/exit exit))))))

(defn- cmd-task [task verbose?]
  (let [project (config/find-project!)
        ;; A task may augment the project basis with its own :extra-deps and
        ;; :extra-paths. extra-deps override same-named project deps (silently;
        ;; see config/merge-coords); extra-paths sit after the project paths.
        ;; Both affect only the task's :run steps (the source path); :sh steps
        ;; ignore the basis.
        coords (config/merge-coords (config/coords project)
                                    (vec (or (:extra-deps task) {})))
        raw-paths (vec (concat (config/paths project)
                               (or (:extra-paths task) [])))
        {:keys [results paths]} (basis project coords raw-paths)]
    (print-installs! results)
    (tasks/run-task! task paths verbose?)))

(defn- pad-right [s n]
  (let [c (count s)]
    (if (>= c n) s (str s (apply str (repeat (- n c) " "))))))

(defn- task-line [width task-name task]
  (let [n (name task-name)
        doc (:doc task)]
    (if (str/blank? doc)
      (str "  " n)
      (str "  " (pad-right n width) "  " doc))))

(defn- tasks-block [project]
  (let [t (try (config/tasks project) (catch _ {}))
        sorted-names (sort (map name (keys t)))
        width (if (seq sorted-names)
                (apply max (map count sorted-names))
                0)]
    (when (seq t)
      (str "\n"
           "Project tasks:\n"
           (str/join "\n" (map (fn [n]
                                 (task-line width
                                            (keyword n)
                                            (get t (keyword n))))
                               sorted-names))
           "\n"))))

(defn- usage-for [project]
  (str base-usage (or (tasks-block project) "")))

(defn- print-usage! []
  (let [project (config/find-project)]
    (print (if project (usage-for project) base-usage))))

(defn- lookup-task [cmd]
  (when-let [project (config/find-project)]
    (let [t (config/tasks project)
          k (keyword cmd)]
      (when (contains? t k)
        (get t k)))))

;; `with` is the CLI --with context-name list (empty when the flag is absent).
;; It is threaded to every command, but only the basis commands
;; (run/build/test/install/tasks) act on it; new/version/help ignore it.
(defn- dispatch [cmd rest-args verbose? with]
  (case cmd
    "install" (cmd-install)
    "run" (cmd-run (vec rest-args) verbose?)
    "build" (cmd-build (vec rest-args) verbose?)
    "test" (cmd-test (vec rest-args) verbose?)
    "new" (new/cmd-new! (vec rest-args) verbose?)
    "version" (cmd-version)
    "-v" (cmd-version)
    "--version" (cmd-version)
    "help" (print-usage!)
    "-h" (print-usage!)
    "--help" (print-usage!)
    nil (do (print-usage!) (os/exit 1))
    (if-let [task (lookup-task cmd)]
      (cmd-task task verbose?)
      (do (write! *err*
                  (str "lgx: '" cmd "' is not a lgx command. See 'lgx --help'.\n"))
          (os/exit 1)))))

(defn- main []
  (let [{:keys [verbose? with args]}
        (try
          (cli/parse-leading-flags (cli/user-args os/args))
          (catch e
                 (write! *err* (str (ex-message e) "\n"))
                 (os/exit 1)))
        cmd (first args)
        rest-args (rest args)]
    (dispatch cmd rest-args verbose? with)))

;; Top-level forms run during AOT compilation too. Guard so `lg -b` doesn't
;; execute the CLI while bundling.
(when-not *compiling-aot* (main))
