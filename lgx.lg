(ns lgx.main
  (:require [lgx.args :as args]
            [lgx.cache :as cache]
            [lgx.clean :as clean]
            [lgx.cli :as cli]
            [lgx.completion :as completion]
            [lgx.config :as config]
            [lgx.gobuild :as gobuild]
            [lgx.new :as new]
            [lgx.path :as path]
            [lgx.registry :as registry]
            [lgx.runner :as runner]
            [lgx.style :as style]
            [lgx.tasks :as tasks]
            [lgx.test-runner :as test-runner]
            [lgx.version :as version]
            [string :as str]))

(def version "0.3.2")

;; Description column the static rows below are hand-aligned to; task rows align
;; to it too (see task-line). If you re-pad the rows, update this constant.
(def ^:private doc-col 31)

;; Color-free, hand-aligned command and option rows. Only the section titles are
;; colored, and they are built at call time (in usage-for) so LGX_NO_COLOR is
;; honored at runtime rather than baked into the bundle during `lg -b`.
(def ^:private command-rows
  (str "  lgx install                  Fetch dependencies declared in lgx.edn\n"
       "  lgx info                     Show which lg runs this project and why (:lg-runtime, :lg-version, Go deps) and its contexts\n"
       "  lgx run [args...]            Run a script via `lg` with deps on the source path\n"
       "                               (uses :main from lgx.edn when script is omitted; auto-applies :dev context)\n"
       "  lgx repl                     Start lg's built-in REPL with project deps on the source path\n"
       "                               (auto-applies :dev and :test contexts)\n"
       "  lgx nrepl [--port N]         Start a REPL with an nREPL server\n"
       "                               (free port unless --port given; auto-applies :dev and :test contexts)\n"
       "  lgx build [args...]          Bundle :main into :targets/:bin/:out via `lg -b`\n"
       "                               (--target <os>/<arch>[,...] or --all cross-compile; other args forwarded to `lg`)\n"
       "  lgx test [file] [--exclude <ns,...>]  Run *_test.lg / *_test.cljc / *_test.clj files under the :test context's paths (test/ by default)\n"
       "                               (one file if given, else walk them skipping --exclude namespaces; auto-applies :test context)\n"
       "  lgx new <name> [-t <tpl>]    Scaffold a let-go app (template: built-in names `base`, `cli`, `lib` or git URL)\n"
       "  lgx clean <--cache...>       Remove caches under ~/.lgx: --runtimes, --gitlibs, --templates, or --all\n"
       "                               (--dry-run only reports; reports bytes reclaimed)\n"
       "  lgx lgx:<command>            Run a built-in command directly, even when a project task overrides it\n"
       "  lgx version                  Print version\n"
       "  lgx help                     Show this help\n"))

(def ^:private option-rows
  (str "  --with <a,b,...>             Apply named :contexts (extra deps/paths) to the command (run/build/test/install/tasks)\n"
       "  --verbose                    Print the resolved lg version and path, the env vars lgx sets, and the lg invocation before running (run/build/test/user tasks)\n"))

(defn- coord-label [c]
  (cond
    (:local/root c) (str "local:" (:local/root c))
    (:git/sha c) (str (:git/url c) "@" (:git/sha c))
    (:git/tag c) (str (:git/url c) "#" (:git/tag c))
    :else (str c)))

(defn- coord-id [base c]
  (if-let [local (:local/root c)]
    (assoc c :local/root (if (path/absolute? local)
                           (path/normalize local)
                           (path/normalize (path/join base local))))
    c))

(defn- coords-at!
  "config/coords-at, but an invalid dep config prints its rendered report and
   exits 1 instead of escaping as a stack trace."
  [dir]
  (try
    (config/coords-at dir)
    (catch e
           (if (:lgx/invalid-dep-config (ex-data e))
             (do (write! *err* (ex-message e))
                 (os/exit 1))
             (throw e)))))

;; ---------------------------------------------------------------------------
;; Transitive deps declared by a dependency that ships no lgx.edn
;;
;; Coords come from the first available source: the dep's own lgx.edn, else its
;; deps.edn, else its project.clj. The choice is made on file existence, not on
;; whether the file yielded anything — a present deps.edn is authoritative even
;; when empty, or a stale project.clj beside it would resurrect old deps.
;;
;; Everything below acts on metadata a third party wrote for a different tool,
;; so nothing here may abort the command. A registry tag that moved, an
;; inferred URL that 404s, a clone that fails: each becomes a warning and the
;; walk continues. The status quo without this feature is "not resolved at
;; all", so failing soft is strictly better. Coords from the user's own lgx.edn
;; keep their hard errors.
;; ---------------------------------------------------------------------------

(defn- declared-source
  "The best available source of `dir`'s declared deps as
   [:deps-edn|:project-clj declared-pairs], or [nil []] when it has neither."
  [dir]
  (cond
    (file-exists? (path/join dir config/deps-edn-name))
    [:deps-edn (config/declared-deps-at dir)]

    (file-exists? (path/join dir config/project-clj-name))
    [:project-clj (config/project-clj-deps-at dir)]

    :else [nil []]))

(defn- probe-coord
  "Try to pin an mvn-style coord whose lib name certifies its repo
   (io.github.X/Y, com.github.X/Y) by asking the remote which of the two
   conventional tag spellings exists. Returns a coord or nil."
  [lib version]
  (when-let [url (config/inferred-git-url lib)]
    (let [v-tag (str "v" version)]
      (cond
        (cache/tag-exists? url version) {:git/url url
                                         :git/tag version}
        (cache/tag-exists? url v-tag) {:git/url url
                                       :git/tag v-tag}
        :else nil))))

(defn- pending-warning [declaring installed? declared reason]
  {:declaring declaring
   :declared declared
   :installed? installed?
   :reason reason})

(defn- classify-child
  "Decide what one dep declared by `declaring` becomes: a queue entry under
   :child, a deferred warning under :pending, or nil to ignore it outright.
   `dir` is the declaring dep's own directory — the base a relative
   :local/root resolves against."
  [declaring installed? source dir declared]
  (let [[dlib dcoord] declared
        {:keys [action coord version]} (config/classify-declared dlib dcoord)
        ;; :exclusions ride along when a coord is synthesized from a Maven
        ;; declaration: they are tools.deps vocabulary that a deps.edn may
        ;; carry, and they scope to what *this* dep pulls in, so dropping them
        ;; would silently resolve something the declaration ruled out. (The
        ;; :resolve path keeps them already — the coord passes through whole.)
        carry-exclusions (fn [c]
                           (if (and (map? dcoord) (contains? dcoord :exclusions))
                             (assoc c :exclusions (:exclusions dcoord))
                             c))
        child (fn [c via-source]
                {:child {:lib dlib
                         :coord (carry-exclusions c)
                         :base dir
                         :via declaring
                         :via-source via-source
                         :via-installed? installed?
                         ;; Kept verbatim so a later fetch failure warns about
                         ;; what the dep actually wrote, not about the coord we
                         ;; synthesized from it.
                         :declared declared}})]
    (cond
      (= :skip action) nil
      (= :resolve action) (child coord source)

      (= :mvn action)
      (if-let [from-registry (registry/coord-for dlib version)]
        (child from-registry :registry)
        (if-let [probed (probe-coord dlib version)]
          (child probed :probe)
          {:pending (pending-warning declaring installed? declared nil)}))

      :else {:pending (pending-warning declaring installed? declared nil)})))

(defn- declared-children
  "Split the deps `lib` declares in its deps.edn/project.clj into queue entries
   and deferred warnings: {:children [...] :pending [...]}. Deps named by the
   consuming coord's :exclusions are dropped before classification, so they
   neither resolve nor warn."
  [lib coord dir installed?]
  (let [[source declared] (declared-source dir)
        kept (config/without-exclusions (:exclusions coord) declared)
        outcomes (keep (fn [d] (classify-child lib installed? source dir d))
                       kept)]
    {:children (vec (keep :child outcomes))
     :pending (vec (keep :pending outcomes))}))

(defn- warning-line [{:keys [declaring declared reason]}]
  (let [[dlib dcoord] declared]
    (str "warning: " declaring " declares " dlib " " (pr-str dcoord)
         " - not resolved by lgx" (when reason (str ": " reason))
         "; add a :git coord to lgx.edn :deps or exclude it"
         " (see examples/clojure-libs/)\n")))

(defn- emit-warnings!
  "Print one line per declared dep the walk could not resolve.

   Emitted only after the whole walk, so a dep resolved later in BFS order
   never falsely warns, and filtered twice. First by resolution: a declared dep
   that matches something already resolved is silent. Then by moment, unless
   `warn-all?`: only deps whose declaring lib was freshly installed in this
   walk are reported, so a warm cache stays quiet in the day-to-day run/build/
   test loop. `lgx install` passes warn-all?, being both the deliberate
   dependency-management moment and the way to re-read these warnings."
  [seen pending warn-all?]
  (let [unresolved (config/unresolved-declared seen pending)
        shown (if warn-all? unresolved (filter :installed? unresolved))]
    (doseq [entry shown]
      (write! *err* (warning-line entry)))))

(defn- ensure-all!
  "Resolve the project's coords and, transitively, the coords each fetched dep
   declares — in its own lgx.edn, else in the deps.edn or project.clj it ships
   for other tools. Breadth-first from the project root, so a coord listed
   closer to the root wins on conflicts (first-wins): the first coord seen for
   a lib name is kept, and a later, differing coord for the same lib is skipped
   with a warning. That also means a top-level coord always overrides whatever
   a dep declares. The `seen` map terminates cycles. Returns the install
   results in resolution order.

   Each queue entry carries its resolution base — the directory a relative
   :local/root is resolved against. Top-level coords use the project root;
   a dep's transitive coords use that dep's own directory, so a relative
   local path in a dep means \"relative to the dep\", not to the consumer.
   Entries discovered through third-party metadata also carry :via provenance,
   which reaches the install output and marks them as fail-soft.

   :go/* coords are partitioned out of this same walk (gobuild/split-go-coords):
   they name Go packages, so they produce no source path and no clone, but they
   are collected — including the ones a dep declares in its own lgx.edn — and
   returned for the custom-runtime build.

   `warn-all?` shows every unresolved declared dep instead of only those
   surfacing from a fresh install (see emit-warnings!).

   Returns {:installs [...] :go-coords [[lib coord] ...] :go-origins {...}},
   where :go-origins maps each Go coord lib to the dep lib whose lgx.edn
   declared it — nil for a coord in the project's own lgx.edn — so an error
   (or `lgx info`) can say which dep pulled a Go package in."
  [project coords warn-all?]
  (let [split0 (gobuild/split-go-coords
                 (mapv (fn [[lib c]] {:lib lib
                                      :coord c
                                      :base project}) coords)
                 {})]
    (doseq [w (:warnings split0)] (write! *err* w))
    (loop [queue (:src split0)
           seen {}
           out []
           pending []
           go-seen (:seen-go split0)
           go-pairs (:go-pairs split0)
           go-origins (into {} (map (fn [[glib _]] [glib nil])
                                    (:go-pairs split0)))]
      (if (empty? queue)
        (do (emit-warnings! seen pending warn-all?)
            {:installs out
             :go-coords go-pairs
             :go-origins go-origins})
        (let [{:keys [lib coord base via via-source via-installed? declared]}
              (first queue)
              rest-q (vec (rest queue))
            ;; Everything that can throw on a coord reached through a dep's
            ;; metadata sits inside this boundary, normalization included:
            ;; coord-id resolves a relative :local/root, and third-party
            ;; metadata can hold a value that is truthy but not a path.
              soft? (some? via)
            ;; A warning names what the dep wrote, not the coord synthesized
            ;; from it, so a registry tag miss still shows the :mvn/version.
              warn-about (or declared [lib coord])
              attempt (fn [f]
                        (if soft?
                          (try {:ok (f)} (catch e {:error (ex-message e)}))
                          {:ok (f)}))
              normalized (attempt (fn [] (coord-id base coord)))]
          (if (:error normalized)
            (recur rest-q seen out
                   (conj pending (pending-warning via via-installed? warn-about
                                                  (:error normalized)))
                   go-seen go-pairs go-origins)
            (let [id (:ok normalized)]
              (if (contains? seen lib)
                (do
                  (when (not= (get seen lib) id)
                    (write! *err*
                            (str "warning: " lib " already resolved as "
                                 (coord-label (get seen lib)) "; ignoring "
                                 (coord-label id) "\n")))
                  (recur rest-q seen out pending go-seen go-pairs go-origins))
              ;; A fetch failure aborts only when the coord is the user's own;
              ;; one reached through a dep's metadata degrades to a warning.
                (let [fetched (attempt (fn [] (cache/ensure-lib! coord base)))]
                  (if (:error fetched)
                    (recur rest-q seen out
                           (conj pending
                                 (pending-warning via via-installed? warn-about
                                                  (:error fetched)))
                           go-seen go-pairs go-origins)
                    (let [{:keys [paths dir installed?]} (:ok fetched)
                        ;; :deps/root relocates where the dep's lgx.edn is
                        ;; read (config/dep-config-dir) — and the children it
                        ;; yields resolve their relative :local/root and
                        ;; :go/local against that same directory, so a
                        ;; monorepo package's siblings resolve against the
                        ;; package, not the repo root.
                          cfg-dir (config/dep-config-dir dir id)
                          lgx-edn? (file-exists? (path/join cfg-dir
                                                            config/config-name))
                        ;; Rung 1: a dep's own lgx.edn is authoritative and its
                        ;; deps.edn/project.clj go unread. The other rungs
                        ;; (declared-children) stay on the checkout root —
                        ;; deps.edn/project.clj belong to tools with their own
                        ;; conventions.
                          found (if lgx-edn?
                                  {:children (mapv (fn [[clib cc]]
                                                     {:lib clib
                                                      :coord cc
                                                      :base cfg-dir})
                                                   (coords-at! cfg-dir))
                                   :pending []}
                                  (declared-children lib coord dir installed?))
                        ;; A dep's own go coords flow up through the same read.
                        ;; Splitting each batch as it is discovered (rather
                        ;; than the whole queue up front) is what keeps
                        ;; first-wins breadth-first: the root's batch is split
                        ;; before any dep's.
                          split (gobuild/split-go-coords (:children found)
                                                         go-seen)
                          row {:lib lib
                               :paths paths
                               :installed? installed?}]
                      (doseq [w (:warnings split)] (write! *err* w))
                      (recur (vec (concat rest-q (:src split)))
                             (assoc seen lib id)
                             (conj out (if via
                                         (assoc row
                                                :via via
                                                :via-source via-source)
                                         row))
                             (vec (concat pending
                                          (:pending found)))
                             (:seen-go split)
                             (vec (concat go-pairs
                                          (:go-pairs split)))
                             (into go-origins
                                   (map (fn [[glib _]] [glib lib])
                                        (:go-pairs split)))))))))))))))

(defn- via-label
  "How a provenance source reads in install output."
  [source]
  (case source
    :deps-edn "deps.edn"
    :project-clj "project.clj"
    :registry "registry"
    :probe "tag probe"
    (str source)))

(defn- print-installs! [results]
  (let [new-installs (filter :installed? results)]
    (when (seq new-installs)
      (println "installing" (count new-installs) "dep(s)...")
      ;; A monorepo package can contribute more than one source path, so the
      ;; line reports every path the dep put on the search path.
      (doseq [{:keys [lib paths via via-source]} new-installs]
        (let [shown (str/join " " paths)]
          (if via
            (println " " lib "->" shown
                     (str " (via " via " " (via-label via-source) ")"))
            (println " " lib "->" shown))))
      (println "done"))))

(defn- with->overlay!
  "Resolve the effective context-name list against the loaded cfg's :contexts.
   On an unknown name, print a clear error and exit 1; other errors propagate."
  [cfg names]
  (try
    (config/context-overlay (config/contexts cfg) names)
    (catch e
           (let [data (ex-data e)
                 nm (:lgx/unknown-context data)]
             (if nm
               (do
                 (write! *err*
                         (str "lgx: unknown context " nm " (defined: "
                              (str/join ", " (sort (map str (:defined data))))
                              ")\n"))
                 (os/exit 1))
               (throw e))))))

;; Fetch the let-go source matching :lg-version (for editor navigation). Opt-in
;; via LGX_FETCH_LET_GO_SOURCE: off and silent by default, since the source only
;; benefits editor tooling (an LSP) and most users don't run it. When enabled it
;; runs regardless of :deps so a deps-less pinned project still gets it; a fetch
;; failure is its own warning and never fails the (already done) deps install.
(defn- install-letgo-source! [cfg]
  (when-let [version (and (cache/letgo-source-fetch-enabled?)
                          (config/lg-version cfg))]
    ;; Only a released version has the v<version> tag the fetch clones; a
    ;; branch or sha pin (valid for the runtime build) has no matching tag,
    ;; so trying would only warn about a nonexistent vmain.
    (if-not (config/semver-version? version)
      (write! *err* (str "warning: :lg-version " version " is not a released "
                         "version; skipping let-go source fetch\n"))
      (try
        (let [r (cache/ensure-letgo-source! version)]
          (when (:installed? r)
            (println (str "Fetched let-go " version " source"))))
        (catch e
               (write! *err* (str "warning: failed to fetch let-go " version
                                  " source: " (ex-message e) "\n")))))))

;; Preflight: when :lg-version is pinned, compare it to the lg on PATH. Warn for
;; iteration commands (run/nrepl), fail for build/test. LGX_SKIP_VERSION_CHECK
;; bypasses both; a dev/unknown installed version is skipped, not warned.
(defn- check-lg-version! [cfg severity]
  (when-let [pinned (config/lg-version cfg)]
    ;; os/getenv returns "" (truthy) when unset, so gate on a non-blank value.
    (when (str/blank? (os/getenv "LGX_SKIP_VERSION_CHECK"))
      (let [installed (version/installed)]
        (when (= :mismatch (version/check pinned installed))
          (let [msg (str "lg " installed " on PATH does not match :lg-version "
                         pinned " in lgx.edn (update the pin or the installed lg)")]
            (if (= severity :fail)
              (do (write! *err* (str "error: " msg "\n")) (os/exit 1))
              (write! *err* (str "warning: " msg "\n")))))))))

(defn- apply-runtime!
  "The single place the runtime enters a command. Called right after the
   basis resolves, because only then are the transitive :go/* coords known.

   :lg-runtime decides which lg runs the project; this validates that choice
   against what the basis needs and never switches mode on its own.

   :installed — the PATH (or LGX_LG) lg. Any Go coord in the tree is an
   error naming the coord and the dep that introduced it: nothing here can
   link it. Otherwise the :lg-version preflight runs, unchanged. Go is never
   invoked. Returns nil.

   :built — the runtime under $LGX_HOME/runtimes, built from the pin with
   the project's Go coords (an empty set renders a stock module). A user-set
   LGX_LG is an error, checked before the Go preflight so it needs no Go and
   before the build so nothing is built only to be discarded. Points LGX_LG
   at the runtime so runner.lg picks it up unchanged; no version check,
   because a runtime built from the pin matches it by construction. Returns
   the runtime path (the value cmd-build needs for -bundle-base)."
  [cfg basis severity verbose?]
  (let [go-pairs (:go-coords basis)
        explicit? (contains? cfg :lg-runtime)]
    (case (config/lg-runtime cfg)
      :installed
      (do
        (when (seq go-pairs)
          (write! *err* (gobuild/installed-go-deps-error
                          go-pairs (:go-origins basis) explicit?))
          (os/exit 1))
        (check-lg-version! cfg severity)
        nil)

      :built
      (do
        (when (gobuild/user-set-lg?)
          (write! *err* (gobuild/built-lg-override-error (os/getenv "LGX_LG")))
          (os/exit 1))
        (gobuild/preflight!)
        (let [path (gobuild/ensure-runtime! go-pairs (config/lg-version cfg)
                                            verbose?)]
          (gobuild/select-runtime! path)
          (when verbose?
            (write! *err* (str "+ custom lg runtime " path "\n")))
          path)))))

(defn- cmd-install [with]
  (let [project (config/find-project!)
        cfg (config/load-config! project)
        overlay (with->overlay! cfg (vec with))
        coords (config/merge-coords (config/coords cfg)
                                    (:deps-pairs overlay))]
    (write! *err* (str (style/header "Installing dependencies...") "\n"))
    (let [basis (if (empty? coords)
                  (do (println "no deps in lgx.edn")
                      {:go-coords []
                       :go-origins {}})
                  ;; The deliberate dependency-management moment: show every
                  ;; pending warning, including ones a warm cache would
                  ;; otherwise keep quiet.
                  (let [{:keys [installs go-coords go-origins]}
                        (ensure-all! project coords true)]
                    (if (some :installed? installs)
                      (print-installs! installs)
                      (println "all deps up to date"))
                    {:go-coords go-coords
                     :go-origins go-origins}))]
      ;; Runs with or without deps: under :built, `lgx install` warms the
      ;; runtime so the first run has nothing left to discover — the
      ;; CI-friendly shape — and a deps-less project still needs that.
      (apply-runtime! cfg basis :warn false))
    (install-letgo-source! cfg)))

(defn- cmd-version []
  (println (str "lgx " version)))

(defn- resolve-project-paths
  "Join each project-relative path onto `project`, warning on stderr for a
   missing one unless it is in `optional` (a shipped default's path, which a
   project need not have)."
  ([label project paths]
   (resolve-project-paths label project paths #{}))
  ([label project paths optional]
   (mapv (fn [p]
           (let [abs (path/join project p)]
             (when-not (or (file-exists? abs) (contains? optional p))
               (write! *err* (str "warning: " label " entry not found: " p "\n")))
             abs))
         paths)))

(defn- basis
  "Resolve `coords`, `raw-paths`, and `raw-resource-paths` into a basis for the
   active project. Returns a map with the project root, the install results, the
   joined source path vector used for `-source-paths`, and the resolved resource
   roots used for `-resource-paths`. `coords` is the coord pair list to resolve
   (project deps, or project+task extras merged); `raw-paths` is the
   project-relative source path list (project :paths, or project :paths ++ a
   task's :extra-paths); `raw-resource-paths` is the project-relative resource
   root list. Source paths include resolved dep dirs; resource paths are
   project-only (deps never contribute resource roots). `optional-paths` is the
   set of raw paths that resolve without a missing-entry warning."
  [project coords raw-paths raw-resource-paths optional-paths]
  (let [{:keys [installs go-coords go-origins]}
        (ensure-all! project coords false)
        own-paths (resolve-project-paths ":paths" project raw-paths
                                         optional-paths)
        paths (vec (concat own-paths (mapcat :paths installs)))
        resource-paths (resolve-project-paths ":resource-paths" project
                                              raw-resource-paths)]
    {:project project
     :results installs
     :go-coords go-coords
     :go-origins go-origins
     :paths paths
     :resource-paths resource-paths}))

(defn- dedup-keep-first
  "Return xs with duplicates removed, keeping each value's first position."
  [xs]
  (loop [seen #{}
         acc []
         ys (seq xs)]
    (if (nil? ys)
      acc
      (let [x (first ys)]
        (if (contains? seen x)
          (recur seen acc (next ys))
          (recur (conj seen x) (conj acc x) (next ys)))))))

(defn- overlay-basis
  "Build the basis (source paths, resource paths, deps) with context overlays
   applied. `cli-with` is the --with name list (possibly empty); `task` is the
   task map, or nil for run/build/test. Layering, low->high precedence: project
   deps/paths/resource-paths < task :with contexts < CLI --with contexts < task
   inline :extra-* (highest). Resource paths layer the same way but, unlike
   source paths, never pick up dep dirs. With no contexts and no task this
   reduces to the project's own deps/paths/resource-paths. `cfg` is the
   project's loaded config map (load-config!). The :extra-paths of an applied
   shipped default (config/default-context?) are optional: a project without
   test/ gets no warning when repl applies :test, while a path the project
   declared itself (in :paths, its own contexts, or the task) still warns when
   missing."
  [project cfg cli-with task]
  (let [names (vec (concat (or (:with task) []) cli-with))
        overlay (with->overlay! cfg names)
        contexts (config/contexts cfg)
        extra-paths-of (fn [pred]
                         (mapcat #(when (pred %) (:extra-paths (get contexts %)))
                                 names))
        default? #(config/default-context? cfg %)
        ;; A path counts as declared when the project wrote it anywhere
        ;; (:paths, one of its own contexts, the task), even if a shipped
        ;; default also contributes it.
        declared (set (concat (config/paths cfg)
                              (extra-paths-of (complement default?))
                              (or (:extra-paths task) [])))
        optional (set (remove declared (extra-paths-of default?)))
        inline-deps (config/dep-pairs (or (:extra-deps task) {}))
        coords (reduce config/merge-coords
                       (config/coords cfg)
                       [(:deps-pairs overlay) inline-deps])
        raw-paths (dedup-keep-first
                    (concat (config/paths cfg)
                            (:paths overlay)
                            (or (:extra-paths task) [])))
        raw-resource-paths (dedup-keep-first
                             (concat (config/resource-paths cfg)
                                     (:resource-paths overlay)
                                     (or (:extra-resource-paths task) [])))]
    (basis project coords raw-paths raw-resource-paths optional)))

(defn- resolve-main-script! [project main-script]
  (let [abs (path/join project main-script)]
    (when-not (file-exists? abs)
      (write! *err* (str "lgx: :main script not found: " main-script "\n"))
      (os/exit 1))
    main-script))

(defn- run-target-error! [reason]
  ;; plan-run-args returns these only when there is no runnable target. Each
  ;; gets a message that teaches the alternatives (name a script, or lgx repl).
  (case reason
    :needs-main
    (write! *err*
            (str "lgx run: -- forwards args to :main, but no :main is set "
                 "in lgx.edn\n"))
    :no-target
    (write! *err*
            (str "lgx run: nothing to run — set :main in lgx.edn, run a script "
                 "(lgx run <script>), or start a REPL (lgx repl)\n")))
  (os/exit 1))

(defn- auto-with!
  "Prepend the contexts `command` applies (config/auto-contexts: run :dev, repl
   and nrepl :dev and :test, test :test) to the CLI --with list `with`. Names
   prepend left-to-right, so a later auto name wins over an earlier one on a
   lib-name collision and an explicit --with context wins over all
   (last-wins). Silent by default; --verbose prints each auto-applied name."
  [command with verbose?]
  (let [auto (config/auto-context-names command)]
    (when verbose?
      (doseq [nm auto]
        (write! *err* (str "+ auto context " nm "\n"))))
    (vec (concat auto with))))

(defn- cmd-run [forward-args verbose? with]
  (let [project (config/find-project!)
        cfg (config/load-config! project)
        main-script (config/main cfg)
        ;; runner/plan-run-args owns the pure decision: a pre-`--` token means
        ;; the user drives lg (pass through); an empty pre injects :main and
        ;; treats post-`--` tokens as the app's args. The app reads those from
        ;; *command-line-args* (let-go >= 1.11.0), identical in dev and a bundled
        ;; binary, so lgx emits no `--` marker. Decide it before building the
        ;; basis so a no-target error never fetches deps for a run that cannot
        ;; happen (mirrors cmd-test's test directory check).
        plan (runner/plan-run-args forward-args main-script)
        _ (when-let [reason (:error plan)]
            (run-target-error! reason))
        with (auto-with! "run" with verbose?)
        basis (overlay-basis project cfg with nil)
        {:keys [results paths resource-paths]} basis
        _ (apply-runtime! cfg basis :warn verbose?)]
    (when (:inject? plan)
      (resolve-main-script! project main-script))
    ;; No status header for `run`: it is the dev-time stand-in for the built
    ;; binary, which prints none. Keeping run header-free makes dev output
    ;; mirror the shipped artifact. (A cold-cache run still prints the install
    ;; block below when deps are actually fetched.)
    (print-installs! results)
    ;; Advertise to the spawned program that it is running under `lgx run`
    ;; (vs. as a bundled binary). A tool can read LGX_RUN to enable dev-only
    ;; behavior. Inherited by the child via env.
    (os/setenv "LGX_RUN" "1")
    (runner/exec-lg-interactive! paths resource-paths (:argv plan) verbose?)))

(defn- cmd-nrepl [forward-args verbose? with]
  (let [{:keys [port]}
        (try
          (cli/parse-nrepl-args (vec forward-args))
          (catch e
                 (write! *err* (str (ex-message e) "\n"))
            (os/exit 1)))
        project (config/find-project!)
        cfg (config/load-config! project)
        with (auto-with! "nrepl" with verbose?)
        basis (overlay-basis project cfg with nil)
        {:keys [results paths resource-paths]} basis
        _ (apply-runtime! cfg basis :warn verbose?)
        ;; No --port: ask lgx's own runtime (let-go >= 1.11.0) for a free
        ;; port via os/free-port, then pass it as the literal -p value lg
        ;; writes to .nrepl-port. The OS vets it as free, so unlike the old
        ;; random guess it's almost never taken. os/free-port is still
        ;; check-then-use, though: on a rare race lg prints "failed to run
        ;; nREPL server on port N" and opens the terminal REPL without an
        ;; nREPL; rerunning picks a fresh port.
        port (or port (os/free-port))]
    (print-installs! results)
    ;; Unlike cmd-run, no LGX_RUN: that var advertises script-arg handling
    ;; to a spawned program, which doesn't apply to a REPL session.
    (runner/exec-lg-interactive! paths resource-paths
                                 ["-n" "-p" (str port)] verbose?)))

(defn- cmd-repl [forward-args verbose? with]
  ;; The plain built-in REPL: `lg <paths>` with no script and no nREPL. It is
  ;; nrepl minus the socket — same deps/paths and same auto contexts, but no
  ;; port and no .nrepl-port. It takes no args of its own (lg flags/scripts are
  ;; `lgx run`'s job).
  (when (seq forward-args)
    (write! *err* "lgx: repl does not take arguments\n")
    (os/exit 1))
  (let [project (config/find-project!)
        cfg (config/load-config! project)
        with (auto-with! "repl" with verbose?)
        basis (overlay-basis project cfg with nil)
        {:keys [results paths resource-paths]} basis
        _ (apply-runtime! cfg basis :warn verbose?)]
    (print-installs! results)
    ;; Empty forward-args: with no script, no -e, and no -n, lg drops into its
    ;; terminal REPL. Like cmd-nrepl, no LGX_RUN for a REPL session.
    (runner/exec-lg-interactive! paths resource-paths [] verbose?)))

(defn- ensure-out-dir! [project rel-out]
  (let [abs (path/join project rel-out)
        parent (path/parent abs)]
    (when parent (mkdir parent))
    abs))

(defn- cmd-build [forward-args verbose? with]
  (let [{:keys [targets all? forward]}
        (try
          (cli/parse-build-args (vec forward-args))
          (catch e
                 (write! *err* (str (ex-message e) "\n"))
            (os/exit 1)))
        project (config/find-project!)
        cfg (config/load-config! project)
        resolved (gobuild/resolve-build-targets targets all?
                                                (config/platforms cfg))
        _ (when (:error resolved)
            (write! *err* (str "lgx: " (:error resolved) "\n"))
            (os/exit 1))
        target-list (:targets resolved)
        cross? (boolean (some some? target-list))
        main-script (config/main cfg)
        bin (:bin (config/targets cfg))
        user-base? (boolean (some #(= "-bundle-base" %) forward))]
    ;; Cheap validation first, before deps resolve or any runtime builds — a
    ;; bad invocation must never spend minutes building things it will not
    ;; use (mirrors cmd-test's test directory check).
    (when (nil? main-script)
      (write! *err* "lgx: :main is required for build (set :main in lgx.edn)\n")
      (os/exit 1))
    (when (nil? bin)
      (write! *err* (str "lgx: :targets/:bin is required for build "
                         "(set :targets {:bin {:out \"...\"}} in lgx.edn)\n"))
      (os/exit 1))
    (resolve-main-script! project main-script)
    ;; :platforms gets this collision check at config load; an ad-hoc
    ;; --target list only meets it here.
    (when-let [dup (gobuild/duplicate-target-out (:out bin) target-list)]
      (write! *err*
              (str "lgx: more than one target renders :out to " (pr-str dup)
                   " - the artifacts would overwrite each other; add an "
                   "{{os}} or {{arch}} placeholder to :out\n"))
      (os/exit 1))
    ;; One hand-picked base binary cannot serve two platforms: every bundle
    ;; would carry the base's platform under a different file name.
    (when (and user-base? (> (count target-list) 1))
      (write! *err*
              (str "lgx: -bundle-base names one base binary, but this build "
                   "has " (count target-list) " targets - drop -bundle-base "
                   "and let lgx build a runtime per target, or build one "
                   "--target at a time\n"))
      (os/exit 1))
    ;; A cross target ships a target-platform lg as its base, which only
    ;; :built can generate. A user-supplied -bundle-base replaces that target
    ;; runtime, so under :installed it is what makes a cross-build possible
    ;; with no Go at all.
    (when (and cross? (not user-base?)
               (= :installed (config/lg-runtime cfg)))
      (write! *err* (gobuild/installed-cross-error
                      (contains? cfg :lg-runtime)))
      (os/exit 1))
    (let [basis (overlay-basis project cfg with nil)
          {:keys [results paths resource-paths]} basis
          go-pairs (:go-coords basis)]
      ;; The host half of the two-runtimes rule: the lg that *executes*
      ;; `lg -b` (and must resolve the project's Go namespaces at compile
      ;; time). Under :built that is a host-platform runtime; under
      ;; :installed, the PATH lg.
      (print-installs! results)
      (let [runtime (apply-runtime! cfg basis :fail verbose?)
            abs-main (path/join project main-script)]
        (doseq [target target-list]
          (let [out-rel (gobuild/target-out (:out bin) target)
                abs-out (ensure-out-dir! project out-rel)
                ;; The target half: `lg -b` copies the running binary as the
                ;; bundle base, so a cross target needs a target-platform
                ;; runtime as -bundle-base — built under :built even with no
                ;; Go deps (the empty coord set renders a stock module).
                ;; Native keeps the host runtime (or none). A user-supplied
                ;; -bundle-base wins and skips the build outright.
                base (cond
                       user-base? nil
                       target (gobuild/ensure-runtime!
                                go-pairs (config/lg-version cfg) target
                                verbose?)
                       :else runtime)
                args (vec (concat (gobuild/inject-bundle-base forward base)
                                  ["-b" abs-out abs-main]))
                label (str "Building " out-rel
                           (if target
                             (str " (" (:os target) "/" (:arch target) ")")
                             "")
                           "...")]
            (write! *err* (str (style/header label) "\n"))
            (let [exit (runner/invoke-lg! paths resource-paths args verbose?)]
              (if (zero? exit)
                (println "built" abs-out)
                (os/exit exit)))))
        (when (> (count target-list) 1)
          (println (str "built " (count target-list) " targets")))
        (os/exit 0)))))

(defn- render-test-dirs
  "Project-relative test dirs as the user reads them: `test/, integration/`."
  [rel-dirs]
  (str/join ", " (map #(str % "/") rel-dirs)))

(defn- validate-error-line [reason user-path dirs-label]
  (case reason
    :not-found (str "lgx: test file not found: " user-path "\n")
    :bad-extension (str "lgx: not a test file (expected .lg, .cljc, or .clj): "
                        user-path "\n")
    :outside-test-dir (str "lgx: test file must be under a test path ("
                           dirs-label "): " user-path "\n")
    (str "lgx: invalid test file: " user-path "\n")))

(defn- single-file-entries! [test-dirs dirs-label user-path project]
  (let [{:keys [abs test-dir]}
        (try
          (test-runner/validate-single-test-file!
            test-dirs user-path project)
          (catch e
                 (let [data (ex-data e)]
                   (write! *err* (validate-error-line (:reason data)
                                                      (:path data)
                                                      dirs-label))
                   (os/exit 1))))]
    [(test-runner/test-entry project test-dir abs)]))

(defn- discover-test-entries
  "Every test file under test-dirs as harness entries, dir by dir in order. A
   dir nested in another declared one would list its files twice; the first
   (outer) dir's entry wins."
  [project test-dirs]
  (->> test-dirs
       (mapcat (fn [dir]
                 (map #(test-runner/test-entry project dir %)
                      (test-runner/discover-test-files dir))))
       (reduce (fn [[seen acc] [display :as e]]
                 (if (contains? seen display)
                   [seen acc]
                   [(conj seen display) (conj acc e)]))
               [#{} []])
       second))

(defn- fail-on-ns-collisions!
  "Exit 1 when a namespace in `ns-syms` is defined by more than one discovered
   file: only the first on the source path would load, so the others' tests
   would never run while the plan reported them."
  [discovered ns-syms]
  (let [wanted (set ns-syms)
        hits (filter #(contains? wanted (first %))
                     (test-runner/ns-collisions discovered))]
    (when (seq hits)
      (doseq [[ns-sym files] hits]
        (write! *err* (str "lgx: test namespace " ns-sym " is defined by more "
                           "than one file (" (str/join ", " files) ")\n")))
      (os/exit 1))))

(defn- cmd-test [forward-args verbose? with]
  (let [{:keys [exclude positionals]}
        (try
          (cli/parse-test-args (vec forward-args))
          (catch e
                 (write! *err* (str (ex-message e) "\n"))
            (os/exit 1)))
        _ (when (> (count positionals) 1)
            (write! *err* "lgx: test takes at most one argument\n")
            (os/exit 1))
        single? (= 1 (count positionals))
        ;; Filtering a one-file plan can only leave nothing to run, so the
        ;; combination is a mistake worth naming rather than a no-op.
        _ (when (and single? (seq exclude))
            (write! *err* "lgx: --exclude cannot be combined with a test file\n")
            (os/exit 1))
        project (config/find-project!)
        cfg (config/load-config! project)
        ;; Tests live under the effective :test context's :extra-paths (the
        ;; shipped default is ["test"]), in declared order. Missing ones are
        ;; skipped here; the basis still warns about a missing path the
        ;; project declared itself.
        declared (:extra-paths (get (config/contexts cfg) :test))
        _ (when (empty? declared)
            (write! *err* (str "lgx: the :test context defines no :extra-paths, "
                               "so lgx test has nowhere to look\n"))
            (os/exit 1))
        present (filterv #(let [st (os/stat (path/normalize
                                              (path/join project %)))]
                            (and st (:dir? st)))
                         declared)
        test-dirs (mapv #(path/normalize (path/join project %)) present)
        dirs-label (render-test-dirs present)]
    ;; Cheap validation first: flags, the single file, discovery and the
    ;; --exclude filter all run before the basis is built, so a bad
    ;; invocation (or an empty plan) never fetches deps for a run that cannot
    ;; happen. Discovery needs a test dir to exist, so that check leads.
    (when (empty? test-dirs)
      (write! *err* (str "lgx: no test directory in project (looked for: "
                         (render-test-dirs declared) ")\n"))
      (os/exit 1))
    (let [all (discover-test-entries project test-dirs)
          entries (if single?
                    (single-file-entries! test-dirs dirs-label
                                          (first positionals) project)
                    (let [{:keys [entries unmatched]}
                          (test-runner/exclude-entries all exclude)]
                      ;; A typo must fail loud, before either empty-plan exit:
                      ;; silently running the test the user meant to skip is
                      ;; the worst outcome.
                      (when (seq unmatched)
                        (doseq [ns-sym unmatched]
                          (write! *err* (str "lgx: --exclude names no test "
                                             "namespace: " ns-sym "\n")))
                        (os/exit 1))
                      (when (empty? all)
                        (println (str "No tests found in " dirs-label))
                        (os/exit 0))
                      (when (empty? entries)
                        (println "All test files excluded")
                        (os/exit 0))
                      entries))
          ;; A plan namespace that another file also defines would load only
          ;; one of the two. A single file joins the discovered set, since it
          ;; need not match *_test.
          _ (let [known (set (map first all))]
              (fail-on-ns-collisions!
                (concat all (remove #(contains? known (first %)) entries))
                (map second entries)))
          with (auto-with! "test" with verbose?)
          basis (overlay-basis project cfg with nil)
          {:keys [results paths resource-paths]} basis
          _ (apply-runtime! cfg basis :fail verbose?)
          header (if single? (first (first entries)) dirs-label)
          {harness-dir :dir harness :entry}
          (test-runner/write-harness! entries version)
          ;; The test dirs arrive through the :test overlay, with the
          ;; project's own paths. The harness directory goes last: its
          ;; namespaces are the entry's own, and nothing in a project should
          ;; shadow them.
          source-paths (vec (concat paths [harness-dir]))]
      (when (and verbose? (seq exclude))
        (write! *err* (str "+ excluded: " (str/join ", " exclude) "\n")))
      (when verbose?
        (write! *err* (str "+ test runner: " harness "\n")))
      (write! *err*
              (str (style/header (str "Running tests in " header "...")) "\n"))
      (print-installs! results)
      ;; A test file that fails to load must never pass silently, and lg has
      ;; reported that two different ways across versions: through 1.11.x
      ;; `require` swallowed the error, printing "error: failed to load ..." to
      ;; stderr while still exiting 0 with the harness reporting 0 failures;
      ;; from 1.12.x it throws, so the harness never starts. Replay lg's output
      ;; (minus the harness marker), then treat either shape as a failure — the
      ;; harness never signalling ready, or a pre-harness diagnostic that
      ;; slipped through a zero exit.
      (let [r (runner/run-lg! source-paths resource-paths [harness] verbose?)
            exit (:exit r)]
        (when (seq (:out r)) (write! *out* (:out r)))
        (let [shown-err (test-runner/strip-ready-marker (:err r))]
          (when (seq shown-err) (write! *err* shown-err)))
        (if (or (not (test-runner/harness-ready? (:err r)))
                (and (zero? exit)
                     (test-runner/load-error-before-harness? (:err r))))
          (do (write! *err* "lgx: a test file failed to load (see errors above)\n")
              (os/exit (if (zero? exit) 1 exit)))
          (os/exit exit))))))

;; `project` and `cfg` arrive preloaded from dispatch, which had to read the
;; config to know the command names a task at all.
(defn- surplus-args-error?
  "True for the two bind-args messages that mean \"more CLI args than this
   task declares\" — the ones :args/rest would have absorbed."
  [msg]
  (or (str/starts-with? msg "task takes no arguments")
      (str/starts-with? msg "too many arguments")))

(defn- cmd-task [task-name task rest-args project cfg verbose? with]
  ;; A task's basis layers, low->high precedence: project deps/paths <
  ;; the task's :with contexts < the CLI --with contexts < the task's
  ;; inline :extra-deps/:extra-paths/:extra-resource-paths. extra-deps
  ;; override same-named deps (silently; see config/merge-coords). All of
  ;; this affects only the task's :run steps (source + resource paths);
  ;; :sh steps ignore the basis.
  ;;
  ;; CLI args bind against the task's :args first — cheap validation before
  ;; the basis is built, so a bad invocation never fetches deps. Arity is
  ;; strict unless a step forwards :args/rest.
  (let [stack (tasks/stack-entries (os/getenv tasks/stack-var)
                                   (os/getenv tasks/roots-var))]
    (when (tasks/stack-cycle? stack task-name project)
      (write! *err* (str "lgx: task '" task-name "' is already running ("
                         (tasks/stack-chain stack task-name)
                         "); to call the built-in from a task, use lgx:"
                         task-name "\n"))
      (os/exit 1))
    (let [decls (vec (or (:args task) []))
          rest? (args/uses-rest? (:do task))
          bound (args/bind-args decls rest-args rest?)]
      (when (:errors bound)
        (doseq [msg (:errors bound)]
          (write! *err* (str "lgx: " task-name ": " msg
                             (if (and (not rest?) (surplus-args-error? msg))
                               " (to forward extra args to a step, add :args/rest to it)"
                               "")
                             "\n")))
        (write! *err* (str (args/usage-line task-name decls rest?) "\n"))
        (os/exit 1))
      (let [basis (overlay-basis project cfg with task)
            {:keys [results paths resource-paths]} basis]
        (apply-runtime! cfg basis :warn verbose?)
        (print-installs! results)
        (let [[names roots] (tasks/stack-values stack task-name project)]
          (os/setenv tasks/stack-var names)
          (os/setenv tasks/roots-var roots))
        (tasks/run-task! task-name task paths resource-paths verbose?
                         (:bindings bound)
                         ;; The caller's effective contexts, forwarded to a
                         ;; :task step's child as --with so the child's own
                         ;; layering unions them with the callee's :with.
                         (vec (concat (:with task) with)))))))

(defn- pad-right [s n]
  (let [c (count s)]
    (if (>= c n) s (str s (apply str (repeat (- n c) " "))))))

;; ---------------------------------------------------------------------------
;; lgx info — the runtime decision, spelled out
;; ---------------------------------------------------------------------------

(def ^:private info-col 14)

(defn- info-line [label value]
  (str (pad-right label info-col) value))

(defn- info-continuation [value]
  (str (apply str (repeat info-col " ")) value))

(defn- go-dep-label
  "One Go coord as `lgx info` lists it: lib, its version or local dir, the
   interop alias when it has one, and the dep that introduced it."
  [[lib c] go-origins]
  (str/join " " (concat [(str lib)]
                        (cond
                          (:go/version c) [(:go/version c)]
                          (:go/local c) [(str "local " (:go/local c))]
                          :else [])
                        (if (:go/interop c)
                          [(str "interop " (pr-str (:go/interop c)))]
                          [])
                        (if-let [origin (get go-origins lib)]
                          [(str "(via " origin ")")]
                          []))))

(defn- info-version-line
  "The :installed mode's `version` line: the outcome of the same check the
   commands run (check-lg-version!)."
  [pin lg-version skip-check?]
  (cond
    (nil? pin) "skipped (no :lg-version)"
    skip-check? "skipped (LGX_SKIP_VERSION_CHECK)"
    :else (case (version/check pin lg-version)
            :ok "ok"
            :skip "skipped (lg not found or a dev build)"
            :mismatch (str "mismatch: lg " lg-version
                           " does not match :lg-version " pin))))

(defn- info-lines
  "Pure. The `lgx info` report as label/value lines, from the loaded config,
   the resolved basis, and `env` — the probed values cmd-info gathers so the
   rendering needs no subprocess: :lg-version and :lg-path (the lg the next
   command runs: under :installed the PATH/LGX_LG one, under :built the cached
   runtime), :runtime-out and :runtime-built? (:built only; :runtime-out nil
   when the pin is a branch that only a build can resolve), :go-version,
   :go-path, :replace-path, :user-lg (LGX_LG when the user set it) and
   :skip-check?. Ends with the effective contexts (shipped defaults marked)
   and the contexts each built-in applies, both read from lgx.config so the
   report cannot drift from what the commands do."
  [cfg basis env]
  (let [mode (config/lg-runtime cfg)
        explicit? (contains? cfg :lg-runtime)
        pin (config/lg-version cfg)
        go-pairs (sort-by (fn [[lib _]] (str lib)) (:go-coords basis))
        go-origins (:go-origins basis)
        head [(info-line "project" (:project basis))
              (info-line "lgx" version)
              (info-line "lg-runtime" (str (name mode)
                                           (if explicit? "" " (default)")))
              (info-line "lg-version" (or pin "(none)"))]
        body (case mode
               :installed
               [(info-line "lg" (str (or (:lg-version env) "not found")
                                     " (" (:lg-path env) ")"))
                (info-line "version" (info-version-line
                                       pin (:lg-version env)
                                       (:skip-check? env)))]

               :built
               (vec
                 (concat
                   [(info-line "lg"
                               (cond
                                 (nil? (:runtime-out env))
                                 (str "unresolved (:lg-version " (pr-str pin)
                                      " is a branch, resolved at build time; "
                                      "run lgx install)")

                                 (:runtime-built? env)
                                 (str (or (:lg-version env) "unknown")
                                      " (" (:runtime-out env) ")")

                                 :else
                                 (str "not built yet (" (:runtime-out env) ")")))
                    (info-line "go" (if (:go-path env)
                                      (str (:go-version env) " (" (:go-path env) ")")
                                      "not on PATH"))]
                   (if (:replace-path env)
                     [(info-line "let-go" (str "replace " (:replace-path env)))]
                     [])
                   (if (:user-lg env)
                     [(info-line "LGX_LG" (str (:user-lg env)
                                               " (conflicts with :lg-runtime :built)"))]
                     []))))
        deps (if (empty? go-pairs)
               [(info-line "go-deps" "(none)")]
               (cons (info-line "go-deps" (go-dep-label (first go-pairs) go-origins))
                     (map #(info-continuation (go-dep-label % go-origins))
                          (rest go-pairs))))
        contexts (config/contexts cfg)
        context-names (concat [:dev :test]
                              (sort-by str (remove #{:dev :test}
                                                   (keys contexts))))
        context-rows (map (fn [nm]
                            (str nm " " (pr-str (get contexts nm))
                                 (if (config/default-context? cfg nm)
                                   " (default)"
                                   "")))
                          context-names)
        applies-rows (map (fn [command]
                            (str command " "
                                 (str/join " " (config/auto-context-names
                                                 command))))
                          ["run" "repl" "nrepl" "test"])
        block (fn [label rows]
                (cons (info-line label (first rows))
                      (map info-continuation (rest rows))))]
    (vec (concat head body deps
                 (block "contexts" context-rows)
                 (block "applies" applies-rows)))))

(defn- cmd-info
  "Read-only: resolve the basis like install (a cold cache fetches deps and
   prints the install block), probe the environment, and print the runtime
   decision. Never builds a runtime and never resolves a branch pin, so it
   exits non-zero only for an invalid lgx.edn or a failed dep fetch."
  [verbose? with]
  (let [project (config/find-project!)
        cfg (config/load-config! project)
        basis (overlay-basis project cfg with nil)
        pin (config/lg-version cfg)
        user-lg? (gobuild/user-set-lg?)
        replace-path (gobuild/letgo-replace-path)
        env (case (config/lg-runtime cfg)
              :installed
              {:lg-version (version/installed)
               :lg-path (or (runner/lg-resolved-path) (runner/lg-binary))
               :skip-check? (not (str/blank? (os/getenv "LGX_SKIP_VERSION_CHECK")))}

              :built
              ;; A branch or tag only becomes a cache path through
              ;; `go list -m`, which needs the network and exits the process
              ;; on failure - so info reports it unresolved instead.
              (let [out (when (or replace-path
                                  (not (gobuild/mutable-letgo-ref? pin)))
                          (:out (gobuild/runtime-paths (:go-coords basis) pin
                                                       nil verbose?)))
                    built? (boolean (and out (file-exists? out)))]
                {:runtime-out out
                 :runtime-built? built?
                 :lg-version (when built? (runner/lg-version out))
                 :go-path (gobuild/go-path)
                 :go-version (gobuild/go-version)
                 :replace-path replace-path
                 :user-lg (when user-lg? (os/getenv "LGX_LG"))}))]
    (print-installs! (:results basis))
    (doseq [line (info-lines cfg basis env)]
      (println line))))

;; Tasks render as `lgx <name> <arg> [arg]` aligned to the same description
;; column as the built-in command rows, so they read as first-class commands.
(defn- task-line [task-name task]
  (let [sig (args/signature (or (:args task) []) (args/uses-rest? (:do task)))
        left (str "  lgx " task-name
                  (if (str/blank? sig) "" (str " " sig)))
        ;; A task carrying a built-in's name shadows it, so the row says so
        ;; and names the escape. No stderr notice when such a task runs — the
        ;; user wrote it; help is where the surprise is worth spelling out.
        override (when (config/overridable-command? (str task-name))
                   (str "(overrides built-in; run lgx:" task-name
                        " for the original)"))
        own-doc (:doc task)
        doc (cond
              (str/blank? own-doc) override
              (nil? override) own-doc
              :else (str own-doc " " override))]
    (cond
      (str/blank? doc) left
      (>= (count left) doc-col) (str left "  " doc)
      :else (str (pad-right left doc-col) doc))))

;; `loaded` is config/load-config output ({:cfg ...} or {:errors ...}), or nil
;; when no project was found. Help must stay usable with a broken config, so
;; an invalid lgx.edn renders a one-line warning instead of failing.
(defn- tasks-block [loaded]
  (cond
    (nil? loaded) nil

    (:errors loaded)
    (str "\n"
         "Project tasks:\n"
         "  (omitted — lgx.edn is invalid; run `lgx install` to see errors)\n")

    :else
    ;; Iterate the keys themselves: rebuilding a key from (name k) would drop
    ;; the namespace of a task like foo/bar.
    (let [t (config/tasks (:cfg loaded))
          sorted-keys (sort-by str (keys t))]
      (when (seq t)
        (str "\n"
             "Project tasks:\n"
             (str/join "\n" (map (fn [k] (task-line k (get t k)))
                                 sorted-keys))
             "\n")))))

;; Assembled at call time so the colored titles honor LGX_NO_COLOR at runtime.
;; Order: synopsis -> Built-in commands -> Project tasks (if any) -> Global
;; options. `loaded` may be nil (no project found); the tasks block is then
;; omitted.
(defn- usage-for [loaded]
  (str "lgx - project manager for let-go\n"
       "\n"
       "Usage: lgx [options] <command> [args...]\n"
       "\n"
       "Built-in commands:\n"
       command-rows
       (or (tasks-block loaded) "")
       "\n"
       "Options:\n"
       option-rows))

(defn- print-usage! []
  (print (usage-for (when-let [project (config/find-project)]
                      (config/load-config project)))))

(defn- unknown-command! [cmd]
  (write! *err*
          (str "lgx: '" cmd "' is not a lgx command. See 'lgx --help'.\n"))
  (os/exit 1))

(defn- run-builtin!
  "Run the overridable built-in named `name`. Callers check
   config/overridable-command? first, so there is no fall-through case: these
   commands mostly exit on their own, and a nil return would be
   indistinguishable from \"not a built-in\"."
  [name rest-args verbose? with]
  (case name
    "install" (cmd-install with)
    "info" (cmd-info verbose? with)
    "run" (cmd-run (vec rest-args) verbose? with)
    "repl" (cmd-repl (vec rest-args) verbose? with)
    "nrepl" (cmd-nrepl (vec rest-args) verbose? with)
    "build" (cmd-build (vec rest-args) verbose? with)
    "test" (cmd-test (vec rest-args) verbose? with)
    "clean" (clean/cmd-clean! (vec rest-args))))

(defn- project-task
  "The project task named `cmd`, with the project and config it came from, or
   nil when there is none. A project whose lgx.edn does not load is treated as
   having no tasks: the built-ins that need the config keep reporting the
   errors themselves, and an unknown command still falls through to the
   validation report below."
  [cmd]
  (when-let [project (config/find-project)]
    (let [cfg (:cfg (config/load-config project))
          k (symbol cmd)]
      (when (and cfg (contains? (config/tasks cfg) k))
        {:project project
         :cfg cfg
         :task (get (config/tasks cfg) k)}))))

;; `with` is the CLI --with context-name list (empty when the flag is absent).
;; It is threaded to every command, but only the basis commands
;; (run/build/test/install/tasks) act on it; new/version/help ignore it.
;;
;; Resolution order, first match wins: the fixed commands, which run without a
;; project and so can never be shadowed by one; `lgx:<name>`, which always
;; reaches the built-in; a project task; the overridable built-ins; unknown.
(defn- dispatch [cmd rest-args verbose? with]
  (cond
    (nil? cmd) (do (print-usage!) (os/exit 1))

    (contains? #{"help" "-h" "--help"} cmd) (print-usage!)
    (contains? #{"version" "-v" "--version"} cmd) (cmd-version)
    (= "new" cmd) (new/cmd-new! (vec rest-args) verbose?)
    ;; Hidden: no help row for either. `completion` prints a shell script for
    ;; the README setup snippets; `__complete` is the dynamic endpoint those
    ;; scripts call on TAB.
    (= "completion" cmd) (completion/cmd-completion! (vec rest-args))
    (= "__complete" cmd) (do (completion/complete! (vec rest-args))
                             (os/exit 0))

    ;; lgx:<name> addresses the built-in past any task of that name — the
    ;; escape an overriding task uses to call the command it wraps.
    (some? (cli/strip-lgx-prefix cmd))
    (let [name (cli/strip-lgx-prefix cmd)]
      (if (config/overridable-command? name)
        (run-builtin! name rest-args verbose? with)
        (do (write! *err* (str "lgx: '" cmd "' is not a built-in command "
                               config/builtins-label "\n"))
            (os/exit 1))))

    :else
    (if-let [found (project-task cmd)]
      (cmd-task cmd (:task found) (vec rest-args) (:project found) (:cfg found)
                verbose? with)
      (if (config/overridable-command? cmd)
        (run-builtin! cmd rest-args verbose? with)
        ;; Not a task and not a built-in. With a project present, an invalid
        ;; lgx.edn reports its validation errors here rather than a misleading
        ;; "not a lgx command" — the command might have named a task in it.
        (if-let [project (config/find-project)]
          (do (config/load-config! project)
              (unknown-command! cmd))
          (unknown-command! cmd))))))

(defn- main []
  (let [{:keys [verbose? with args]}
        (try
          (cli/parse-leading-flags (cli/user-args os/args))
          (catch e
                 (write! *err* (str (ex-message e) "\n"))
            (os/exit 1)))
        cmd (first args)
        rest-args (rest args)]
    (dispatch cmd rest-args verbose? with)))

;; Top-level forms run during AOT compilation too. Guard so `lg -b` doesn't
;; execute the CLI while bundling.
(when-not *compiling-aot* (main))
