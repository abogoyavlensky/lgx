(ns lgx.config
  (:require [edn]
            [lgx.path :as path]
            [lgx.spec :as spec]
            [string :as str]))

(def config-name "lgx.edn")

(defn find-project
  "Walk up from CWD looking for lgx.edn. Returns the project root or nil."
  []
  (loop [dir (os/cwd)]
    (cond
      (nil? dir) nil
      (file-exists? (path/join dir config-name)) dir
      :else (recur (path/parent dir)))))

(defn find-project!
  "Like find-project, but exits with an error if no lgx.edn is found."
  []
  (or (find-project)
      (do (println "error: no" config-name "found in this or any parent directory")
          (os/exit 1))))

(def ^:private git-keys #{:git/url :git/sha :git/tag})

;; Built-in CLI commands that may not be shadowed by a project task. Includes
;; subcommands that don't exist yet (add, update, tasks) but that are reserved
;; so the namespace is available for future use.
(def reserved-task-names
  #{"run" "repl" "nrepl" "install" "new" "add" "update" "tasks" "help" "version"
    "build" "test" "completion" "__complete"})

;; ---------------------------------------------------------------------------
;; lgx.edn format as one schema value (see lgx.spec for the schema language)
;; ---------------------------------------------------------------------------

(defn- rel-path-errors
  "Relative-path rule shared by :paths entries, :main, :targets :out, and
   :deps/root. lgx.edn path values use forward-slash by convention, matching
   tools.deps. Returns a vector of error message strings."
  [v]
  (cond
    (not (string? v)) [(str "must be a string, got " (pr-str v))]
    (str/blank? v) ["must be non-blank"]
    (str/starts-with? v "/") ["must be relative (no leading /)"]
    (some #(= ".." %) (str/split v "/")) ["must not contain .. segments"]
    :else []))

(def ^:private rel-path-schema [:fn rel-path-errors])

(defn- non-blank-string-errors [v]
  (cond
    (not (string? v)) [(str "must be a string, got " (pr-str v))]
    (str/blank? v) ["must be non-blank"]
    :else []))

(defn- at-key
  "Anchor errors at sub-path [k]. Accepts plain message strings and
   {:path :msg} maps, whose own relative path is nested under k."
  [k errs]
  (mapv (fn [e]
          (if (string? e)
            {:path [k]
             :msg e}
            {:path (vec (cons k (:path e)))
             :msg (:msg e)}))
        errs))

(defn- exclusions-errors
  "A coord's :exclusions — a vector of lib symbols. Scope is the consuming
   dep: each symbol is matched verbatim against the names that dep declares
   in its own deps.edn/project.clj (tools.deps vocabulary)."
  [v]
  (if-not (vector? v)
    [(str "must be a vector of symbols, got " (pr-str v))]
    (loop [i 0
           acc []]
      (if (>= i (count v))
        acc
        (recur (inc i)
               (if (symbol? (nth v i))
                 acc
                 (conj acc {:path [i]
                            :msg (str "must be a symbol, got "
                                      (pr-str (nth v i)))})))))))

;; Rejected with a dedicated message rather than left to the generic
;; missing-:git/url checks: a :mvn/version coord is almost always pasted from
;; a library README, and the useful reply names the substitution. The key
;; itself stays unoccupied — no API commitment.
(def ^:private mvn-version-msg
  (str ":mvn/version is not supported - let-go runs Clojure libs from source; "
       "use :git/url + :git/tag (or :git/sha) pointing at the lib's repo "
       "(see examples/clojure-libs/)"))

(defn- coord-errors
  "Coord rule: :local/root or :git/url + (:git/sha | :git/tag), optional
   :deps/root and :exclusions. Coord maps are open — unknown keys are
   tools.deps forward-compat, not errors."
  [c]
  (let [has-local? (contains? c :local/root)
        has-git? (some #(contains? c %) git-keys)
        deps-root (if (contains? c :deps/root)
                    (at-key :deps/root (rel-path-errors (:deps/root c)))
                    [])
        exclusions (if (contains? c :exclusions)
                     (at-key :exclusions (exclusions-errors (:exclusions c)))
                     [])]
    (cond
      ;; First and short-circuiting: the teaching message is the whole answer,
      ;; and the shape checks below would only bury it.
      (contains? c :mvn/version)
      mvn-version-msg

      (and has-local? has-git?)
      "cannot mix :local/root with :git/* keys"

      has-local?
      (vec (concat (at-key :local/root
                           (non-blank-string-errors (:local/root c)))
                   deps-root
                   exclusions))

      :else
      (vec (concat
             (when-not (string? (:git/url c)) ["missing :git/url"])
             (when-not (or (string? (:git/sha c)) (string? (:git/tag c)))
               ["must specify :git/sha or :git/tag"])
             deps-root
             exclusions)))))

(def ^:private coord-schema [:and :map [:fn coord-errors]])

(def ^:private deps-schema [:map-of :symbol coord-schema])

(defn- placeholder-kw?
  "True for an :arg/<name> placeholder keyword in a step vector."
  [x]
  (and (keyword? x) (= "arg" (namespace x))))

(defn- action-value-errors
  "A step's :sh/:run value: a non-blank string or a non-empty vector whose
   items are strings or :arg/<name> placeholder keywords. Whether a
   placeholder names a declared arg is the task-level cross-check's job."
  [v]
  (cond
    (string? v) (if (str/blank? v) ["must be a non-blank string"] [])

    (vector? v)
    (if (empty? v)
      ["must be a non-empty vector of strings"]
      (loop [i 0
             acc []]
        (if (>= i (count v))
          acc
          (recur (inc i)
                 (if (or (string? (nth v i)) (placeholder-kw? (nth v i)))
                   acc
                   (conj acc {:path [i]
                              :msg (str "must be a string or :arg/<name> "
                                        "placeholder, got "
                                        (pr-str (nth v i)))}))))))

    :else
    [(str "must be a string or vector of strings, got " (pr-str v))]))

(defn- exactly-one-action-errors [step]
  (when (not= 1 (count (filter #(contains? step %) [:sh :run])))
    "must contain exactly one of :sh, :run"))

(def ^:private step-schema
  [:and
   [:map {:closed true}
    [:sh {:optional true} [:fn action-value-errors]]
    [:run {:optional true} [:fn action-value-errors]]]
   [:fn exactly-one-action-errors]])

(defn- do-errors
  "A task's :do — a single step map or a non-empty vector of steps. Recurses
   into the engine; the returned relative paths get prefixed by the caller."
  [v]
  (cond
    (map? v) (spec/validate step-schema v)
    (vector? v) (spec/validate [:vector {:min 1} step-schema] v)
    :else (str "must be a step map or non-empty vector of steps, got "
               (pr-str v))))

(defn- arg-name-errors
  "An arg's :name — an unqualified keyword; :arg/<name> can't encode a
   namespace."
  [v]
  (cond
    (not (keyword? v)) [(str "must be a keyword, got " (pr-str v))]
    (namespace v) [(str "must be an unqualified keyword, got " v)]
    :else []))

(defn- arg-type-errors
  "An arg's :type — :int, :string, or [:enum v1 v2 ...] with at least two
   distinct non-blank string values (CLI values arrive as strings)."
  [t]
  (cond
    (or (= t :int) (= t :string))
    []

    (and (vector? t) (= :enum (first t)))
    (let [values (vec (rest t))]
      (cond
        (< (count values) 2) ["must list at least 2 enum values"]
        (some #(or (not (string? %)) (str/blank? %)) values)
        ["enum values must be non-blank strings"]
        (not= (count values) (count (set values)))
        ["enum values must be distinct"]
        :else []))

    :else
    [(str "must be :int, :string, or [:enum ...], got " (pr-str t))]))

(defn- arg-default-errors
  "Arg-map cross-key rule: :default must match the (defaulted) :type. Runs
   only after the structural map check passed, so :type is well-formed."
  [a]
  (when (contains? a :default)
    (let [t (or (:type a) :string)
          d (:default a)]
      (cond
        (= t :string)
        (when-not (string? d)
          {:path [:default]
           :msg (str "must be a string (type :string), got " (pr-str d))})

        (= t :int)
        (when-not (integer? d)
          {:path [:default]
           :msg (str "must be an integer (type :int), got " (pr-str d))})

        :else
        (let [allowed (vec (rest t))]
          (when-not (some #(= % d) allowed)
            {:path [:default]
             :msg (str "must be one of: " (str/join ", " allowed)
                       ", got " (pr-str d))}))))))

(def ^:private arg-schema
  [:and
   [:map {:closed true}
    [:name [:fn arg-name-errors]]
    [:type {:optional true} [:fn arg-type-errors]]
    [:default {:optional true} :any]]
   [:fn arg-default-errors]])

(defn- args-vector-errors
  "Vector-level rules over valid arg maps: unique names, and trailing
   optionals — once an arg has :default, every later arg must too (CLI
   values fill positions left to right, so only a trailing arg can be
   omitted)."
  [v]
  (loop [i 0
         seen #{}
         seen-default? false
         acc []]
    (if (>= i (count v))
      acc
      (let [a (nth v i)
            n (:name a)
            has-default? (contains? a :default)
            acc (if (contains? seen n)
                  (conj acc {:path [i :name]
                             :msg (str "duplicate arg name " n)})
                  acc)
            acc (if (and seen-default? (not has-default?))
                  (conj acc {:path [i]
                             :msg (str "required arg " n
                                       " cannot follow an arg with :default")})
                  acc)]
        (recur (inc i) (conj seen n) (or seen-default? has-default?) acc)))))

(def ^:private args-schema
  [:and [:vector {:min 1} arg-schema] [:fn args-vector-errors]])

(defn- step-placeholder-errors
  "Unknown-:arg/* errors for one valid step, paths relative to the step.
   `label` renders the declared names, or nil when the task has no :args."
  [declared label step]
  (let [k (if (contains? step :sh) :sh :run)
        v (get step k)]
    (if-not (vector? v)
      []
      (loop [j 0
             acc []]
        (if (>= j (count v))
          acc
          (let [item (nth v j)]
            (recur (inc j)
                   (if (and (placeholder-kw? item)
                            (not (contains? declared item)))
                     (conj acc {:path [k j]
                                :msg (if (nil? label)
                                       (str "placeholder " item
                                            " used but no :args declared")
                                       (str "unknown placeholder " item
                                            " (declared: " label ")"))})
                     acc))))))))

(defn- task-placeholder-errors
  "Task-level cross-key rule: every :arg/* placeholder in :do must name a
   declared arg. Runs only after the structural schema passed, so steps and
   :args hold their shapes. Walks both :do forms — a single step map or a
   vector of steps — because validation runs before normalize-config."
  [task]
  (let [decls (:args task)
        declared (set (mapv #(keyword "arg" (name (:name %))) (or decls [])))
        label (when decls (str/join ", " (mapv (comp str :name) decls)))
        d (:do task)]
    (if (map? d)
      (mapv (fn [e] {:path (vec (cons :do (:path e)))
                     :msg (:msg e)})
            (step-placeholder-errors declared label d))
      (vec (mapcat (fn [i]
                     (mapv (fn [e] {:path (vec (concat [:do i] (:path e)))
                                    :msg (:msg e)})
                           (step-placeholder-errors declared label (nth d i))))
                   (range (count d)))))))

(defn- task-name-errors [k]
  (cond
    ;; (subs (str k) 1) rather than (name k): a namespaced keyword like
    ;; :foo/bar must migrate to foo/bar, not bar.
    (keyword? k)
    (str "task names are symbols; write " (subs (str k) 1) " instead of " k)

    (not (symbol? k))
    (str "must be a symbol, got " (pr-str k))

    ;; (str k) rather than (name k): only a bare name can shadow a built-in —
    ;; a namespaced foo/run dispatches as "foo/run", never as "run".
    (contains? reserved-task-names (str k))
    (str "conflicts with built-in command \"" k "\"")))

(def ^:private task-schema
  [:and
   [:map {:closed true}
    [:doc {:optional true} :string]
    [:args {:optional true} args-schema]
    [:do [:fn do-errors]]
    [:extra-paths {:optional true} [:vector rel-path-schema]]
    [:extra-resource-paths {:optional true} [:vector rel-path-schema]]
    [:extra-deps {:optional true} deps-schema]
    [:with {:optional true} [:vector :keyword]]]
   [:fn task-placeholder-errors]])

;; A context is a named overlay carrying only extras — the same shape as a
;; task's inline extras, lifted to the project top level for reuse across
;; commands (via --with) and tasks (via :with).
(def ^:private context-schema
  [:map {:closed true}
   [:extra-deps {:optional true} deps-schema]
   [:extra-paths {:optional true} [:vector rel-path-schema]]
   [:extra-resource-paths {:optional true} [:vector rel-path-schema]]])

(def ^:private targets-schema
  [:map {:closed true}
   [:bin {:optional true}
    [:map {:closed true}
     [:out rel-path-schema]]]])

(defn- with-refs-errors
  "Root-level cross-key rule: every task :with entry must name a defined
   context. Runs only after the structural schema passed, so shapes hold."
  [cfg]
  (let [defined (set (keys (or (:contexts cfg) {})))
        label (if (seq defined)
                (str "(defined: " (str/join ", " (sort (map str defined))) ")")
                "(no contexts defined)")]
    (vec (mapcat (fn [[task-name task]]
                   (mapv (fn [c]
                           {:path [:tasks task-name :with]
                            :msg (str "references unknown context " c " "
                                      label)})
                         (filter #(not (contains? defined %))
                                 (or (:with task) []))))
                 (or (:tasks cfg) {})))))

(def ^:private lgx-schema
  [:and
   [:map {:closed true}
    [:deps {:optional true} deps-schema]
    [:paths {:optional true} [:vector rel-path-schema]]
    [:resource-paths {:optional true} [:vector rel-path-schema]]
    [:main {:optional true} rel-path-schema]
    [:lg-version {:optional true} [:fn non-blank-string-errors]]
    [:targets {:optional true} targets-schema]
    [:contexts {:optional true} [:map-of :keyword context-schema]]
    [:tasks {:optional true}
     [:map-of [:fn task-name-errors] task-schema]]]
   [:fn with-refs-errors]])

(defn- normalize-config
  "Post-validation normalization: a task's single-step-map :do becomes a
   one-element vector. Validation never mutates; this never validates."
  [cfg]
  (if (contains? cfg :tasks)
    (assoc cfg :tasks
           (into {}
                 (map (fn [[k t]]
                        [k (if (map? (:do t)) (assoc t :do [(:do t)]) t)])
                      (:tasks cfg))))
    cfg))

(defn- first-line [s]
  (first (str/split s "\n")))

(defn load-config
  "Read, validate, and normalize the project's lgx.edn. Returns
   {:cfg <map>} on success or {:errors [{:path [...] :msg ...} ...]}.
   EDN reader failures are reported as a single error, not thrown."
  [project]
  (let [config-path (path/join project config-name)
        parsed (try
                 {:value (edn/read-string (slurp config-path))}
                 (catch e
                        {:error (first-line (ex-message e))}))]
    (if (contains? parsed :error)
      {:errors [{:path []
                 :msg (str "could not parse lgx.edn: " (:error parsed))}]}
      (let [errors (spec/validate lgx-schema (:value parsed))]
        (if (seq errors)
          {:errors errors}
          {:cfg (normalize-config (:value parsed))})))))

(defn- errors-report [label errors]
  (str "lgx: invalid " label " (" (count errors) " error"
       (if (= 1 (count errors)) "" "s") ")\n\n"
       (str/join "\n" (map #(str "  " (spec/error->line %)) errors))
       "\n"))

(defn load-config!
  "Like load-config, but on errors prints the report to stderr and exits 1."
  [project]
  (let [r (load-config project)]
    (if (:errors r)
      (do (write! *err* (errors-report "lgx.edn" (:errors r)))
          (os/exit 1))
      (:cfg r))))

;; Coord pairs come out of a map, and let-go's map iteration order is neither
;; insertion order nor stable across unrelated edits — it follows the bundle's
;; intern layout, so adding a keyword literal anywhere can reshuffle it. That
;; order is observable: it decides which of two conflicting sibling coords
;; first-wins keeps, and the precedence of dep source paths when two deps ship
;; the same namespace. Sorting by lib name makes both reproducible, at the cost
;; of not being the order written in lgx.edn (which the reader discards anyway).
(defn dep-pairs
  "Turn a lib→coord map into [lib coord] pairs ordered by lib name. Every
   coord map in lgx reaches the resolver through here, so ordering is one
   decision in one place."
  [m]
  (vec (sort-by (fn [[lib _]] (str lib)) m)))

(def ^:private sorted-pairs dep-pairs)

(defn coords
  "Return a vector of [lib coord] pairs from a loaded cfg map, ordered by lib
   name so resolution is reproducible (see sorted-pairs)."
  [cfg]
  (sorted-pairs (:deps cfg)))

(defn merge-coords
  "Merge a task's `extra-pairs` over `project-pairs` (both vectors of
   [lib coord]). An extra whose lib name matches a project coord replaces
   that coord in place (extra wins; position preserved). Extras with new lib
   names are appended after the project coords, in extra order. Returns a
   vector of [lib coord] pairs.

   The override is resolved here, before ensure-all!, so the merged list has
   each lib name at most once at the top level. That makes the
   extra-over-project override silent: ensure-all! only warns when a lib name
   reappears with a differing coord, which a deduped list never triggers."
  [project-pairs extra-pairs]
  (let [extra-map (into {} extra-pairs)
        project-map (into {} project-pairs)
        overridden (mapv (fn [[lib c]] [lib (get extra-map lib c)])
                         project-pairs)
        appended (vec (filter (fn [[lib _]] (not (contains? project-map lib)))
                              extra-pairs))]
    (vec (concat overridden appended))))

(defn context-overlay
  "Resolve an ordered list of context `names` against `contexts-map` into a
   single overlay {:deps-pairs [[lib coord] ...] :paths [path ...]
   :resource-paths [path ...]}.

   Deps from a later-named context win over an earlier one on a lib-name
   collision (last-wins, first position preserved) — produced by folding
   merge-coords from an empty base, which also dedupes the names so a later
   merge into the project never appends a duplicate. :extra-paths and
   :extra-resource-paths concatenate in name order (no dedup here; the caller
   dedupes the full path list).

   Throws ex-info {:lgx/unknown-context name :defined [...]} if a name is not a
   defined context. Pure: callers pass `config/contexts` output."
  [contexts-map names]
  (let [overlays (mapv (fn [nm]
                         (if (contains? contexts-map nm)
                           (get contexts-map nm)
                           (throw (ex-info (str "unknown context " nm)
                                           {:lgx/unknown-context nm
                                            :defined (vec (keys contexts-map))}))))
                       names)
        dep-lists (mapv (fn [o] (sorted-pairs (:extra-deps o))) overlays)
        deps-pairs (reduce merge-coords [] dep-lists)
        paths (vec (mapcat (fn [o] (or (:extra-paths o) [])) overlays))
        resource-paths (vec (mapcat (fn [o] (or (:extra-resource-paths o) []))
                                    overlays))]
    {:deps-pairs deps-pairs
     :paths paths
     :resource-paths resource-paths}))

(defn paths
  "Return the :paths vector from a loaded cfg map, or [] if absent."
  [cfg]
  (or (:paths cfg) []))

(defn resource-paths
  "Return the :resource-paths vector from a loaded cfg map, or [] if absent."
  [cfg]
  (or (:resource-paths cfg) []))

;; Read leniently: only the :deps coords are validated. A dep's other keys
;; (:paths, :main, :tasks, :targets) describe how to build that project, not
;; how to consume it — and a dep built with a newer lgx may carry top-level
;; keys this version doesn't know. The open :map (no :closed) encodes exactly
;; that.
(def ^:private dep-config-schema
  [:map [:deps {:optional true} deps-schema]])

(defn coords-at
  "Return [lib coord] pairs from an lgx.edn located in dir, or [] when the file
   is absent. Unlike the project's own lgx.edn, a missing file is not an
   error: most deps ship no lgx.edn, and only a dep's :deps matters for
   transitive resolution.

   On invalid content throws ex-info whose message is the rendered error
   report naming dir, with {:lgx/invalid-dep-config dir} in ex-data so the
   caller can print it and exit without a stack trace."
  [dir]
  (let [config-path (path/join dir config-name)]
    (if-not (file-exists? config-path)
      []
      (let [parsed (try
                     {:value (edn/read-string (slurp config-path))}
                     (catch e
                            {:error (first-line (ex-message e))}))
            errors (if (contains? parsed :error)
                     [{:path []
                       :msg (str "could not parse lgx.edn: " (:error parsed))}]
                     (spec/validate dep-config-schema (:value parsed)))]
        (if (seq errors)
          (throw (ex-info (errors-report (str "lgx.edn in " dir) errors)
                          {:lgx/invalid-dep-config dir}))
          (sorted-pairs (or (:deps (:value parsed)) {})))))))

;; ---------------------------------------------------------------------------
;; Declared deps from a dependency's own tools.deps / Leiningen metadata
;;
;; These files belong to third parties and were never written for lgx, so both
;; readers are best-effort and total: any missing file, parse failure, or
;; unexpected shape yields [] rather than an error. The alternative — failing a
;; user's build over a stranger's project.clj — is never the right trade. The
;; coord values come back verbatim and unvalidated; classify-declared decides
;; what each one means.
;; ---------------------------------------------------------------------------

(def deps-edn-name "deps.edn")
(def project-clj-name "project.clj")

(defn- read-first-form
  "Read the first form of the file at `p`, or nil if it is absent or the
   reader gives up."
  [p]
  (when (file-exists? p)
    (try
      (edn/read-string (slurp p))
      (catch _ nil))))

(defn declared-deps-at
  "Return [lib coord] pairs from a deps.edn in `dir` — its top-level :deps
   only. :aliases are ignored: an alias describes how to develop the dep, not
   what consuming it requires. Entries whose lib name is not a symbol are
   dropped. Returns [] for anything unexpected."
  [dir]
  (let [form (read-first-form (path/join dir deps-edn-name))
        deps (when (map? form) (:deps form))]
    (if-not (map? deps)
      []
      (sorted-pairs (filter (fn [[lib _]] (symbol? lib)) deps)))))

(defn- lein-dep->pair
  "Translate one Leiningen :dependencies entry into a [lib coord] pair, or nil
   when it does not match `[lib \"version\" & opts]`. Trailing options
   (:scope, :exclusions, …) are ignored — lgx has no use for them."
  [entry]
  (when (and (vector? entry)
             (>= (count entry) 2)
             (symbol? (nth entry 0))
             (string? (nth entry 1)))
    [(nth entry 0) {:mvn/version (nth entry 1)}]))

(defn project-clj-deps-at
  "Return [lib coord] pairs from a project.clj in `dir`, translating Leiningen
   `[lib \"1.2.3\"]` entries into `{:mvn/version \"1.2.3\"}` coords. Lib
   symbols are kept exactly as written — a bare `medley` stays `medley`, since
   guessing a group would only produce a name that matches nothing.

   Only the top-level :dependencies vector of a `(defproject …)` form is read,
   which is also what keeps :profiles dependencies out. Returns [] otherwise."
  [dir]
  (let [form (read-first-form (path/join dir project-clj-name))]
    (if-not (and (seq? form) (= 'defproject (first form)))
      []
      (let [items (vec form)
            deps (loop [i 0]
                   (cond
                     (>= i (count items)) nil
                     (= :dependencies (nth items i)) (nth items (inc i) nil)
                     :else (recur (inc i))))]
        (if-not (vector? deps)
          []
          (vec (keep lein-dep->pair deps)))))))

;; ---------------------------------------------------------------------------
;; Classifying one declared transitive dep
;; ---------------------------------------------------------------------------

;; Declared by nearly every Clojure lib and supplied by let-go itself, so
;; resolving these would be wrong, not merely wasteful.
(def ^:private skip-libs
  #{'org.clojure/clojure
    'org.clojure/spec.alpha
    'org.clojure/core.specs.alpha})

;; Lib-name groups whose owner is part of the coordinate itself, so the repo
;; URL is a fact rather than a guess. tools.deps reads them the same way.
(def ^:private github-group-prefixes ["io.github." "com.github."])

(defn inferred-git-url
  "The github.com URL implied by an `io.github.X/Y` or `com.github.X/Y` lib
   name, or nil for any other name. These groups name their owner in the
   coordinate itself, so the URL is certain rather than guessed — which is
   what makes it safe to probe for tags."
  [lib]
  (let [group (namespace lib)]
    (when group
      (first (keep (fn [prefix]
                     (when (and (str/starts-with? group prefix)
                                (> (count group) (count prefix)))
                       (str "https://github.com/"
                            (subs group (count prefix)) "/" (name lib))))
                   github-group-prefixes)))))

(defn- git-ref
  "The pinned ref in a declared coord. Accepts :sha alongside :git/sha —
   both spellings appear in real deps.edn files."
  [coord]
  (let [sha (or (:git/sha coord) (:sha coord))]
    (cond
      (string? sha) {:git/sha sha}
      (string? (:git/tag coord)) {:git/tag (:git/tag coord)}
      :else nil)))

(defn classify-declared
  "Decide what one declared transitive dep `[lib coord]` means to lgx.
   Returns a map whose :action is one of:

     :skip     — org.clojure/clojure and friends; let-go supplies these
     :resolve  — fully pinned; :coord is an lgx coord ready for the cache
     :mvn      — Maven-style; :version is the declared version string. The
                 registry lookup and tag probe are the caller's job, since
                 both need I/O
     :warn     — nothing usable here

   Pure. `coord` arrives verbatim from third-party metadata, so it may be any
   value at all, including nil."
  [lib coord]
  (let [ref (when (map? coord) (git-ref coord))
        url (when (map? coord)
              (if (string? (:git/url coord))
                (:git/url coord)
                (when ref (inferred-git-url lib))))]
    (cond
      (contains? skip-libs lib)
      {:action :skip}

      (not (map? coord))
      {:action :warn}

      ;; Blank is not merely useless: it resolves to the declaring dep's own
      ;; directory, which would pass that dep off as its own child.
      (and (string? (:local/root coord))
           (not (str/blank? (:local/root coord))))
      {:action :resolve
       :coord coord}

      (and url ref)
      {:action :resolve
       :coord (merge (dissoc coord :sha) {:git/url url} ref)}

      (string? (:mvn/version coord))
      {:action :mvn
       :version (:mvn/version coord)}

      :else
      {:action :warn})))

(defn without-exclusions
  "Drop the `declared` pairs whose lib symbol appears in `exclusions`. Matching
   is exact: an exclusion names a symbol as the dep writes it, so excluding
   `weavejester/dependency` says nothing about `dev.weavejester/dependency`."
  [exclusions declared]
  (if (empty? exclusions)
    (vec declared)
    (let [excluded (set exclusions)]
      (vec (filter (fn [[lib _]] (not (contains? excluded lib))) declared)))))

;; ---------------------------------------------------------------------------
;; Suppression: does a declared dep look like something already resolved?
;; ---------------------------------------------------------------------------

(defn- normalize-git-url
  "Strip the parts of a git URL that carry no identity — a trailing slash and
   a trailing .git — so the same repo written two ways compares equal."
  [url]
  (loop [u (str/trim url)]
    (cond
      (str/ends-with? u "/") (recur (subs u 0 (dec (count u))))
      (str/ends-with? u ".git") (recur (subs u 0 (- (count u) 4)))
      :else u)))

(defn unresolved-declared
  "Return the subset of `pending` warning entries whose declared dep does not
   already look resolved. `resolved` maps lib symbol → coord (ensure-all!'s
   seen map); each pending entry carries `:declared [lib coord]`.

   Matching is tiered by the identity a declaration actually carries:
   a git URL (explicit or inferred from the lib name) compares by normalized
   URL, which is exact; everything else compares by lib symbol, then by
   artifact segment, so a dep declaring `weavejester/dependency` stays quiet
   when the user pinned `dev.weavejester/dependency`.

   This is a heuristic, and deliberately only ever silences a warning — it
   never decides whether something gets resolved."
  [resolved pending]
  (let [urls (set (keep (fn [[_ c]]
                          (when (string? (:git/url c))
                            (normalize-git-url (:git/url c))))
                        resolved))
        libs (set (keys resolved))
        artifacts (set (map name (keys resolved)))]
    (vec (filter
           (fn [entry]
             (let [[lib coord] (:declared entry)
                   url (when (map? coord)
                         (or (:git/url coord) (inferred-git-url lib)))]
               (if (string? url)
                 (not (contains? urls (normalize-git-url url)))
                 (not (or (contains? libs lib)
                          (contains? artifacts (name lib)))))))
           pending))))

(defn tasks
  "Return the :tasks map from a loaded cfg map, or {} if absent."
  [cfg]
  (or (:tasks cfg) {}))

(defn contexts
  "Return the :contexts map from a loaded cfg map, or {} if absent."
  [cfg]
  (or (:contexts cfg) {}))

(defn auto-context
  "Return [name] when `name` is a defined context in cfg, else []. Convention
   contexts: run/nrepl auto-apply :dev, test auto-applies :test. Callers
   prepend the result to the CLI --with list, so an explicit --with context
   wins over the auto one on a lib-name collision (last-wins)."
  [cfg name]
  (if (contains? (contexts cfg) name) [name] []))

(defn main
  "Return the :main entrypoint string from a loaded cfg map, or nil if absent."
  [cfg]
  (:main cfg))

(defn lg-version
  "Return the :lg-version pin from a loaded cfg map, or nil if absent."
  [cfg]
  (:lg-version cfg))

(defn targets
  "Return the :targets map from a loaded cfg map, or {} if absent."
  [cfg]
  (or (:targets cfg) {}))
