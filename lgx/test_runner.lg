(ns lgx.test-runner
  (:require [lgx.home :as home]
            [lgx.path :as path]
            [string :as str]))

(def ^:private harness-prefix "lgx-test-")

;; The harness writes this marker to *err* at the end of its load phase,
;; once it has tried to require every test namespace. It marks the boundary
;; in lg's captured stderr between lg's pre-harness load diagnostics and any
;; stderr the tests themselves emit. No regex metacharacters, so it is safe
;; as a str/split separator.
(def harness-ready-marker "<<<lgx-test-harness-ready>>>")

(defn- test-file? [name]
  (or (str/ends-with? name "_test.lg")
      (str/ends-with? name "_test.cljc")
      (str/ends-with? name "_test.clj")))

(defn- walk* [dir]
  (reduce
    (fn [acc name]
      (let [abs (path/join dir name)
            stat (os/stat abs)]
        (cond
          (nil? stat) acc
          (:dir? stat) (vec (concat acc (walk* abs)))
          (test-file? name) (conj acc abs)
          :else acc)))
    []
    (os/ls dir)))

(defn discover-test-files
  "Walk test-dir recursively for *_test.lg / *_test.cljc files.
   Returns a sorted vector of absolute paths.
   Throws ex-info (:reason :missing-dir) if test-dir does not exist
   or is not a directory."
  [test-dir]
  (let [s (os/stat test-dir)]
    (when (or (nil? s) (not (:dir? s)))
      (throw (ex-info (str "test directory not found: " test-dir)
                      {:reason :missing-dir
                       :dir test-dir}))))
  (vec (sort (walk* test-dir))))

(defn- strip-ext [s]
  (cond
    (str/ends-with? s ".lg") (subs s 0 (- (count s) 3))
    (str/ends-with? s ".cljc") (subs s 0 (- (count s) 5))
    (str/ends-with? s ".clj") (subs s 0 (- (count s) 4))
    :else s))

(defn- relative-test-path [test-dir abs-path]
  (let [sep os/file-separator
        prefix (str test-dir sep)]
    (if (str/starts-with? abs-path prefix)
      (subs abs-path (count prefix))
      abs-path)))

(defn path->ns
  "Convert a test file path to its namespace symbol.
   test-dir is the directory the file was discovered under; abs-path is
   the file path returned by discover-test-files (or any path that
   begins with test-dir/).

   test/foo_test.lg          -> 'foo-test
   test/lgx/config_test.lg   -> 'lgx.config-test
   test/foo_test.cljc        -> 'foo-test"
  [test-dir abs-path]
  (let [sep os/file-separator
        rel (relative-test-path test-dir abs-path)
        bare (strip-ext rel)
        segments (str/split bare sep)
        hyphenated (map #(str/replace % "_" "-") segments)]
    (symbol (str/join "." hyphenated))))

(defn test-entry
  "Return the harness entry for abs-path: [display-file ns-symbol]."
  [test-dir abs-path]
  [(path/join "test" (relative-test-path test-dir abs-path))
   (path->ns test-dir abs-path)])

(defn exclude-entries
  "Apply `--exclude` to a test plan. entries are [display-file ns-symbol]
   pairs from test-entry; excluded are the ns symbols to skip. Returns
   {:entries [kept entries, original order]
    :unmatched [excluded syms that matched no entry, original order]}.
   Matching is = on the entry's ns symbol; a duplicated name matches once
   and is never unmatched."
  [entries excluded]
  (let [discovered (set (map second entries))
        skip (set excluded)]
    {:entries (vec (filter (fn [[_ ns-sym]] (not (contains? skip ns-sym)))
                           entries))
     :unmatched (vec (filter (fn [ns-sym] (not (contains? discovered ns-sym)))
                             excluded))}))

(defn- has-test-extension? [p]
  (or (str/ends-with? p ".lg")
      (str/ends-with? p ".cljc")
      (str/ends-with? p ".clj")))

(defn validate-single-test-file!
  "Resolve user-path against project-root, stat the file, check its
   extension and containment under test-dir. Returns the absolute path
   on success; otherwise throws ex-info whose data has a :reason key
   in #{:not-found :bad-extension :outside-test-dir} and :path holding
   the original user-path."
  [test-dir user-path project-root]
  (let [joined (if (path/absolute? user-path)
                 user-path
                 (path/join project-root user-path))
        abs (path/normalize joined)
        stat (os/stat abs)]
    (when (or (nil? stat) (:dir? stat))
      (throw (ex-info (str "test file not found: " user-path)
                      {:reason :not-found
                       :path user-path})))
    (when-not (has-test-extension? abs)
      (throw (ex-info (str "not a test file: " user-path)
                      {:reason :bad-extension
                       :path user-path})))
    (let [test-prefix (str (path/normalize test-dir) os/file-separator)]
      (when-not (str/starts-with? abs test-prefix)
        (throw (ex-info (str "test file must be under test/: " user-path)
                        {:reason :outside-test-dir
                         :path user-path}))))
    abs))

;; ---------------------------------------------------------------------------
;; Harness generation
;;
;; lgx ships as a bundled binary, so the test harness can't live as static
;; .lg files on the user's filesystem. Instead, we generate a small directory
;; of .lg sources from the discovered test entries under $LGX_HOME and hand
;; its entry script to `lg` like any other script, with the directory on the
;; source path so the entry can `require` the rest.
;;
;; The directory holds one entry script plus three namespaces:
;;
;;   harness.lg                  lgx.test-harness: the plan, the load phase,
;;                               the ready marker, the dispatch, the summary
;;   lgx/test_harness/ui.lg      shared printing helpers
;;   lgx/test_harness/legacy.lg  run phase over the pre-#863 test internals
;;   lgx/test_harness/report.lg  run phase over the clojure.test port
;;
;; Two run-phase variants exist because let-go #863 replaced the `test`
;; internals the original loop read (*registered-tests*, printed PASS/FAIL
;; lines) with a clojure.test port, and a dead branch still has to compile:
;; let-go rejects any symbol the running version lacks, even one it would
;; never execute. So each variant is its own namespace, the entry picks one
;; with `resolve` and loads it with a run-time `require`, and only that one
;; is ever compiled. Both expose (run! plan) -> {:test :pass :fail :error}.
;; Delete legacy.lg and the dispatch once lgx's minimum lg carries #863.
;; ---------------------------------------------------------------------------

(defn- entry-line [entry]
  (str "  [" (pr-str (first entry)) " '" (second entry) "]"))

(def ^:private ui-source
  (str
    "(ns lgx.test-harness.ui\n"
    "  (:require [string :as str]))\n"
    "\n"
    ";; Printing helpers shared by the run-phase variants. Color is inline\n"
    ";; because this file runs under the user's lg and cannot require\n"
    ";; lgx.style.\n"
    "\n"
    "(defn- color [code s]\n"
    "  (str \"\\u001b[38;5;\" code \"m\" s \"\\u001b[0m\"))\n"
    "\n"
    "(defn green [s] (color 35 s))\n"
    "(defn red   [s] (color 1 s))\n"
    "\n"
    "(def pass-mark (green \"\\u2713\"))\n"
    "(def fail-mark (red \"\\u2717\"))\n"
    "\n"
    "(defn nonblank-lines [s]\n"
    "  (filter #(not (str/blank? %)) (str/split s \"\\n\")))\n"
    "\n"
    "(defn var-name [tv]\n"
    "  ;; let-go vars print as #'<ns>/<name>; pull the last segment.\n"
    "  (last (str/split (str tv) \"/\")))\n"
    "\n"
    "(defn print-file [file-name] (println file-name))\n"
    "(defn print-mark [failed? name]\n"
    "  (println (str \"  \" (if failed? fail-mark pass-mark) \" \" name)))\n"
    "(defn print-context [ctx] (println (str \"    \" ctx)))\n"
    "(defn print-detail [line] (println (str \"    \" line)))\n"))

;; The run loop as it was before the split, over the pre-#863 internals:
;; *registered-tests* lists each namespace's deftest vars, `is` prints
;; `PASS <form>` / `FAIL <form> - <msg>` and `testing` prints `Testing: a > b`,
;; so the loop captures stdout per var and reads those lines back.
(def ^:private legacy-source
  (str
    "(ns lgx.test-harness.legacy\n"
    "  (:require [test :refer [*registered-tests* *report-counters*\n"
    "                          *each-fixtures*]]\n"
    "            [lgx.test-harness.ui :as ui]\n"
    "            [string :as str]))\n"
    "\n"
    "(defn- compose-fixtures [f g] (fn [t] (f (fn [] (g t)))))\n"
    "(defn- default-fixture [t] (t))\n"
    "(defn- join-fixtures [fs]\n"
    "  (reduce compose-fixtures default-fixture fs))\n"
    "\n"
    "(defn- testing-line? [line]\n"
    "  (str/starts-with? line \"Testing: \"))\n"
    "\n"
    "(defn- pass-line? [line]\n"
    "  (str/starts-with? line \"PASS \"))\n"
    "\n"
    "(defn- print-testing-line [line]\n"
    "  (ui/print-context (subs line (count \"Testing: \"))))\n"
    "\n"
    "(defn- color-fail-token [line]\n"
    "  (cond\n"
    "    (= line \"FAIL\") (ui/red \"FAIL\")\n"
    "    (str/starts-with? line \"FAIL \") (str (ui/red \"FAIL\")\n"
    "                                       (subs line (count \"FAIL\")))\n"
    "    :else line))\n"
    "\n"
    "(defn- print-detail-line [line]\n"
    "  (when (and (not (testing-line? line)) (not (pass-line? line)))\n"
    "    (ui/print-detail (color-fail-token line))))\n"
    "\n"
    "(defn run!\n"
    "  \"Run every entry of `plan` ([display-file ns-sym] pairs whose ns\n"
    "   loaded). Returns {:test :pass :fail :error}.\"\n"
    "  [plan]\n"
    "  (doseq [entry plan]\n"
    "    (let [file-name (first entry)\n"
    "          ns-sym (second entry)\n"
    "          test-vars (get *registered-tests* (the-ns ns-sym) [])]\n"
    "      (ui/print-file file-name)\n"
    "      (doseq [tv test-vars]\n"
    "        (set! *report-counters* (update *report-counters* :test inc))\n"
    "        (let [before *report-counters*]\n"
    "          (let [result (try\n"
    "                         {:out (with-out-str\n"
    "                                 ((join-fixtures *each-fixtures*)\n"
    "                                  (fn [] ((deref tv)))))\n"
    "                          :error nil}\n"
    "                         (catch e\n"
    "                           (set! *report-counters*\n"
    "                                 (update *report-counters* :error inc))\n"
    "                           {:out \"\" :error e}))\n"
    "                after *report-counters*\n"
    "                lines (ui/nonblank-lines (:out result))\n"
    "                failed? (or (> (:fail  after) (:fail  before))\n"
    "                            (> (:error after) (:error before)))]\n"
    "            (ui/print-mark failed? (ui/var-name tv))\n"
    "            (doseq [line lines]\n"
    "              (when (testing-line? line)\n"
    "                (print-testing-line line)))\n"
    "            (when failed?\n"
    "              (doseq [line lines]\n"
    "                (print-detail-line line))\n"
    "              (when (:error result)\n"
    "                (ui/print-detail (str \"ERROR: \" (:error result))))))))\n"
    "      (println)))\n"
    "  *report-counters*)\n"))

;; The run loop over let-go's clojure.test port (#863). Filled in by the
;; next change; until then the dispatch reaching it is a loud failure.
(def ^:private report-source
  (str
    "(ns lgx.test-harness.report\n"
    "  (:require [lgx.test-harness.ui :as ui]))\n"
    "\n"
    "(defn run!\n"
    "  \"Run every entry of `plan` ([display-file ns-sym] pairs whose ns\n"
    "   loaded). Returns {:test :pass :fail :error}.\"\n"
    "  [plan]\n"
    "  (doseq [entry plan] (the-ns (second entry)))\n"
    "  (throw (ex-info \"clojure.test path not implemented\" {})))\n"))

(def ^:private entry-header
  (str "(ns lgx.test-harness\n"
       "  (:require [string :as str]\n"
       "            [os :as os]))"))

(def ^:private entry-body
  (str
    "\n\n"
    "(def test-plan\n"
    "  [\n"
    "__TEST_ENTRIES__\n"
    "  ])\n"
    "\n"
    ;; Load phase: require the test namespaces one at a time, inside a
    ;; try, so a file that fails to load costs one reported failure
    ;; instead of the whole run. Collects [display-file ns-sym message].
    ;; Nothing is printed here — the report comes after the marker, so it
    ;; is never mistaken for a pre-harness load diagnostic.
    "(def load-failures\n"
    "  (reduce\n"
    "    (fn [acc entry]\n"
    "      (try (require (second entry))\n"
    "           acc\n"
    "           (catch e\n"
    "             (conj acc\n"
    "                   [(first entry) (second entry) (ex-message e)]))))\n"
    "    []\n"
    "    test-plan))\n"
    "\n"
    ;; Emit the ready marker once the load phase has run to completion.
    ;; Everything lg printed to stderr before this point is a load
    ;; diagnostic; everything after is test output.
    "(write! *err* \"" harness-ready-marker "\\n\")\n\n"
    "(defn- color [code s]\n"
    "  (str \"\\u001b[38;5;\" code \"m\" s \"\\u001b[0m\"))\n"
    "\n"
    "(defn- green [s] (color 35 s))\n"
    "(defn- red   [s] (color 1 s))\n"
    "\n"
    "(defn- nonblank-lines [s]\n"
    "  (filter #(not (str/blank? %)) (str/split s \"\\n\")))\n"
    "\n"
    "(def failed-namespaces (set (map second load-failures)))\n"
    "\n"
    "(def runnable-plan\n"
    "  (filter #(not (contains? failed-namespaces (second %))) test-plan))\n"
    "\n"
    ;; Report every namespace that would not load, once, before any test
    ;; output. the-ns throws for a namespace lg never published, so the run
    ;; phase below sees only the entries that loaded.
    "(doseq [failure load-failures]\n"
    "  (println (first failure))\n"
    "  (println (str \"  \" (red \"\\u2717\") \" failed to load\"))\n"
    "  (doseq [line (nonblank-lines (last failure))]\n"
    "    (println (str \"    \" (str/trim line))))\n"
    "  (println))\n"
    "\n"
    ;; Two run-phase variants, chosen at run time: let-go #863 replaced the
    ;; test internals the legacy loop reads, and a dead branch still has to
    ;; compile, so each variant is its own namespace and only one is loaded.
    ;; test-ns is the clojure.test port's runner entry point and did not
    ;; exist before it. The var is looked up by resolve for the same reason:
    ;; naming it as a symbol would try to resolve it at compile time.
    ;; Delete legacy + this dispatch once lgx's minimum lg carries #863.
    "(def run-var\n"
    "  (if (resolve 'test/test-ns)\n"
    "    (do (require 'lgx.test-harness.report) 'lgx.test-harness.report/run!)\n"
    "    (do (require 'lgx.test-harness.legacy) 'lgx.test-harness.legacy/run!)))\n"
    "\n"
    "(def counters ((var-get (resolve run-var)) runnable-plan))\n"
    "\n"
    ;; A load failure is not a failed assertion, so it is counted on its
    ;; own rather than folded into the assertion totals. The summary colour,
    ;; the OK/FAIL line and the exit code all read failed?, so a run cannot
    ;; print a green OK and still exit 1.
    "(let [c counters\n"
    "      asserts (+ (:pass c) (:fail c))\n"
    "      failures (+ (:fail c) (:error c))\n"
    "      load-count (count load-failures)\n"
    "      failed? (or (pos? failures) (seq load-failures))\n"
    "      summary (str (:test c) \" tests, \" asserts \" assertions, \"\n"
    "                   failures \" failures\"\n"
    "                   (if (pos? load-count)\n"
    "                     (str \", \" load-count \" load failures\")\n"
    "                     \"\"))]\n"
    "  (println ((if failed? red green) summary))\n"
    "  (println (if failed? \"FAIL\" \"OK\"))\n"
    "  (os/exit (if failed? 1 0)))\n"))

(def entry-file "harness.lg")
(def ui-file (path/join "lgx" "test_harness" "ui.lg"))
(def legacy-file (path/join "lgx" "test_harness" "legacy.lg"))
(def report-file (path/join "lgx" "test_harness" "report.lg"))

(defn harness-sources
  "Return {relative-path source} for the harness directory: the entry
   script, which loads each test entry in turn, reports the ones that fail
   to load, hands the rest to the run-phase variant the running lg
   supports, and prints the summary; and the three namespaces the entry
   requires (see the section comment above). The `Running tests in ...`
   banner is printed by lgx (green, on stderr), not the harness."
  [entries]
  (let [entry-src (str/join "\n" (map entry-line entries))
        body (str/replace entry-body "__TEST_ENTRIES__" entry-src)]
    {entry-file (str entry-header body)
     ui-file ui-source
     legacy-file legacy-source
     report-file report-source}))

(defn harness-dir
  "The per-lgx-version harness directory under LGX_HOME/test-runner."
  [version]
  (path/join (home/test-runner-dir) (str harness-prefix version)))

(defn write-harness!
  "Materialize the harness directory for entries under LGX_HOME/test-runner,
   overwriting the previous harness for the same lgx version.
   Returns {:dir <absolute directory, for -source-paths>
            :entry <absolute path of the entry script>}."
  [entries version]
  (let [dir (harness-dir version)]
    (mkdir (path/join dir "lgx" "test_harness"))
    (doseq [[rel src] (harness-sources entries)]
      (spit (path/join dir rel) src))
    {:dir dir
     :entry (path/join dir entry-file)}))

;; ---------------------------------------------------------------------------
;; Swallowed load-error detection
;;
;; This covers the load failure the harness cannot see for itself. Through
;; lg 1.11.x `require` swallows a test file's compile error: it prints
;; `error: failed to load <path>: CompileError ...` to stderr, does not throw
;; and exits 0, so the harness's try never fires and the run would otherwise
;; be reported as 0 tests / 0 failures and pass silently. (From 1.12.x
;; `require` throws, the harness catches it in its load phase, and it is the
;; harness that names the file.) The harness writes harness-ready-marker to
;; stderr at the end of that load phase, so the captured stderr splits
;; cleanly into lg's pre-harness load diagnostics (before the marker) and
;; test-emitted stderr (after it). We only inspect the former.
;; ---------------------------------------------------------------------------

(defn strip-ready-marker
  "Remove the harness-ready marker line from lg's captured stderr so it
   never reaches the user. nil-safe."
  [err]
  (when (some? err)
    (str/replace err (str harness-ready-marker "\n") "")))

(defn harness-ready?
  "True if the harness's load phase ran to completion, i.e. it tried every
   test namespace and got as far as writing the marker. It does NOT mean every
   require succeeded — the harness catches and reports those itself.

   This is the version-independent half of load-failure detection. let-go
   changed behaviour here: through 1.11.x `require` swallowed a test file's
   compile error and carried on, so the harness still ran and the only trace
   was a diagnostic line on stderr; from 1.12.x it throws, which the load phase
   now catches. What is left for this function is the load failure no `catch`
   can reach — the harness itself, or one of its own dependencies, failing to
   load, so the process dies before the marker and there is no
   `error: failed to load` line to match either. Asking whether the marker
   arrived covers that without depending on lg's wording. nil-safe."
  [err]
  (and (some? err) (str/includes? err harness-ready-marker)))

(defn- lg-load-error-line?
  "True if `line` is one of lg's loader diagnostics. lg emits them as
   `error: failed to load <path>: <diagnostic>` for every load failure —
   CompileError, ExecutionError, and `Syntax error reading source` alike —
   where <path> is the source file it was loading. We key off that
   invariant structure (line starts with the phrase AND names a
   `.lg:`/`.cljc:`/`.clj:` source file) rather than the varying diagnostic
   text, so no failure type is missed. The source-file token plus the
   line-start anchor also keep arbitrary user stderr that merely mentions
   the phrase — even at load time, before the marker — from matching.

   lg 1.12 reports a swallowed *reader* failure without the wrapper, as
   `error: Syntax error reading source at (<file>:L:C).`, so that shape counts
   too. Both forms still have to name a source file to match."
  [line]
  (and (or (str/starts-with? line "error: failed to load ")
           (str/starts-with? line "error: Syntax error reading source at "))
       (or (str/includes? line ".lg:")
           (str/includes? line ".cljc:")
           (str/includes? line ".clj:"))))

(defn load-error-before-harness?
  "True if lg reported a swallowed load failure BEFORE the harness body
   started — i.e. a test file (or something it requires) failed to load.
   Two filters keep genuine test output from counting: only stderr
   preceding harness-ready-marker is inspected (so stderr the tests emit
   during execution is ignored), and each line must match lg's specific
   diagnostic shape (so user stderr that merely mentions the phrase, even
   from a top-level form during load, is ignored). nil-safe.

   Known limitation: lg has no userspace load-status API (require swallows
   source compile errors and find-ns still returns the registered ns), so
   detection must read lg's stderr — and lg writes loader diagnostics to
   the same stderr/phase as a test's own top-level code. A test that
   deliberately writes a line matching lg's exact loader shape from a
   top-level form would thus be misread as a failure. This is adversarial
   and fails loud (a spurious failure, never a silent pass), so it is
   accepted rather than chased with an ever-stricter string match."
  [err]
  (if (some? err)
    (let [prefix (first (str/split err harness-ready-marker))]
      (if (some lg-load-error-line? (str/split prefix "\n")) true false))
    false))
