;; Version compatibility between the :lg-version pin and the installed lg.

(ns lgx.version
  (:require [lgx.runner :as runner]))

(defn installed
  "The version token from `lg -v` (e.g. \"1.10.0\"), or nil when lg is absent or
   the output is unparseable. Probes the same lg lgx invokes (honoring LGX_LG).
   Thin alias for runner/lg-version, kept for the version-check call sites."
  []
  (runner/lg-version))

(defn check
  "Pure decision comparing the pinned version to the installed one: :ok on exact
   match, :skip when the installed version is unknown or a dev build, :mismatch
   otherwise."
  [pinned installed]
  (cond
    (or (nil? installed) (= installed "dev")) :skip
    (= pinned installed) :ok
    :else :mismatch))
