(ns lgx.new
  (:require [lgx.cache :as cache]
            [lgx.cli :as cli]
            [lgx.config :as config]
            [lgx.home :as home]
            [lgx.path :as path]
            [lgx.style :as style]
            [string :as str]))

;; ---------------------------------------------------------------------------
;; Constants
;; ---------------------------------------------------------------------------

(def ^:private placeholder "projectname")

(def ^:private name-pattern #"^[a-z][a-z0-9-]*$")

(def templates
  "Built-in template registry: name -> {:git/url ...}. Always resolved to the
   repo's default-branch HEAD unless --sha is given. \"base\" is the default
   when `lgx new` gets no -t/--template flag."
  {"base" {:git/url "https://github.com/abogoyavlensky/lgx-template-base"}
   "cli" {:git/url "https://github.com/abogoyavlensky/lgx-template-cli"}
   "desktop" {:git/url "https://github.com/abogoyavlensky/lgx-template-desktop"}
   "lib" {:git/url "https://github.com/abogoyavlensky/lgx-template-lib"}
   "web" {:git/url "https://github.com/abogoyavlensky/lgx-template-web"}})

(def ^:private sha-pattern #"^[0-9a-f]{7,40}$")

(def ^:private cached-sha-pattern #"^[0-9a-f]{40}$")

;; ---------------------------------------------------------------------------
;; Validation
;; ---------------------------------------------------------------------------

(defn valid-name?
  "Return true if name is a non-blank string matching ^[a-z][a-z0-9-]*$."
  [name]
  (and (string? name)
       (not (nil? (re-matches name-pattern name)))))

(defn validate-name!
  "Return name on success. Throw ex-info with :reason :invalid-name and
   :name <input> otherwise."
  [name]
  (when-not (valid-name? name)
    (throw (ex-info (str "invalid project name: " name)
                    {:reason :invalid-name
                     :name name})))
  name)

(defn validate-target!
  "Return target on success. Throws ex-info if target exists and is either
   a regular file (:reason :not-a-dir) or a non-empty directory
   (:reason :non-empty). Both branches set :path to the input."
  [target]
  (let [stat (os/stat target)]
    (cond
      (nil? stat)
      target

      (not (:dir? stat))
      (throw (ex-info (str "target exists and is not a directory: " target)
                      {:reason :not-a-dir
                       :path target}))

      (seq (os/ls target))
      (throw (ex-info (str "target directory already exists and is not empty: " target)
                      {:reason :non-empty
                       :path target}))

      :else
      target)))

(defn valid-sha?
  "True iff s is a string of 7-40 lowercase hex characters."
  [s]
  (and (string? s)
       (not (nil? (re-matches sha-pattern s)))))

(defn validate-sha!
  "Return sha on success. Throw ex-info with :reason :invalid-sha otherwise."
  [sha]
  (when-not (valid-sha? sha)
    (throw (ex-info (str "invalid --sha value: " sha
                         " (expected 7-40 lowercase hex characters)")
                    {:reason :invalid-sha
                     :sha sha})))
  sha)

;; ---------------------------------------------------------------------------
;; Substitution
;; ---------------------------------------------------------------------------

(defn name-pair
  "Return {:hyphen <name as-is> :underscore <name with - -> _>} for use as
   the substitution table for paths and contents."
  [name]
  {:hyphen name
   :underscore (str/replace name "-" "_")})

(defn substitute-contents
  "Replace every literal `projectname` in s with the hyphenated form from
   the name-pair."
  [s pair]
  (str/replace s placeholder (:hyphen pair)))

(defn substitute-path-segments
  "Split rel-path on `/`, replace every literal `projectname` segment with
   the underscored form from the name-pair, rejoin with `/`. Relative paths
   stored internally always use `/` separators; absolute paths are produced
   only via path/join."
  [rel-path pair]
  (let [segments (str/split rel-path "/")
        replaced (map #(str/replace % placeholder (:underscore pair)) segments)]
    (str/join "/" replaced)))

;; ---------------------------------------------------------------------------
;; Template cache
;; ---------------------------------------------------------------------------

(defn template-url
  "Resolve the -t/--template value to a git URL. nil or \"base\" is the base
   built-in; a value containing :// is a custom URL, passed through; anything
   else is a registry name, and unknown names throw ex-info (prefix-free
   message, printed by the caller via die!)."
  [template]
  (cond
    (or (nil? template) (= template "base"))
    (:git/url (get templates "base"))

    (str/includes? template "://")
    template

    :else
    (if-let [coord (get templates template)]
      (:git/url coord)
      (throw (ex-info (str "unknown template: " template
                           " (built-in: "
                           (str/join ", " (sort (keys templates)))
                           ")")
                      {:template template})))))

(defn resolve-template-coord
  "Resolve the -t/--template value and optional --sha to a git coord
   {:git/url :git/sha}. With a sha it is returned as given (possibly
   abbreviated) and no network call is made. Without one, the default-branch
   HEAD is resolved via git ls-remote; failures throw ex-info with a
   prefix-free message."
  [template sha]
  (let [url (template-url template)]
    {:git/url url
     :git/sha (or sha
                  (try (cache/resolve-head-sha! url)
                       (catch e
                              (throw (ex-info (str "failed to resolve template "
                                                   url ": "
                                                   (or (:stderr (ex-data e))
                                                       (ex-message e)))
                                              {:url url})))))}))

(defn- templates-root []
  (home/templates-dir))

(defn- template-repo-dir [url]
  (let [[host owner repo] (cache/parse-git-url url)]
    (path/join (templates-root) host owner repo)))

(defn find-cached-sha
  "Return the absolute path of the single entry in repo-dir whose name is a
   40-char lowercase hex sha starting with prefix, or nil when there are zero
   or several matches, or repo-dir does not exist."
  [repo-dir prefix]
  (when (file-exists? repo-dir)
    (let [matches (filter #(and (re-matches cached-sha-pattern %)
                                (str/starts-with? % prefix))
                          (os/ls repo-dir))]
      (when (= 1 (count matches))
        (path/join repo-dir (first matches))))))

(defn ensure-template!
  "Return the absolute path of the cached template worktree, keyed by full
   sha. coord's :git/sha may be abbreviated: a unique cached match is reused
   offline, otherwise cache/clone-commit! clones and resolves it (throwing
   :reason :sha-not-found for an unknown commit)."
  [coord]
  (let [url (:git/url coord)
        sha (:git/sha coord)
        repo-dir (template-repo-dir url)]
    (or (find-cached-sha repo-dir sha)
        (cache/clone-commit! url sha repo-dir))))

;; ---------------------------------------------------------------------------
;; Render
;; ---------------------------------------------------------------------------

(defn- walk* [dir]
  (reduce
    (fn [acc name]
      (let [abs (path/join dir name)
            stat (os/stat abs)]
        (cond
          (nil? stat) acc
          (:dir? stat) (vec (concat acc (walk* abs)))
          :else (conj acc abs))))
    []
    (os/ls dir)))

(defn walk-template
  "Recursively walk root and return a sorted vector of absolute file paths."
  [root]
  (vec (sort (walk* root))))

(defn- relative-to [root abs]
  (let [prefix (str root os/file-separator)]
    (if (str/starts-with? abs prefix)
      (subs abs (count prefix))
      abs)))

(defn render!
  "For each file under src, compute the destination path under target by
   replacing `projectname` segments with the underscored form, mkdir its
   parent, slurp the source, replace `projectname` in the contents with the
   hyphenated form, and spit to the destination."
  [src target pair]
  (mkdir target)
  (doseq [abs (walk-template src)]
    (let [rel (relative-to src abs)
          rel-sep (str/replace rel os/file-separator "/")
          dst-rel (substitute-path-segments rel-sep pair)
          dst-abs (path/join target dst-rel)
          parent (path/parent dst-abs)]
      (when parent (mkdir parent))
      (spit dst-abs (substitute-contents (slurp abs) pair)))))

;; ---------------------------------------------------------------------------
;; Command entry
;; ---------------------------------------------------------------------------

(defn next-step-command
  "Return the post-scaffold command to suggest for a loaded config map:
   `lgx run` when the project declares a :main entrypoint, else `lgx test`.
   A library scaffold (no :main) has nothing to run, and its first payoff is a
   passing test. Keys off the same :main signal `lgx run` itself uses, so the
   suggestion can't contradict the tool's behavior. nil cfg falls back to test."
  [cfg]
  (if (:main cfg)
    "lgx run"
    "lgx test"))

(defn- die! [line]
  (write! *err* (str "lgx: " line "\n"))
  (os/exit 1))

(defn- die-name-invalid! [name]
  (write! *err* (str "lgx: invalid project name: " name "\n"))
  (write! *err* (str "name must start with a letter and contain only "
                     "lowercase letters, digits, and hyphens\n"))
  (os/exit 1))

(defn- handle-target-error! [e]
  (let [{:keys [reason path]} (ex-data e)]
    (case reason
      :not-a-dir
      (die! (str "target exists and is not a directory: " path))

      :non-empty
      (die! (str "target directory already exists and is not empty: " path))

      (die! (str "target invalid: " path)))))

(defn cmd-new!
  "Scaffold a new let-go project at <project-name> under cwd. args is the
   forwarded rest-args vector (project name plus optional -t/--template)."
  [args _verbose?]
  (let [{:keys [name template]}
        (try (cli/parse-new-args (vec args))
             ;; Parse messages already carry the `lgx: ` prefix; die! would
             ;; double it.
             (catch e
                    (write! *err* (str (ex-message e) "\n"))
               (os/exit 1)))]
    (try (validate-name! name)
         (catch _ (die-name-invalid! name)))
    (let [target (path/join (os/cwd) name)]
      (try (validate-target! target)
           (catch e (handle-target-error! e)))
      (write! *err*
              (str (style/header (str "Creating project " name "...")) "\n"))
      (let [coord (try (resolve-template-coord template nil)
                       (catch e (die! (ex-message e))))
            cache-path (try (ensure-template! coord)
                            (catch e
                                   (die! (str "failed to fetch template: "
                                              (or (:stderr (ex-data e))
                                                  (str e))))))]
        (try (render! cache-path target (name-pair name))
             (catch e
                    (die! (str "failed to render template: " (str e)))))
        (println (str "Created " name " at " target))
        (println)
        (println "Next steps:")
        (println (str "  cd " name))
        (println (str "  " (next-step-command (:cfg (config/load-config target)))))))))
