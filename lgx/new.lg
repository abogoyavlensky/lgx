(ns lgx.new
  (:require [string :as str]))

(def ^:private placeholder "projectname")

(def ^:private name-pattern #"^[a-z][a-z0-9-]*$")

(defn valid-name?
  "Return true if name is a non-blank string matching ^[a-z][a-z0-9-]*$."
  [name]
  (and (string? name)
       (not (nil? (re-matches name-pattern name)))))

(defn validate-name!
  "Return name on success. Throw ex-info with :reason :invalid-name and
   :name <input> otherwise."
  [name]
  (when-not (valid-name? name)
    (throw (ex-info (str "invalid project name: " name)
                    {:reason :invalid-name
                     :name name})))
  name)

(defn name-pair
  "Return {:hyphen <name as-is> :underscore <name with - -> _>} for use as
   the substitution table for paths and contents."
  [name]
  {:hyphen name
   :underscore (str/replace name "-" "_")})

(defn substitute-contents
  "Replace every literal `projectname` in s with the hyphenated form from
   the name-pair."
  [s pair]
  (str/replace s placeholder (:hyphen pair)))

(defn validate-target!
  "Return target on success. Throws ex-info if target exists and is either
   a regular file (:reason :not-a-dir) or a non-empty directory
   (:reason :non-empty). Both branches set :path to the input."
  [target]
  (let [stat (os/stat target)]
    (cond
      (nil? stat)
      target

      (not (:dir? stat))
      (throw (ex-info (str "target exists and is not a directory: " target)
                      {:reason :not-a-dir
                       :path target}))

      (seq (os/ls target))
      (throw (ex-info (str "target directory already exists and is not empty: " target)
                      {:reason :non-empty
                       :path target}))

      :else
      target)))

(defn substitute-path-segments
  "Split rel-path on `/`, replace every literal `projectname` segment with
   the underscored form from the name-pair, rejoin with `/`. Relative paths
   stored internally always use `/` separators; absolute paths are produced
   only via path/join."
  [rel-path pair]
  (let [segments (str/split rel-path "/")
        replaced (map #(str/replace % placeholder (:underscore pair)) segments)]
    (str/join "/" replaced)))
