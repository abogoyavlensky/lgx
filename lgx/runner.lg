(ns lgx.runner
  (:require [string :as str]))

(defn- lg-binary []
  (let [v (os/getenv "LGX_LG")]
    (if (str/blank? v) "lg" v)))

(defn- source-paths-flag [paths]
  (when (seq paths)
    ["-source-paths" (str/join os/path-separator paths)]))

;; --------------------------------------------------------------------------
;; TODO: this calls os/sh which buffers stdout/stderr until the child exits.
;; That's wrong for `lgx run`: script output won't stream and stdin is dead
;; (so `-r` REPL will not work). Replace with an inherited-stdio runner once
;; let-go ships one (see upstream issue link in the README).
;; --------------------------------------------------------------------------
(defn invoke-lg!
  "Run `lg` with -source-paths set to the resolved lib paths plus the
   user's forwarded args. When `verbose?` is truthy, print the resolved
   command (binary + args) to *err* before exec. Returns lg's exit code
   after replaying captured stdout/stderr."
  [lib-paths forward-args verbose?]
  (let [bin (lg-binary)
        args (vec (concat (or (source-paths-flag lib-paths) [])
                          forward-args))]
    (when verbose?
      (write! *err* (str "+ " bin " " (str/join " " args) "\n")))
    (let [r (apply os/sh bin args)]
      ;; Replay captured output. Imperfect substitute for inherited stdio.
      (when (seq (:out r)) (write! *out* (:out r)))
      (when (seq (:err r)) (write! *err* (:err r)))
      (:exit r))))

(defn exec-lg!
  "Like invoke-lg! but exits with lg's exit code."
  [lib-paths forward-args verbose?]
  (os/exit (invoke-lg! lib-paths forward-args verbose?)))
