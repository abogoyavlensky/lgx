(ns lgx.runner
  (:require [string :as str]))

(defn lg-binary
  "The lg binary lgx invokes: $LGX_LG when set, else `lg` on PATH."
  []
  (let [v (os/getenv "LGX_LG")]
    (if (str/blank? v) "lg" v)))

(defn- source-paths-flag [paths]
  (when (seq paths)
    ["-source-paths" (str/join os/path-separator paths)]))

(defn- resource-paths-flag [paths]
  (when (seq paths)
    ["-resource-paths" (str/join os/path-separator paths)]))

(defn lg-args
  "Assemble lg's argv: -source-paths / -resource-paths flags (omitted when
   the corresponding path list is empty) followed by the forwarded args."
  [lib-paths resource-paths forward-args]
  (vec (concat (or (source-paths-flag lib-paths) [])
               (or (resource-paths-flag resource-paths) [])
               forward-args)))

;; Env vars lgx writes into the environment, in display order:
;; LG_READ_CLJ for the lg child (see run-lg!),
;; LG_SUPPRESS_SOURCE_PATHS_WARNING silences lg's source-paths transition
;; notice — lgx owns the search path and deliberately omits "." (see
;; run-lg!) — and LGX_RUN is lgx's own run-marker (set by cmd-run / :run
;; task steps before invoke-lg!).
(def ^:private lgx-set-env-names
  ["LG_READ_CLJ" "LG_SUPPRESS_SOURCE_PATHS_WARNING" "LGX_RUN"])

(defn env-trace-line
  "Build the `+ env NAME=VALUE ...` trace line for the env vars lgx sets.
   `lookup` maps a var name to its value (pass os/getenv, or a map in
   tests). Keeps only the non-blank vars, in lgx-set-env-names order.
   Returns the line (with trailing newline) or nil when none are set."
  [lookup]
  (let [pairs (->> lgx-set-env-names
                   (keep (fn [n]
                           (let [v (lookup n)]
                             (when-not (str/blank? v) (str n "=" v))))))]
    (when (seq pairs)
      (str "+ env " (str/join " " pairs) "\n"))))

(defn binary-trace-line
  "Build the `+ lg <version> (<path>)` trace line describing the resolved lg
   binary. `version` is the token from `lg -v` (omitted when blank/nil);
   `path` is the resolved full path, falling back to `bin` when blank/nil.
   Always returns the line with a trailing newline."
  [version path bin]
  (let [loc (if (str/blank? path) bin path)
        ver (when-not (str/blank? version) (str " " version))]
    (str "+ lg" ver " (" loc ")\n")))

(defn replay-output!
  "Write lg's captured {:out :err} back to *out*/*err*. Imperfect
   substitute for inherited stdio."
  [r]
  (when (seq (:out r)) (write! *out* (:out r)))
  (when (seq (:err r)) (write! *err* (:err r))))

(defn- lg-invocation!
  "Prepare an lg invocation: set the env vars lgx exports to the child,
   assemble the argv via lg-args, and (when `verbose?`) write the env trace
   and `+ <bin> <args>` lines to *err*. Returns [bin args]."
  [lib-paths resource-paths forward-args verbose?]
  ;; lg's resolver doesn't search .clj by default and its reader leaves
  ;; #?(:clj ...) branches unmatched unless this is set. See
  ;; docs/issues/letgo-clj-support.md. Set before the verbose trace so the
  ;; env line reflects it.
  (os/setenv "LG_READ_CLJ" "1")
  ;; lgx always passes an explicit -source-paths that omits ".", which makes
  ;; lg print its source-paths transition notice (see lg.go warning). lgx is
  ;; the tooling that warning anticipates, so silence it.
  (os/setenv "LG_SUPPRESS_SOURCE_PATHS_WARNING" "1")
  (let [bin (lg-binary)
        args (lg-args lib-paths resource-paths forward-args)]
    (when verbose?
      (when-let [env-line (env-trace-line os/getenv)]
        (write! *err* env-line))
      (write! *err* (str "+ " bin " " (str/join " " args) "\n")))
    [bin args]))

(defn run-lg!
  "Run `lg` with -source-paths set to the resolved lib paths and
   -resource-paths set to the resolved resource roots, plus the user's
   forwarded args. When `verbose?` is truthy, print the env vars lgx sets
   and the resolved command to *err* before exec. Returns the full
   {:out :err :exit} result WITHOUT replaying output, so callers can
   inspect or transform lg's captured streams (e.g. cmd-test stripping its
   harness marker and detecting swallowed load errors). Most callers want
   invoke-lg!, which replays the output for them. Output is captured (via
   os/sh) and stdin is not connected; for streaming output or an
   interactive child use exec-lg-interactive!."
  [lib-paths resource-paths forward-args verbose?]
  (let [[bin args] (lg-invocation! lib-paths resource-paths forward-args
                                   verbose?)]
    (apply os/sh bin args)))

(defn invoke-lg!
  "Run lg via run-lg!, replay its captured output, and return its exit
   code."
  [lib-paths resource-paths forward-args verbose?]
  (let [r (run-lg! lib-paths resource-paths forward-args verbose?)]
    (replay-output! r)
    (:exit r)))

(defn exec-lg-interactive!
  "Run lg with the parent's stdin/stdout/stderr inherited (via os/exec*),
   so output streams live and the child stays interactive (REPL, prompts).
   Exits with lg's exit code; never returns."
  [lib-paths resource-paths forward-args verbose?]
  (let [[bin args] (lg-invocation! lib-paths resource-paths forward-args
                                   verbose?)]
    (os/exit (apply os/exec* bin args))))
