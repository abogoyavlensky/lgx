(ns lgx.runner
  (:require [lgx.path :as path]
            [string :as str]))

(defn lg-binary
  "The lg binary lgx invokes: $LGX_LG when set, else `lg` on PATH."
  []
  (let [v (os/getenv "LGX_LG")]
    (if (str/blank? v) "lg" v)))

(defn lg-version
  "The version token from `lg -v` (e.g. \"1.10.0\"), or nil when lg is absent or
   the output is unparseable. Probes the same lg lgx invokes (honoring LGX_LG),
   or the binary at `bin` when given."
  ([] (lg-version (lg-binary)))
  ([bin]
   (let [r (try (os/sh bin "-v") (catch e nil))]
     (when (and r (zero? (:exit r)))
       (let [toks (str/split (str/trim (:out r)) #"\s+")]
         (if (= (first toks) "lg") (second toks) (first toks)))))))

(defn display-path
  "Resolve an explicit lg binary path (LGX_LG) for display: absolute paths are
   returned unchanged, relative ones are normalized to absolute against `cwd`."
  [bin cwd]
  (if (path/absolute? bin)
    bin
    (path/normalize (path/join cwd bin))))

(defn lg-resolved-path
  "The full path of the lg binary lgx will invoke, or nil when it can't be
   resolved. An explicit LGX_LG path is normalized to absolute against cwd; a
   bare name is resolved on PATH via `command -v` (bin passed as an argument,
   never interpolated into the script)."
  []
  (let [bin (lg-binary)]
    (if (str/includes? bin os/file-separator)
      (display-path bin (os/cwd))
      (let [r (try (os/sh "sh" "-c" "command -v -- \"$1\"" "sh" bin)
                   (catch e nil))]
        (when (and r (zero? (:exit r)) (not (str/blank? (:out r))))
          (str/trim (:out r)))))))

(defn- source-paths-flag [paths]
  (when (seq paths)
    ["-source-paths" (str/join os/path-separator paths)]))

(defn- resource-paths-flag [paths]
  (when (seq paths)
    ["-resource-paths" (str/join os/path-separator paths)]))

(defn lg-args
  "Assemble lg's argv: -source-paths / -resource-paths flags (omitted when
   the corresponding path list is empty) followed by the forwarded args."
  [lib-paths resource-paths forward-args]
  (vec (concat (or (source-paths-flag lib-paths) [])
               (or (resource-paths-flag resource-paths) [])
               forward-args)))

(defn- position
  "Index of the first occurrence of x in v, or -1 if absent."
  [v x]
  (loop [i 0
         xs (seq v)]
    (cond
      (nil? xs) -1
      (= x (first xs)) i
      :else (recur (inc i) (next xs)))))

(defn plan-run-args
  "Pure. Decide the argv to hand `lg` for `lgx run`, given the user's
   `forward-args` and the project's `:main` (nil when unset).

   Structural, heuristic-free: split `forward-args` at the first `--` into
   `pre` (before) and `post` (after; empty when there is no `--`). Any token in
   `pre` means the user is driving `lg` themselves — pass `pre ++ post` through
   and never inject `:main`. An empty `pre` injects `:main` and treats `post` as
   the app's args. lgx never emits a `--` of its own; a second, user-authored
   `--` survives inside `post` as a literal arg (lg stops flag-parsing at the
   first positional, so post-`:main` args become `*command-line-args*`).
   Returns one of:
     {:argv [...] :inject? true}   ; `:main` injected — caller validates it exists
     {:argv [...] :inject? false}  ; pass-through (explicit script / lg flags)
     {:error :needs-main}          ; `-- <args>` given but no `:main` to receive them
     {:error :no-target}           ; bare `lgx run` with no `:main` and nothing to run"
  [forward-args main-script]
  (let [dd (position forward-args "--")
        pre (if (neg? dd) (vec forward-args) (vec (take dd forward-args)))
        post (if (neg? dd) [] (vec (drop (inc dd) forward-args)))]
    (cond
      (seq pre) {:argv (vec (concat pre post))
                 :inject? false}
      main-script {:argv (vec (cons main-script post))
                   :inject? true}
      (seq post) {:error :needs-main}
      :else {:error :no-target})))

(defn drop-arg-separator
  "Remove the first `--` (the lgx/app arg separator) from an argv, leaving the
   rest — including any later `--` — untouched. Task `:run` steps forward an
   explicit argv to `lg` and, like `lgx run`, must not pass the user's
   app-level `--` through to lg (where it would land in `*command-line-args*`).
   Unlike `plan-run-args`, this never injects `:main`."
  [argv]
  (let [dd (position argv "--")]
    (if (neg? dd)
      (vec argv)
      (vec (concat (take dd argv) (drop (inc dd) argv))))))

;; Env vars lgx writes into the environment, in display order:
;; LG_READ_CLJ for the lg child (see run-lg!), LGX_RUN is lgx's own
;; run-marker (set by cmd-run / :run task steps before invoke-lg!), and
;; LGX_TASK_STACK is the chain of running task names (set by cmd-task) that
;; the cycle guard reads back out of a child process. Its sibling
;; LGX_TASK_ROOTS carries the matching project roots and is deliberately not
;; traced — it is an encoding detail, not something a user sets or reads.
(def ^:private lgx-set-env-names
  ["LG_READ_CLJ" "LGX_RUN" "LGX_TASK_STACK"])

(defn env-trace-line
  "Build the `+ env NAME=VALUE ...` trace line for the env vars lgx sets.
   `lookup` maps a var name to its value (pass os/getenv, or a map in
   tests). Keeps only the non-blank vars, in lgx-set-env-names order.
   Returns the line (with trailing newline) or nil when none are set."
  [lookup]
  (let [pairs (->> lgx-set-env-names
                   (keep (fn [n]
                           (let [v (lookup n)]
                             (when-not (str/blank? v) (str n "=" v))))))]
    (when (seq pairs)
      (str "+ env " (str/join " " pairs) "\n"))))

(defn binary-trace-line
  "Build the `+ lg <version> (<path>)` trace line describing the resolved lg
   binary. `version` is the token from `lg -v` (omitted when blank/nil);
   `path` is the resolved full path, falling back to `bin` when blank/nil.
   Always returns the line with a trailing newline."
  [version path bin]
  (let [loc (if (str/blank? path) bin path)
        ver (when-not (str/blank? version) (str " " version))]
    (str "+ lg" ver " (" loc ")\n")))

(defn replay-output!
  "Write lg's captured {:out :err} back to *out*/*err*. Imperfect
   substitute for inherited stdio."
  [r]
  (when (seq (:out r)) (write! *out* (:out r)))
  (when (seq (:err r)) (write! *err* (:err r))))

(defn- lg-invocation!
  "Prepare an lg invocation: set the env vars lgx exports to the child,
   assemble the argv via lg-args, and (when `verbose?`) write the resolved
   `+ lg <version> (<path>)` line, the env trace, and the `+ <bin> <args>`
   line to *err*. Returns [bin args]."
  [lib-paths resource-paths forward-args verbose?]
  ;; lg's resolver doesn't search .clj by default and its reader leaves
  ;; #?(:clj ...) branches unmatched unless this is set. See
  ;; docs/issues/letgo-clj-support.md. Set before the verbose trace so the
  ;; env line reflects it.
  (os/setenv "LG_READ_CLJ" "1")
  (let [bin (lg-binary)
        args (lg-args lib-paths resource-paths forward-args)]
    (when verbose?
      (write! *err* (binary-trace-line (lg-version) (lg-resolved-path) bin))
      (when-let [env-line (env-trace-line os/getenv)]
        (write! *err* env-line))
      (write! *err* (str "+ " bin " " (str/join " " args) "\n")))
    [bin args]))

(defn run-lg!
  "Run `lg` with -source-paths set to the resolved lib paths and
   -resource-paths set to the resolved resource roots, plus the user's
   forwarded args. When `verbose?` is truthy, print the env vars lgx sets
   and the resolved command to *err* before exec. Returns the full
   {:out :err :exit} result WITHOUT replaying output, so callers can
   inspect or transform lg's captured streams (e.g. cmd-test stripping its
   harness marker and detecting swallowed load errors). Most callers want
   invoke-lg!, which replays the output for them. Output is captured (via
   os/sh) and stdin is not connected; for streaming output or an
   interactive child use exec-lg-interactive!."
  [lib-paths resource-paths forward-args verbose?]
  (let [[bin args] (lg-invocation! lib-paths resource-paths forward-args
                                   verbose?)]
    (apply os/sh bin args)))

(defn invoke-lg!
  "Run lg via run-lg!, replay its captured output, and return its exit
   code."
  [lib-paths resource-paths forward-args verbose?]
  (let [r (run-lg! lib-paths resource-paths forward-args verbose?)]
    (replay-output! r)
    (:exit r)))

(defn passthrough-handles
  "Open out-path and err-path (normally /dev/stdout and /dev/stderr) and
   return [out err] handles, or nil if either open throws.

   Why: on let-go >= 1.13.0 the root *out* / *err* handles wrap the
   process streams in a stdStreamWriter, which is not an *os.File, so
   os/exec* gives the child a pipe for stdout/stderr instead of the
   parent's descriptor - and a REPL child loses its tty. A handle from
   `open` is backed by the raw *os.File, so binding *out* / *err* to
   these restores descriptor inheritance. See
   docs/issues/exec-star-std-stream-pipes.md.

   :append rather than :write because :write carries O_TRUNC, which
   would truncate a regular file when stdout is redirected; :append is
   safe for a tty, a pipe, and a file alike. The caller falls back to a
   plain os/exec* on nil."
  [out-path err-path]
  (try
    [(open out-path :append) (open err-path :append)]
    (catch _ nil)))

(defn tty-handle?
  "True when handle h is a terminal. False for pipes, regular files, and
   handles that are not file-backed (term/tty? throws on those)."
  [h]
  (try
    (term/tty? h)
    (catch _ false)))

(defn exec-interactive!
  "Run `bin` with `args` and the parent's stdin/stdout/stderr inherited, so
   output streams live and the child stays interactive (REPL, prompts).
   Returns the child's exit code.

   stdin is inherited by os/exec* itself. stdout/stderr go through
   *out* / *err*, and on let-go >= 1.13.0 the root handles are not raw
   files, so os/exec* gives the child a pipe and a REPL child loses its
   tty. So each of *out* / *err* that is currently a terminal is rebound
   to a /dev/stdout or /dev/stderr file handle (passthrough-handles) for
   the duration of the call. Streams that are a pipe or a regular file
   are left alone on purpose: reopening /dev/stdout creates a new open
   file description, so a child's writes would not advance the shell's
   offset and `{ lgx run ...; echo done; } > out.txt` would overwrite
   the child's output. Through the pipe the child's writes still land on
   the inherited descriptor. If the handles cannot be opened, falls back
   to a plain os/exec*. The handles are never closed: either the process
   exits right after, or the task's next step reuses the same terminal."
  [bin args]
  (let [tty-out? (tty-handle? *out*)
        tty-err? (tty-handle? *err*)
        [out err] (when (or tty-out? tty-err?)
                    (passthrough-handles "/dev/stdout" "/dev/stderr"))]
    (if (and out err)
      (binding [*out* (if tty-out? out *out*)
                *err* (if tty-err? err *err*)]
        (apply os/exec* bin args))
      (apply os/exec* bin args))))

(defn exec-lg-interactive!
  "Run lg through exec-interactive! and exit with its exit code; never
   returns."
  [lib-paths resource-paths forward-args verbose?]
  (let [[bin args] (lg-invocation! lib-paths resource-paths forward-args
                                   verbose?)]
    (os/exit (exec-interactive! bin args))))
