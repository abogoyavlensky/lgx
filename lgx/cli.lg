(ns lgx.cli
  (:require [lgx.path :as path]
            [string :as str]))

;; --------------------------------------------------------------------------
;; CLI argv parsing
;;
;; Isolated from lgx.main so it can be unit-tested: lgx.main's load runs
;; (main), so a test cannot require it. These helpers are pure, except for
;; the `!`-suffixed wrappers that feed the real environment into one.
;; --------------------------------------------------------------------------

(defn user-args
  "Strip the program prefix from `argv`, returning the user's command + args.
   In dev (`lg lgx.lg <cmd> ...`) the second arg is the script path ending in
   .lg, so drop two; as a bundle (`./lgx <cmd> ...`) drop only the program."
  [argv]
  (let [argv (vec argv)]
    (cond
      (and (>= (count argv) 2)
           (str/ends-with? (nth argv 1) ".lg"))
      (drop 2 argv)
      :else
      (rest argv))))

(defn self-invocation
  "Split `argv` into the pieces needed to re-invoke lgx as a child process:
   {:bin <program> :prefix [<script> ...]}. Same rule as user-args — in dev
   (`lg lgx.lg <cmd> ...`) the script path is part of the invocation, as a
   bundle (`./lgx <cmd> ...`) there is nothing between the program and the
   command. Pure: the program name is returned as argv gave it, so resolving
   it to a real file is resolve-self-bin's job."
  [argv]
  (let [argv (vec argv)]
    (if (and (>= (count argv) 2)
             (str/ends-with? (nth argv 1) ".lg"))
      {:bin (first argv)
       :prefix [(nth argv 1)]}
      {:bin (first argv)
       :prefix []})))

(defn resolve-self-bin
  "Resolve argv[0] to a path a child process can exec. let-go has no
   executable-path builtin, and argv[0] is a bare name when the user invoked
   lgx through PATH, so: a value containing a separator is absolutized
   against `cwd`; a bare name goes to `lookup`, which returns its resolved
   path or nil. An unresolvable name is returned unchanged, leaving the child
   to a plain PATH lookup.

   Resolving rather than re-running `lgx` off PATH is what makes the child
   the same binary as the parent, even under a version-manager shim: the
   shim's own path is what resolves, and the child inherits the cwd the shim
   keys on."
  [argv0 cwd lookup]
  (if (str/includes? argv0 os/file-separator)
    (if (path/absolute? argv0)
      argv0
      (path/normalize (path/join cwd argv0)))
    (or (lookup argv0) argv0)))

(defn path-lookup
  "Resolve a bare program name through PATH the way the shell does, via
   `command -v`. Returns the resolved path, or nil when the name does not
   resolve. Delegated to the shell rather than walking PATH with os/stat
   because stat reports no mode bits: a non-executable file named `lgx`
   early on PATH is one the shell skips and stat would not. The name is
   passed as an argument, never interpolated into the script."
  [name]
  (let [r (try (os/sh "sh" "-c" "command -v -- \"$1\"" "sh" name)
               (catch _ nil))]
    (when (and r (zero? (:exit r)) (not (str/blank? (:out r))))
      (str/trim (:out r)))))

(defn resolve-self-bin!
  "resolve-self-bin wired to the real environment."
  [argv0]
  (resolve-self-bin argv0 (os/cwd) path-lookup))

(def ^:private lgx-prefix "lgx:")

(defn strip-lgx-prefix
  "The command name behind an `lgx:<name>` word, or nil when `cmd` carries no
   such prefix. `lgx:` alone yields \"\", which names no built-in and so gets
   the same error as any other unknown one."
  [cmd]
  (when (str/starts-with? cmd lgx-prefix)
    (subs cmd (count lgx-prefix))))

(defn child-args
  "The argv a `:task` step hands the child lgx, after the self-invocation
   prefix: the global flags the parent is running under, then the callee and
   its args. `with` is the caller's effective context list, forwarded so the
   child's own layering unions it with the callee's `:with`. Each context
   renders as (subs (str k) 1) — never (name k), which would drop the
   namespace of an :app/dev."
  [with verbose? callee callee-args]
  (vec (concat (if verbose? ["--verbose"] [])
               (if (seq with)
                 ["--with" (str/join "," (map #(subs (str %) 1) with))]
                 [])
               [callee]
               callee-args)))

(def ^:private with-error
  "lgx: --with requires a comma-separated list of context names")

(defn- parse-with-value [value]
  (when (nil? value)
    (throw (ex-info with-error {})))
  ;; Trim each comma-segment before filtering so a spaced list like
  ;; `--with "dev, test"` yields :test, not :" test".
  (let [names (vec (filter (fn [s] (not (str/blank? s)))
                           (map str/trim (str/split value ","))))]
    (when (empty? names)
      (throw (ex-info with-error {})))
    (mapv keyword names)))

(def ^:private port-error
  "lgx: --port requires an integer port between 1 and 65535")

(def ^:private nrepl-args-error
  "lgx: nrepl does not take arguments other than --port <n>")

(defn parse-nrepl-args
  "Parse the `nrepl` command's rest-args. Returns {:port <int>} for
   `--port <n>` (n must be an integer in 1-65535) or {:port nil} when the
   flag is absent (caller picks a free port). Throws ex-info on a
   missing/invalid port value or any other token."
  [args]
  (let [args (vec args)]
    (cond
      (empty? args)
      {:port nil}

      (= ["--port"] [(first args)])
      (let [port (parse-long (or (second args) ""))]
        (when (or (nil? port) (< port 1) (> port 65535))
          (throw (ex-info port-error {})))
        (when (> (count args) 2)
          (throw (ex-info nrepl-args-error {})))
        {:port port})

      :else
      (throw (ex-info nrepl-args-error {})))))

(def ^:private install-args-error
  "lgx: install does not take arguments other than --all")

(defn parse-install-args
  "Parse the `install` command's rest-args. Returns {:all? true} when `--all`
   is present (it may repeat), else {:all? false}. Throws ex-info on any other
   token."
  [args]
  (loop [args (seq args)
         all? false]
    (cond
      (nil? args) {:all? all?}
      (= "--all" (first args)) (recur (next args) true)
      :else (throw (ex-info install-args-error {})))))

(def ^:private target-value-error
  "lgx: --target requires a value in <os>/<arch> form (e.g. linux/arm64)")

(def ^:private all-target-conflict-error
  "lgx: --all and --target cannot be combined")

(defn- parse-target-value
  "One --target value: a comma-separated list of os/arch pairs, each becoming
   the {:os :arch} map the rest of the pipeline (and lgx.edn) uses. Only the
   CLI surface speaks slash form."
  [value]
  (when (nil? value)
    (throw (ex-info target-value-error {})))
  (let [specs (vec (filter (fn [s] (not (str/blank? s)))
                           (map str/trim (str/split value ","))))]
    (when (empty? specs)
      (throw (ex-info target-value-error {})))
    (mapv (fn [spec]
            (let [parts (str/split spec "/")]
              (when (or (not= 2 (count parts))
                        (str/blank? (first parts))
                        (str/blank? (second parts)))
                (throw (ex-info (str "lgx: --target expects <os>/<arch> "
                                     "(e.g. linux/arm64), got "
                                     (pr-str spec))
                                {})))
              {:os (first parts)
               :arch (second parts)}))
          specs)))

(defn parse-build-args
  "Parse the `build` command's rest-args, splitting lgx's own flags from the
   args forwarded to `lg`. `--target <os>/<arch>[,...]` (repeatable) and
   `--all` may appear anywhere; every other token forwards in order. Returns
   {:targets [{:os :arch} ...] :all? bool :forward [str ...]}. Throws ex-info
   on a missing/unparseable target value or on --all combined with --target —
   one says \"everything declared\", the other names a list."
  [args]
  (loop [targets []
         all? false
         forward []
         xs (seq args)]
    (if (nil? xs)
      (do
        (when (and all? (seq targets))
          (throw (ex-info all-target-conflict-error {})))
        {:targets targets
         :all? all?
         :forward forward})
      (let [tok (first xs)]
        (cond
          (= tok "--target")
          (recur (vec (concat targets (parse-target-value (first (next xs)))))
                 all? forward (next (next xs)))

          (= tok "--all")
          (recur targets true forward (next xs))

          :else
          (recur targets all? (conj forward tok) (next xs)))))))

(def ^:private exclude-error
  "lgx: --exclude requires a comma-separated list of test namespaces")

(defn- parse-exclude-value
  "One --exclude value: a comma-separated list of test namespace names,
   trimmed, blanks dropped, each becoming the symbol the test plan carries."
  [value]
  (when (nil? value)
    (throw (ex-info exclude-error {})))
  (let [names (vec (filter (fn [s] (not (str/blank? s)))
                           (map str/trim (str/split value ","))))]
    (when (empty? names)
      (throw (ex-info exclude-error {})))
    (mapv symbol names)))

(defn parse-test-args
  "Parse the `test` command's rest-args. `--exclude <ns,...>` (repeatable,
   accumulating) may appear anywhere; every other token is a positional, in
   order. Returns {:exclude [sym ...] :positionals [str ...]}. Throws ex-info
   on a missing or blank --exclude value. The positional count and the
   file/--exclude conflict are cmd-test's checks, next to its other errors."
  [args]
  (loop [exclude []
         positionals []
         xs (seq args)]
    (if (nil? xs)
      {:exclude exclude
       :positionals positionals}
      (let [tok (first xs)]
        (if (= tok "--exclude")
          (recur (vec (concat exclude (parse-exclude-value (first (next xs)))))
                 positionals (next (next xs)))
          (recur exclude (conj positionals tok) (next xs)))))))

(def ^:private template-value-error
  "lgx: --template requires a value (built-in name or git URL)")

(def ^:private template-repeat-error
  "lgx: --template given more than once")

(defn parse-new-args
  "Parse the `new` command's rest-args. Accepts `-t`/`--template <value>` at
   any position plus exactly one positional (the project name). Returns
   {:name <string> :template <string or nil>}. Throws ex-info on a
   missing/repeated template value or a positional count other than one."
  [args]
  (loop [positionals []
         template nil
         xs (seq args)]
    (if (nil? xs)
      (cond
        (empty? positionals)
        (throw (ex-info "lgx: new requires a project name" {}))

        (> (count positionals) 1)
        (throw (ex-info "lgx: new takes exactly one project name" {}))

        :else
        {:name (first positionals)
         :template template})
      (let [tok (first xs)]
        (if (or (= tok "-t") (= tok "--template"))
          (let [value (first (next xs))]
            (when (nil? value)
              (throw (ex-info template-value-error {})))
            (when-not (nil? template)
              (throw (ex-info template-repeat-error {})))
            (recur positionals value (next (next xs))))
          (recur (conj positionals tok) template (next xs)))))))

(defn parse-leading-flags
  "Parse leading global flags from `args` (the `user-args` output). Consumes
   leading `--verbose` and `--with a,b` tokens, in any order and repeatable, up
   to the first non-flag token (the command). Returns
   {:verbose? bool :with [kw ...] :args [str ...]} where :args is the command
   and everything after it (flags past the command are left untouched).
   Comma-splits `--with` values and drops blanks; throws ex-info when `--with`
   has no value or yields no names."
  [args]
  (loop [verbose? false
         with []
         xs (seq args)]
    (if (nil? xs)
      {:verbose? verbose?
       :with with
       :args []}
      (let [tok (first xs)]
        (cond
          (= tok "--verbose")
          (recur true with (next xs))

          (= tok "--with")
          (recur verbose?
                 (vec (concat with (parse-with-value (first (next xs)))))
                 (next (next xs)))

          :else
          {:verbose? verbose?
           :with with
           :args (vec xs)})))))
