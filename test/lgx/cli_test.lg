;; Unit tests for lgx.cli — pure argv / leading-flag parsing.
;; Run with: lgx test  (from project root)

(ns lgx.cli-test
  (:require [lgx.cli :as cli]
            [string :as str]
            [clojure.test :refer [deftest is]]))

(defn- threw? [f]
  (try (f) :no-throw (catch e :threw)))

;; ---------------------------------------------------------------------------
;; parse-leading-flags
;; ---------------------------------------------------------------------------

(deftest parse-bare-command
  (let [r (cli/parse-leading-flags ["run"])]
    (is (= false (:verbose? r)))
    (is (= [] (:with r)))
    (is (= ["run"] (vec (:args r))))))

(deftest parse-verbose-flag
  (let [r (cli/parse-leading-flags ["--verbose" "run"])]
    (is (= true (:verbose? r)))
    (is (= [] (:with r)))
    (is (= ["run"] (vec (:args r))))))

(deftest parse-with-comma-list
  (let [r (cli/parse-leading-flags ["--with" "dev,test" "run"])]
    (is (= [:dev :test] (vec (:with r))))
    (is (= ["run"] (vec (:args r))))))

(deftest parse-repeated-with
  (let [r (cli/parse-leading-flags ["--with" "dev" "--with" "test" "run"])]
    (is (= [:dev :test] (vec (:with r))))
    (is (= ["run"] (vec (:args r))))))

(deftest parse-verbose-then-with
  (let [r (cli/parse-leading-flags ["--verbose" "--with" "dev" "run"])]
    (is (= true (:verbose? r)))
    (is (= [:dev] (vec (:with r))))
    (is (= ["run"] (vec (:args r))))))

(deftest parse-with-then-verbose
  (let [r (cli/parse-leading-flags ["--with" "dev" "--verbose" "run"])]
    (is (= true (:verbose? r)))
    (is (= [:dev] (vec (:with r))))
    (is (= ["run"] (vec (:args r))))))

(deftest parse-with-trims-blanks
  (let [r (cli/parse-leading-flags ["--with" "dev,,test," "run"])]
    (is (= [:dev :test] (vec (:with r))))))

(deftest parse-with-trims-whitespace
  ;; A quoted list with spaces (`--with "dev, test"`) keywords cleanly.
  (let [r (cli/parse-leading-flags ["--with" "dev, test" "run"])]
    (is (= [:dev :test] (vec (:with r))))))

(deftest parse-stops-at-first-command
  ;; A --with after the command is not consumed; it stays in :args.
  (let [r (cli/parse-leading-flags ["run" "--with" "x"])]
    (is (= [] (:with r)))
    (is (= ["run" "--with" "x"] (vec (:args r))))))

(deftest parse-with-missing-value-throws
  (is (= :threw (threw? #(cli/parse-leading-flags ["--with"]))))
  (is (= :threw (threw? #(cli/parse-leading-flags ["--with" ""]))))
  (is (= :threw (threw? #(cli/parse-leading-flags ["--with" ","])))))

;; ---------------------------------------------------------------------------
;; user-args (dev-vs-bundle program-prefix strip)
;; ---------------------------------------------------------------------------

(deftest user-args-dev-prefix
  ;; lg lgx.lg <cmd> ... — second arg ends in .lg, drop the first two.
  (is (= ["run" "x"] (vec (cli/user-args ["lg" "lgx.lg" "run" "x"])))))

(deftest user-args-bundle-prefix
  ;; ./lgx <cmd> ... — drop only the program name.
  (is (= ["run" "x"] (vec (cli/user-args ["lgx" "run" "x"])))))

;; ---------------------------------------------------------------------------
;; parse-nrepl-args
;; ---------------------------------------------------------------------------

(deftest nrepl-no-args-means-auto-port
  (is (= {:port nil} (cli/parse-nrepl-args []))))

(deftest nrepl-port-flag-parses-integer
  (is (= {:port 7888} (cli/parse-nrepl-args ["--port" "7888"]))))

(deftest nrepl-port-missing-value-throws
  (is (= :threw (threw? #(cli/parse-nrepl-args ["--port"])))))

(deftest nrepl-port-non-integer-throws
  (is (= :threw (threw? #(cli/parse-nrepl-args ["--port" "abc"])))))

(deftest nrepl-port-out-of-range-throws
  (is (= :threw (threw? #(cli/parse-nrepl-args ["--port" "0"]))))
  (is (= :threw (threw? #(cli/parse-nrepl-args ["--port" "70000"])))))

(deftest nrepl-unexpected-arg-throws
  (is (= :threw (threw? #(cli/parse-nrepl-args ["extra"]))))
  (is (= :threw (threw? #(cli/parse-nrepl-args ["--port" "7888" "extra"])))))

;; ---------------------------------------------------------------------------
;; parse-new-args
;; ---------------------------------------------------------------------------

(deftest new-name-only
  (is (= {:name "myapp" :template nil} (cli/parse-new-args ["myapp"]))))

(deftest new-template-after-name
  (is (= {:name "myapp" :template "cli"}
         (cli/parse-new-args ["myapp" "-t" "cli"]))))

(deftest new-template-before-name
  (is (= {:name "myapp" :template "cli"}
         (cli/parse-new-args ["-t" "cli" "myapp"]))))

(deftest new-template-long-form-url
  (is (= {:name "myapp" :template "https://github.com/u/r"}
         (cli/parse-new-args ["myapp" "--template" "https://github.com/u/r"]))))

(deftest new-template-missing-value-throws
  (is (= :threw (threw? #(cli/parse-new-args ["myapp" "-t"])))))

(deftest new-template-repeated-throws
  (is (= :threw (threw? #(cli/parse-new-args ["-t" "a" "--template" "b" "myapp"])))))

(deftest new-no-name-throws
  (is (= :threw (threw? #(cli/parse-new-args [])))))

(deftest new-two-positionals-throws
  (is (= :threw (threw? #(cli/parse-new-args ["a" "b"])))))

;; ---------------------------------------------------------------------------
;; parse-build-args
;; ---------------------------------------------------------------------------

(deftest build-no-flags-forwards-everything
  (is (= {:targets [] :all? false :forward ["-O2" "-v"]}
         (cli/parse-build-args ["-O2" "-v"])))
  (is (= {:targets [] :all? false :forward []}
         (cli/parse-build-args []))))

(deftest build-single-target
  (is (= {:targets [{:os "linux" :arch "arm64"}] :all? false :forward []}
         (cli/parse-build-args ["--target" "linux/arm64"]))))

(deftest build-comma-separated-targets
  (is (= {:targets [{:os "linux" :arch "arm64"}
                    {:os "darwin" :arch "amd64"}]
          :all? false
          :forward []}
         (cli/parse-build-args ["--target" "linux/arm64,darwin/amd64"]))))

(deftest build-repeated-target-accumulates
  (is (= {:targets [{:os "linux" :arch "arm64"}
                    {:os "darwin" :arch "arm64"}]
          :all? false
          :forward []}
         (cli/parse-build-args ["--target" "linux/arm64"
                                "--target" "darwin/arm64"]))))

(deftest build-all-flag
  (is (= {:targets [] :all? true :forward []}
         (cli/parse-build-args ["--all"]))))

(deftest build-target-mixes-with-forwarded-lg-flags
  ;; lgx's own flags may appear anywhere; everything else forwards in order.
  (is (= {:targets [{:os "linux" :arch "arm64"}] :all? false
          :forward ["-O2" "-v"]}
         (cli/parse-build-args ["-O2" "--target" "linux/arm64" "-v"])))
  (is (= {:targets [{:os "linux" :arch "arm64"}] :all? false
          :forward ["-O2" "-v"]}
         (cli/parse-build-args ["--target" "linux/arm64" "-O2" "-v"]))))

(deftest build-target-missing-value-throws
  (is (= :threw (threw? #(cli/parse-build-args ["--target"])))))

(deftest build-target-unparseable-value-throws
  (is (= :threw (threw? #(cli/parse-build-args ["--target" "linux"]))))
  (is (= :threw (threw? #(cli/parse-build-args ["--target" "linux/arm64/x"]))))
  (is (= :threw (threw? #(cli/parse-build-args ["--target" "/arm64"]))))
  (is (= :threw (threw? #(cli/parse-build-args ["--target" "linux/"]))))
  (is (= :threw (threw? #(cli/parse-build-args ["--target" ","])))))

(deftest build-target-error-names-the-expected-form
  (let [msg (try (cli/parse-build-args ["--target" "linux"])
                 nil
                 (catch e (ex-message e)))]
    (is (str/includes? msg "<os>/<arch>"))))

(deftest build-all-and-target-together-throw
  ;; They contradict: one says "everything declared", the other names a list.
  (is (= :threw (threw? #(cli/parse-build-args ["--all" "--target"
                                                "linux/arm64"]))))
  (is (= :threw (threw? #(cli/parse-build-args ["--target" "linux/arm64"
                                                "--all"])))))

;; ---------------------------------------------------------------------------
;; parse-test-args
;; ---------------------------------------------------------------------------

(deftest test-args-no-flags-keeps-positionals
  (is (= {:exclude [] :positionals ["test/x_test.lg"]}
         (cli/parse-test-args ["test/x_test.lg"])))
  (is (= {:exclude [] :positionals []}
         (cli/parse-test-args []))))

(deftest test-args-single-exclude
  (is (= {:exclude ['a-test] :positionals []}
         (cli/parse-test-args ["--exclude" "a-test"]))))

(deftest test-args-exclude-comma-list-trims-blanks
  (is (= {:exclude ['a-test 'b-test] :positionals []}
         (cli/parse-test-args ["--exclude" "a-test, b-test,,"]))))

(deftest test-args-repeated-exclude-accumulates
  (is (= {:exclude ['a-test 'b-test 'c-test] :positionals []}
         (cli/parse-test-args ["--exclude" "a-test,b-test"
                               "--exclude" "c-test"]))))

(deftest test-args-exclude-anywhere-keeps-positional
  ;; The flag may follow or precede the positional; the positional survives.
  (is (= {:exclude ['a-test] :positionals ["test/x_test.lg"]}
         (cli/parse-test-args ["test/x_test.lg" "--exclude" "a-test"])))
  (is (= {:exclude ['a-test] :positionals ["test/x_test.lg"]}
         (cli/parse-test-args ["--exclude" "a-test" "test/x_test.lg"]))))

(deftest test-args-two-positionals-are-both-returned
  ;; The at-most-one check is cmd-test's job, next to its other errors.
  (is (= {:exclude [] :positionals ["a.lg" "b.lg"]}
         (cli/parse-test-args ["a.lg" "b.lg"]))))

(deftest test-args-exclude-missing-value-throws
  (is (= :threw (threw? #(cli/parse-test-args ["--exclude"])))))

(deftest test-args-exclude-blank-value-throws
  (is (= :threw (threw? #(cli/parse-test-args ["--exclude" " , "])))))

(deftest test-args-exclude-error-names-the-flag
  (let [msg (try (cli/parse-test-args ["--exclude"])
                 nil
                 (catch e (ex-message e)))]
    (is (= "lgx: --exclude requires a comma-separated list of test namespaces"
           msg))))

;; ---------------------------------------------------------------------------
;; self-invocation / resolve-self-bin / strip-lgx-prefix / child-args
;; ---------------------------------------------------------------------------

(deftest self-invocation-dev-prefix
  (is (= {:bin "lg" :prefix ["lgx.lg"]}
         (cli/self-invocation ["lg" "lgx.lg" "run"]))))

(deftest self-invocation-bundle
  (is (= {:bin "/x/bin/lgx" :prefix []}
         (cli/self-invocation ["/x/bin/lgx" "run"]))))

(deftest self-invocation-bare-program-only
  (is (= {:bin "lgx" :prefix []}
         (cli/self-invocation ["lgx"]))))

(deftest strip-lgx-prefix
  (is (= "test" (cli/strip-lgx-prefix "lgx:test")))
  (is (nil? (cli/strip-lgx-prefix "test")))
  (is (= "" (cli/strip-lgx-prefix "lgx:"))))

(deftest child-args-plain
  (is (= ["fmt" "check"] (cli/child-args [] false "fmt" ["check"]))))

(deftest child-args-with-and-verbose
  (is (= ["--verbose" "--with" "dev,test" "fmt" "check"]
         (cli/child-args [:dev :test] true "fmt" ["check"]))))

(deftest child-args-keeps-context-namespace
  ;; (subs (str k) 1), never (name k), so :app/dev survives the round trip
  ;; through the child's own --with parsing.
  (is (= ["--with" "app/dev" "fmt"]
         (cli/child-args [:app/dev] false "fmt" []))))

(deftest resolve-self-bin-absolute
  (is (= "/x/bin/lgx"
         (cli/resolve-self-bin "/x/bin/lgx" "/w" (fn [_] "/other/lgx")))))

(deftest resolve-self-bin-relative-absolutizes
  (is (= "/w/bin/lgx"
         (cli/resolve-self-bin "./bin/lgx" "/w" (fn [_] nil)))))

(deftest resolve-self-bin-bare-uses-lookup
  (is (= "/b/lgx"
         (cli/resolve-self-bin "lgx" "/w" (fn [n] (when (= n "lgx") "/b/lgx"))))))

(deftest resolve-self-bin-bare-unresolved-unchanged
  (is (= "lgx" (cli/resolve-self-bin "lgx" "/w" (fn [_] nil)))))

;; Regression: the shell skips a non-executable file early on PATH, and
;; os/stat cannot see the mode bits, so the lookup goes through `command -v`.
(deftest path-lookup-skips-non-executable
  (let [dir (str "/tmp/lgx-path-lookup-test-" (rand-int 100000000))
        early (str dir "/early")
        late (str dir "/late")]
    (mkdir dir)
    (mkdir early)
    (mkdir late)
    (spit (str early "/lgx-probe") "#!/bin/sh\n")
    (spit (str late "/lgx-probe") "#!/bin/sh\n")
    (os/sh "chmod" "-x" (str early "/lgx-probe"))
    (os/sh "chmod" "+x" (str late "/lgx-probe"))
    (let [prev (os/getenv "PATH")]
      ;; Prepend rather than replace: os/sh resolves `sh` through PATH too.
      (os/setenv "PATH" (str early ":" late ":" prev))
      (let [found (cli/path-lookup "lgx-probe")]
        (os/setenv "PATH" prev)
        (os/sh "rm" "-rf" dir)
        (is (= (str late "/lgx-probe") found))))))

(deftest path-lookup-nil-for-unknown-name
  (is (nil? (cli/path-lookup "lgx-definitely-not-a-real-program-xyz"))))
