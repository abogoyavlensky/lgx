;; Unit tests for lgx.new.
;; Run with: lgx test  (from project root)

(ns lgx.new-test
  (:require [lgx.new :as new]
            [string :as str]
            [clojure.test :refer [deftest is]]))

(defn- caught-reason [f]
  (try (f) nil
       (catch e (:reason (ex-data e)))))

(defn- caught-name [f]
  (try (f) nil
       (catch e (:name (ex-data e)))))

(defn- caught-path [f]
  (try (f) nil
       (catch e (:path (ex-data e)))))

(defn- mktemp! [tag]
  (let [d (str "/tmp/lgx-new-" tag "-" (rand-int 100000000))]
    (mkdir d)
    d))

(defn- rm-rf! [p]
  (os/sh "rm" "-rf" p))

;; ---------------------------------------------------------------------------
;; valid-name?
;; ---------------------------------------------------------------------------

(deftest valid-name-accepts-single-letter
  (is (= true (new/valid-name? "f"))))

(deftest valid-name-accepts-simple
  (is (= true (new/valid-name? "foo"))))

(deftest valid-name-accepts-hyphenated
  (is (= true (new/valid-name? "foo-bar"))))

(deftest valid-name-accepts-digits-after-letter
  (is (= true (new/valid-name? "f1")))
  (is (= true (new/valid-name? "foo123"))))

(deftest valid-name-rejects-uppercase
  (is (= false (new/valid-name? "Foo"))))

(deftest valid-name-rejects-leading-digit
  (is (= false (new/valid-name? "1foo"))))

(deftest valid-name-rejects-underscore
  (is (= false (new/valid-name? "foo_bar"))))

(deftest valid-name-rejects-slash
  (is (= false (new/valid-name? "foo/bar"))))

(deftest valid-name-rejects-dot
  (is (= false (new/valid-name? "foo.bar"))))

(deftest valid-name-rejects-empty
  (is (= false (new/valid-name? ""))))

(deftest valid-name-rejects-leading-hyphen
  (is (= false (new/valid-name? "-foo"))))

(deftest valid-name-rejects-nil
  (is (= false (new/valid-name? nil))))

;; ---------------------------------------------------------------------------
;; validate-name!
;; ---------------------------------------------------------------------------

(deftest validate-name-returns-input-on-success
  (is (= "foo-bar" (new/validate-name! "foo-bar"))))

(deftest validate-name-throws-on-invalid
  (is (= :invalid-name (caught-reason #(new/validate-name! "Foo"))))
  (is (= "Foo" (caught-name #(new/validate-name! "Foo")))))

(deftest validate-name-throws-on-nil
  (is (= :invalid-name (caught-reason #(new/validate-name! nil)))))

;; ---------------------------------------------------------------------------
;; name-pair
;; ---------------------------------------------------------------------------

(deftest name-pair-hyphenated
  (is (= {:hyphen "foo-bar" :underscore "foo_bar"}
         (new/name-pair "foo-bar"))))

(deftest name-pair-no-hyphen-noop
  (is (= {:hyphen "myapp" :underscore "myapp"}
         (new/name-pair "myapp"))))

(deftest name-pair-multiple-hyphens
  (is (= {:hyphen "a-b-c" :underscore "a_b_c"}
         (new/name-pair "a-b-c"))))

;; ---------------------------------------------------------------------------
;; substitute-contents
;; ---------------------------------------------------------------------------

(deftest substitute-contents-replaces-ns
  (is (= "(ns foo-bar.main)"
         (new/substitute-contents "(ns projectname.main)"
                                  {:hyphen "foo-bar"
                                   :underscore "foo_bar"}))))

(deftest substitute-contents-replaces-with-no-hyphen
  (is (= "before x after"
         (new/substitute-contents "before projectname after"
                                  {:hyphen "x"
                                   :underscore "x"}))))

(deftest substitute-contents-no-token-unchanged
  (is (= "no token here"
         (new/substitute-contents "no token here"
                                  {:hyphen "x"
                                   :underscore "x"}))))

(deftest substitute-contents-replaces-all
  (is (= "abc abc"
         (new/substitute-contents "projectname projectname"
                                  {:hyphen "abc"
                                   :underscore "abc"}))))

;; ---------------------------------------------------------------------------
;; substitute-path-segments
;; ---------------------------------------------------------------------------

(deftest substitute-path-segments-replaces-segment
  (is (= "src/foo_bar/greeter.lg"
         (new/substitute-path-segments "src/projectname/greeter.lg"
                                       {:hyphen "foo-bar"
                                        :underscore "foo_bar"}))))

(deftest substitute-path-segments-multiple-segments
  (is (= "y/y.lg"
         (new/substitute-path-segments "projectname/projectname.lg"
                                       {:hyphen "x"
                                        :underscore "y"}))))

(deftest substitute-path-segments-no-token-unchanged
  (is (= "src/nothing/here.lg"
         (new/substitute-path-segments "src/nothing/here.lg"
                                       {:hyphen "a"
                                        :underscore "b"}))))

;; ---------------------------------------------------------------------------
;; validate-target!
;; ---------------------------------------------------------------------------

(deftest validate-target-non-existent-returns-path
  (let [scratch (mktemp! "tgt-noexist")
        tgt (str scratch "/missing")]
    (is (= tgt (new/validate-target! tgt)))
    (rm-rf! scratch)))

(deftest validate-target-empty-dir-returns-path
  (let [scratch (mktemp! "tgt-empty")]
    (is (= scratch (new/validate-target! scratch)))
    (rm-rf! scratch)))

(deftest validate-target-non-empty-dir-throws
  (let [scratch (mktemp! "tgt-nonempty")
        _ (spit (str scratch "/file") "x")]
    (is (= :non-empty (caught-reason #(new/validate-target! scratch))))
    (is (= scratch (caught-path #(new/validate-target! scratch))))
    (rm-rf! scratch)))

(deftest validate-target-regular-file-throws
  (let [scratch (mktemp! "tgt-file")
        f (str scratch "/regular")
        _ (spit f "x")]
    (is (= :not-a-dir (caught-reason #(new/validate-target! f))))
    (is (= f (caught-path #(new/validate-target! f))))
    (rm-rf! scratch)))

;; ---------------------------------------------------------------------------
;; resolve-template-coord
;; ---------------------------------------------------------------------------

(deftest resolve-template-coord-defaults-when-unset
  (os/setenv "LGX_TEMPLATE_BASE_URL" "")
  (os/setenv "LGX_TEMPLATE_BASE_SHA" "")
  (is (= (get new/templates "base") (new/resolve-template-coord nil))))

(deftest resolve-template-coord-overrides-url
  (os/setenv "LGX_TEMPLATE_BASE_URL" "https://example.com/a/b")
  (os/setenv "LGX_TEMPLATE_BASE_SHA" "")
  (is (= {:git/url "https://example.com/a/b"
          :git/sha (:git/sha (get new/templates "base"))}
         (new/resolve-template-coord nil))))

(deftest resolve-template-coord-overrides-sha
  (os/setenv "LGX_TEMPLATE_BASE_URL" "")
  (os/setenv "LGX_TEMPLATE_BASE_SHA" "abc123")
  (is (= {:git/url (:git/url (get new/templates "base"))
          :git/sha "abc123"}
         (new/resolve-template-coord nil))))

(deftest resolve-template-coord-overrides-both
  (os/setenv "LGX_TEMPLATE_BASE_URL" "file:///tmp/x")
  (os/setenv "LGX_TEMPLATE_BASE_SHA" "deadbeef")
  (is (= {:git/url "file:///tmp/x"
          :git/sha "deadbeef"}
         (new/resolve-template-coord nil))))

(deftest resolve-template-coord-blank-treated-as-unset
  (os/setenv "LGX_TEMPLATE_BASE_URL" "   ")
  (os/setenv "LGX_TEMPLATE_BASE_SHA" "")
  (is (= (get new/templates "base") (new/resolve-template-coord nil))))

(deftest resolve-template-coord-base-name-honors-overrides
  (os/setenv "LGX_TEMPLATE_BASE_URL" "https://example.com/a/b")
  (os/setenv "LGX_TEMPLATE_BASE_SHA" "abc123")
  (is (= {:git/url "https://example.com/a/b"
          :git/sha "abc123"}
         (new/resolve-template-coord "base")))
  (os/setenv "LGX_TEMPLATE_BASE_URL" "")
  (os/setenv "LGX_TEMPLATE_BASE_SHA" ""))

(deftest resolve-template-coord-cli-returns-pinned
  (os/setenv "LGX_TEMPLATE_BASE_URL" "")
  (os/setenv "LGX_TEMPLATE_BASE_SHA" "")
  (is (= (get new/templates "cli") (new/resolve-template-coord "cli"))))

(deftest resolve-template-coord-lib-returns-pinned
  (os/setenv "LGX_TEMPLATE_BASE_URL" "")
  (os/setenv "LGX_TEMPLATE_BASE_SHA" "")
  (is (= (get new/templates "lib") (new/resolve-template-coord "lib")))
  ;; Assert the literal pin so a mistyped url/sha can't pass self-comparison.
  (is (= {:git/url "https://github.com/abogoyavlensky/lgx-template-lib"
          :git/sha "9206700b76e0729c5539ec70faacb3fc8e031431"}
         (new/resolve-template-coord "lib"))))

(deftest resolve-template-coord-unknown-name-throws
  (let [msg (try (new/resolve-template-coord "nope") nil
                 (catch e (ex-message e)))]
    (is (= true (str/includes? (str msg) "unknown template: nope")))
    (is (= true (str/includes? (str msg) "base, cli, lib")))))

;; ---------------------------------------------------------------------------
;; ensure-template!
;; ---------------------------------------------------------------------------

(defn- setup-fixture-repo! [tag]
  (let [dir (mktemp! (str "fixture-" tag))
        run (fn [& args] (apply os/sh args))]
    (spit (str dir "/hello.txt") "hi\n")
    (run "git" "-C" dir "init" "-q" "-b" "master")
    (run "git" "-C" dir "-c" "user.email=t@t" "-c" "user.name=t"
         "add" "-A")
    (run "git" "-C" dir "-c" "user.email=t@t" "-c" "user.name=t"
         "commit" "-q" "-m" "fixture")
    (let [sha (str/trim (:out (run "git" "-C" dir "rev-parse" "HEAD")))]
      {:dir dir
       :url (str "file://" dir)
       :sha sha})))

(deftest ensure-template-clones-then-reuses
  (let [home (mktemp! "ensure-home")
        _ (os/setenv "LGX_HOME" home)
        repo (setup-fixture-repo! "ensure")
        coord {:git/url (:url repo) :git/sha (:sha repo)}
        path1 (new/ensure-template! coord)]
    ;; First call clones; expected path mirrors cache.lg layout.
    (is (= (str home "/templates/_local/_/"
                (last (str/split (:dir repo) "/"))
                "/" (:sha repo))
           path1))
    (is (= true (file-exists? path1)))
    (is (= true (file-exists? (str path1 "/hello.txt"))))
    ;; .git/ dropped during finalize.
    (is (= false (file-exists? (str path1 "/.git"))))
    ;; Drop a sentinel into the cache. Second call must not re-clone, so
    ;; the sentinel must survive.
    (spit (str path1 "/sentinel") "x")
    (let [path2 (new/ensure-template! coord)]
      (is (= path1 path2))
      (is (= true (file-exists? (str path2 "/sentinel")))))
    (rm-rf! home)
    (rm-rf! (:dir repo))))

(deftest resolve-template-coord-url-resolves-head
  (let [repo (setup-fixture-repo! "head-url")]
    (is (= {:git/url (:url repo)
            :git/sha (:sha repo)}
           (new/resolve-template-coord (:url repo))))
    (rm-rf! (:dir repo))))

;; ---------------------------------------------------------------------------
;; walk-template + render!
;; ---------------------------------------------------------------------------

(defn- setup-template-tree! [tag]
  (let [src (mktemp! (str "src-" tag))]
    (spit (str src "/lgx.edn") "bin/projectname")
    (spit (str src "/main.lg") "(ns projectname.main)")
    (mkdir (str src "/src/projectname"))
    (spit (str src "/src/projectname/greeter.lg") "(ns projectname.greeter)")
    src))

(deftest walk-template-returns-sorted-paths
  (let [src (setup-template-tree! "walk")
        paths (new/walk-template src)]
    (is (= [(str src "/lgx.edn")
            (str src "/main.lg")
            (str src "/src/projectname/greeter.lg")]
           paths))
    (rm-rf! src)))

(deftest render-creates-target-and-substitutes
  (let [src (setup-template-tree! "render")
        tgt (str "/tmp/lgx-new-tgt-" (rand-int 100000000))]
    (new/render! src tgt (new/name-pair "foo-bar"))
    (is (= true (file-exists? tgt)))
    (is (= "bin/foo-bar" (slurp (str tgt "/lgx.edn"))))
    (is (= "(ns foo-bar.main)" (slurp (str tgt "/main.lg"))))
    (is (= true (file-exists? (str tgt "/src/foo_bar/greeter.lg"))))
    (is (= "(ns foo-bar.greeter)" (slurp (str tgt "/src/foo_bar/greeter.lg"))))
    (is (= false (file-exists? (str tgt "/src/projectname/greeter.lg"))))
    (rm-rf! src)
    (rm-rf! tgt)))

(deftest render-no-hyphen-input
  (let [src (setup-template-tree! "render-nohy")
        tgt (str "/tmp/lgx-new-tgt-" (rand-int 100000000))]
    (new/render! src tgt (new/name-pair "myapp"))
    (is (= true (file-exists? (str tgt "/src/myapp/greeter.lg"))))
    (is (= "(ns myapp.main)" (slurp (str tgt "/main.lg"))))
    (is (= "bin/myapp" (slurp (str tgt "/lgx.edn"))))
    (rm-rf! src)
    (rm-rf! tgt)))
