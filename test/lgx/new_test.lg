;; Unit tests for lgx.new.
;; Run with: lgx test  (from project root)

(ns lgx.new-test
  (:require [lgx.new :as new]
            [test :refer [deftest is]]))

(defn- caught-reason [f]
  (try (f) nil
       (catch e (:reason (ex-data e)))))

(defn- caught-name [f]
  (try (f) nil
       (catch e (:name (ex-data e)))))

(defn- caught-path [f]
  (try (f) nil
       (catch e (:path (ex-data e)))))

(defn- mktemp! [tag]
  (let [d (str "/tmp/lgx-new-" tag "-" (rand-int 100000000))]
    (mkdir d)
    d))

(defn- rm-rf! [p]
  (os/sh "rm" "-rf" p))

;; ---------------------------------------------------------------------------
;; valid-name?
;; ---------------------------------------------------------------------------

(deftest valid-name-accepts-single-letter
  (is (= true (new/valid-name? "f"))))

(deftest valid-name-accepts-simple
  (is (= true (new/valid-name? "foo"))))

(deftest valid-name-accepts-hyphenated
  (is (= true (new/valid-name? "foo-bar"))))

(deftest valid-name-accepts-digits-after-letter
  (is (= true (new/valid-name? "f1")))
  (is (= true (new/valid-name? "foo123"))))

(deftest valid-name-rejects-uppercase
  (is (= false (new/valid-name? "Foo"))))

(deftest valid-name-rejects-leading-digit
  (is (= false (new/valid-name? "1foo"))))

(deftest valid-name-rejects-underscore
  (is (= false (new/valid-name? "foo_bar"))))

(deftest valid-name-rejects-slash
  (is (= false (new/valid-name? "foo/bar"))))

(deftest valid-name-rejects-dot
  (is (= false (new/valid-name? "foo.bar"))))

(deftest valid-name-rejects-empty
  (is (= false (new/valid-name? ""))))

(deftest valid-name-rejects-leading-hyphen
  (is (= false (new/valid-name? "-foo"))))

(deftest valid-name-rejects-nil
  (is (= false (new/valid-name? nil))))

;; ---------------------------------------------------------------------------
;; validate-name!
;; ---------------------------------------------------------------------------

(deftest validate-name-returns-input-on-success
  (is (= "foo-bar" (new/validate-name! "foo-bar"))))

(deftest validate-name-throws-on-invalid
  (is (= :invalid-name (caught-reason #(new/validate-name! "Foo"))))
  (is (= "Foo" (caught-name #(new/validate-name! "Foo")))))

(deftest validate-name-throws-on-nil
  (is (= :invalid-name (caught-reason #(new/validate-name! nil)))))

;; ---------------------------------------------------------------------------
;; name-pair
;; ---------------------------------------------------------------------------

(deftest name-pair-hyphenated
  (is (= {:hyphen "foo-bar" :underscore "foo_bar"}
         (new/name-pair "foo-bar"))))

(deftest name-pair-no-hyphen-noop
  (is (= {:hyphen "myapp" :underscore "myapp"}
         (new/name-pair "myapp"))))

(deftest name-pair-multiple-hyphens
  (is (= {:hyphen "a-b-c" :underscore "a_b_c"}
         (new/name-pair "a-b-c"))))

;; ---------------------------------------------------------------------------
;; substitute-contents
;; ---------------------------------------------------------------------------

(deftest substitute-contents-replaces-ns
  (is (= "(ns foo-bar.main)"
         (new/substitute-contents "(ns projectname.main)"
                                  {:hyphen "foo-bar"
                                   :underscore "foo_bar"}))))

(deftest substitute-contents-replaces-with-no-hyphen
  (is (= "before x after"
         (new/substitute-contents "before projectname after"
                                  {:hyphen "x"
                                   :underscore "x"}))))

(deftest substitute-contents-no-token-unchanged
  (is (= "no token here"
         (new/substitute-contents "no token here"
                                  {:hyphen "x"
                                   :underscore "x"}))))

(deftest substitute-contents-replaces-all
  (is (= "abc abc"
         (new/substitute-contents "projectname projectname"
                                  {:hyphen "abc"
                                   :underscore "abc"}))))

;; ---------------------------------------------------------------------------
;; substitute-path-segments
;; ---------------------------------------------------------------------------

(deftest substitute-path-segments-replaces-segment
  (is (= "src/foo_bar/greeter.lg"
         (new/substitute-path-segments "src/projectname/greeter.lg"
                                       {:hyphen "foo-bar"
                                        :underscore "foo_bar"}))))

(deftest substitute-path-segments-multiple-segments
  (is (= "y/y.lg"
         (new/substitute-path-segments "projectname/projectname.lg"
                                       {:hyphen "x"
                                        :underscore "y"}))))

(deftest substitute-path-segments-no-token-unchanged
  (is (= "src/nothing/here.lg"
         (new/substitute-path-segments "src/nothing/here.lg"
                                       {:hyphen "a"
                                        :underscore "b"}))))

;; ---------------------------------------------------------------------------
;; validate-target!
;; ---------------------------------------------------------------------------

(deftest validate-target-non-existent-returns-path
  (let [scratch (mktemp! "tgt-noexist")
        tgt (str scratch "/missing")]
    (is (= tgt (new/validate-target! tgt)))
    (rm-rf! scratch)))

(deftest validate-target-empty-dir-returns-path
  (let [scratch (mktemp! "tgt-empty")]
    (is (= scratch (new/validate-target! scratch)))
    (rm-rf! scratch)))

(deftest validate-target-non-empty-dir-throws
  (let [scratch (mktemp! "tgt-nonempty")
        _ (spit (str scratch "/file") "x")]
    (is (= :non-empty (caught-reason #(new/validate-target! scratch))))
    (is (= scratch (caught-path #(new/validate-target! scratch))))
    (rm-rf! scratch)))

(deftest validate-target-regular-file-throws
  (let [scratch (mktemp! "tgt-file")
        f (str scratch "/regular")
        _ (spit f "x")]
    (is (= :not-a-dir (caught-reason #(new/validate-target! f))))
    (is (= f (caught-path #(new/validate-target! f))))
    (rm-rf! scratch)))
