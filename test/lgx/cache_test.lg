;; Unit tests for lgx.cache — URL parsing, coord-dir, cached path of ensure-lib!.
;; Run with: lgx test  (from project root)

(ns lgx.cache-test
  (:require [lgx.cache :as cache]
            [string :as str]
            [clojure.test :refer [deftest is]]))

(defn- threw? [f]
  (try (f) :no-throw (catch e :threw)))

;; ---------------------------------------------------------------------------
;; parse-git-url
;; ---------------------------------------------------------------------------

(deftest parse-git-url-https-plain
  (is (= ["github.com" "nooga" "let-go"]
         (cache/parse-git-url "https://github.com/nooga/let-go"))))

(deftest parse-git-url-strips-dotgit
  (is (= ["github.com" "nooga" "let-go"]
         (cache/parse-git-url "https://github.com/nooga/let-go.git"))))

(deftest parse-git-url-accepts-http-scheme
  (is (= ["example.com" "owner" "repo"]
         (cache/parse-git-url "http://example.com/owner/repo"))))

(deftest parse-git-url-file-uri-derives-local-host
  (is (= ["_local" "_" "foo"]
         (cache/parse-git-url "file:///tmp/foo.git")))
  (is (= ["_local" "_" "bar"]
         (cache/parse-git-url "file:///tmp/lgx-test/bar"))))

(deftest parse-git-url-rejects-ssh-form
  (is (= :threw (threw? #(cache/parse-git-url "git@github.com:owner/repo.git")))))

(deftest parse-git-url-rejects-malformed
  (is (= :threw (threw? #(cache/parse-git-url "not-a-url"))))
  (is (= :threw (threw? #(cache/parse-git-url "https://only-host")))))

;; ---------------------------------------------------------------------------
;; coord-dir
;; ---------------------------------------------------------------------------

(deftest coord-dir-assembles-path
  (os/setenv "LGX_HOME" "/tmp/lgx-cache-test-home")
  (is (= "/tmp/lgx-cache-test-home/gitlibs/github.com/nooga/let-go/abc123"
         (cache/coord-dir "https://github.com/nooga/let-go" "abc123"))))

(deftest coord-dir-handles-dotgit-and-file-uri
  (os/setenv "LGX_HOME" "/tmp/lgx-cache-test-home")
  (is (= "/tmp/lgx-cache-test-home/gitlibs/github.com/nooga/let-go/sha1"
         (cache/coord-dir "https://github.com/nooga/let-go.git" "sha1")))
  (is (= "/tmp/lgx-cache-test-home/gitlibs/_local/_/myrepo/sha2"
         (cache/coord-dir "file:///tmp/scratch/myrepo.git" "sha2"))))

;; ---------------------------------------------------------------------------
;; ensure-lib! cached path
;; ---------------------------------------------------------------------------

(deftest ensure-lib-returns-installed-false-when-cached
  (let [home (str "/tmp/lgx-ensure-test-" (rand-int 100000000))
        sha "0000000000000000000000000000000000000000"
        url "https://github.com/example/cached"
        dir (str home "/gitlibs/github.com/example/cached/" sha)
        src-dir (str dir "/src")]
    (os/setenv "LGX_HOME" home)
    (mkdir src-dir)
    (is (= {:path src-dir
            :installed? false
            :dir dir}
           (cache/ensure-lib! {:git/url url
                               :git/sha sha}
                              "/tmp/project")))
    ;; Cleanup
    (os/sh "rm" "-rf" home)))

(deftest ensure-lib-returns-installed-false-when-cached-no-src
  (let [home (str "/tmp/lgx-ensure-test-" (rand-int 100000000))
        sha "1111111111111111111111111111111111111111"
        url "https://github.com/example/nosrc"
        dir (str home "/gitlibs/github.com/example/nosrc/" sha)]
    (os/setenv "LGX_HOME" home)
    (mkdir dir)
    (is (= {:path dir
            :installed? false
            :dir dir}
           (cache/ensure-lib! {:git/url url
                               :git/sha sha}
                              "/tmp/project")))
    (os/sh "rm" "-rf" home)))

(deftest ensure-lib-caches-tag-by-name
  (let [home (str "/tmp/lgx-ensure-test-" (rand-int 100000000))
        tag "v1.0.0"
        url "file:///tmp/lgx-missing-tag-repo"
        dir (str home "/gitlibs/_local/_/lgx-missing-tag-repo/" tag)
        src-dir (str dir "/src")]
    (os/setenv "LGX_HOME" home)
    (mkdir src-dir)
    (is (= {:path src-dir
            :installed? false
            :dir dir}
           (cache/ensure-lib! {:git/url url
                               :git/tag tag}
                              "/tmp/project")))
    (os/sh "rm" "-rf" home)))

(deftest ensure-lib-sanitizes-slash-in-tag
  (let [home (str "/tmp/lgx-ensure-test-" (rand-int 100000000))
        tag "release/1.0"
        url "file:///tmp/lgx-missing-release-repo"
        dir (str home "/gitlibs/_local/_/lgx-missing-release-repo/release_1.0")]
    (os/setenv "LGX_HOME" home)
    (mkdir dir)
    (is (= {:path dir
            :installed? false
            :dir dir}
           (cache/ensure-lib! {:git/url url
                               :git/tag tag}
                              "/tmp/project")))
    (os/sh "rm" "-rf" home)))

(deftest ensure-lib-uses-deps-root-when-set
  (let [home (str "/tmp/lgx-ensure-test-" (rand-int 100000000))
        sha "2222222222222222222222222222222222222222"
        url "https://github.com/example/customroot"
        dir (str home "/gitlibs/github.com/example/customroot/" sha)
        root-dir (str dir "/src/main/clojure")]
    (os/setenv "LGX_HOME" home)
    (mkdir root-dir)
    (is (= {:path root-dir
            :installed? false
            :dir dir}
           (cache/ensure-lib! {:git/url url
                               :git/sha sha
                               :deps/root "src/main/clojure"}
                              "/tmp/project")))
    (os/sh "rm" "-rf" home)))

(deftest ensure-lib-throws-when-deps-root-missing
  (let [home (str "/tmp/lgx-ensure-test-" (rand-int 100000000))
        sha "3333333333333333333333333333333333333333"
        url "https://github.com/example/missingroot"
        dir (str home "/gitlibs/github.com/example/missingroot/" sha)]
    (os/setenv "LGX_HOME" home)
    (mkdir dir)
    (is (= :threw (threw? #(cache/ensure-lib! {:git/url url
                                               :git/sha sha
                                               :deps/root "nope/missing"}
                                              "/tmp/project"))))
    (os/sh "rm" "-rf" home)))

(deftest ensure-lib-normalizes-trailing-slash
  (let [home (str "/tmp/lgx-ensure-test-" (rand-int 100000000))
        sha "4444444444444444444444444444444444444444"
        url "https://github.com/example/trailing"
        dir (str home "/gitlibs/github.com/example/trailing/" sha)
        root-dir (str dir "/lib/core")]
    (os/setenv "LGX_HOME" home)
    (mkdir root-dir)
    (is (= {:path root-dir
            :installed? false
            :dir dir}
           (cache/ensure-lib! {:git/url url
                               :git/sha sha
                               :deps/root "lib/core/"}
                              "/tmp/project")))
    (is (= {:path root-dir
            :installed? false
            :dir dir}
           (cache/ensure-lib! {:git/url url
                               :git/sha sha
                               :deps/root "lib/core"}
                              "/tmp/project")))
    (os/sh "rm" "-rf" home)))

(deftest ensure-lib-resolves-relative-local-root
  (let [project (str "/tmp/lgx-local-test-" (rand-int 100000000))
        src-dir (str project "/lib/src")]
    (mkdir src-dir)
    (is (= {:path src-dir
            :installed? false
            :dir (str project "/lib")}
           (cache/ensure-lib! {:local/root "lib"} project)))
    (os/sh "rm" "-rf" project)))

(deftest ensure-lib-resolves-absolute-local-root
  (let [dir (str "/tmp/lgx-abs-local-test-" (rand-int 100000000))
        src-dir (str dir "/src")]
    (mkdir src-dir)
    (is (= {:path src-dir
            :installed? false
            :dir dir}
           (cache/ensure-lib! {:local/root dir} "/tmp/project")))
    (os/sh "rm" "-rf" dir)))

(deftest ensure-lib-applies-deps-root-on-local
  (let [project (str "/tmp/lgx-local-root-test-" (rand-int 100000000))
        root-dir (str project "/lib/src/main")]
    (mkdir root-dir)
    (is (= {:path root-dir
            :installed? false
            :dir (str project "/lib")}
           (cache/ensure-lib! {:local/root "lib"
                               :deps/root "src/main"}
                              project)))
    (os/sh "rm" "-rf" project)))

(deftest ensure-lib-local-throws-when-base-missing
  (let [project (str "/tmp/lgx-local-missing-test-" (rand-int 100000000))]
    (is (= :threw (threw? #(cache/ensure-lib! {:local/root "./nope"}
                                              project))))))

(deftest ensure-lib-local-throws-when-deps-root-missing
  (let [project (str "/tmp/lgx-local-missing-root-test-" (rand-int 100000000))
        dir (str project "/lib")]
    (mkdir dir)
    (is (= :threw (threw? #(cache/ensure-lib! {:local/root "lib"
                                               :deps/root "nope/missing"}
                                              project))))
    (os/sh "rm" "-rf" project)))

(deftest ensure-lib-local-uses-dir-when-no-src
  (let [project (str "/tmp/lgx-local-nosrc-test-" (rand-int 100000000))
        dir (str project "/lib")]
    (mkdir dir)
    (is (= {:path dir
            :installed? false
            :dir dir}
           (cache/ensure-lib! {:local/root "lib"} project)))
    (os/sh "rm" "-rf" project)))

;; ---------------------------------------------------------------------------
;; resolve-head-sha!
;; ---------------------------------------------------------------------------

(defn- setup-fixture-repo! []
  (let [dir (str "/tmp/lgx-head-sha-test-" (rand-int 100000000))
        run (fn [& args] (apply os/sh args))]
    (mkdir dir)
    (spit (str dir "/hello.txt") "hi\n")
    (run "git" "-C" dir "init" "-q" "-b" "master")
    (run "git" "-C" dir "-c" "user.email=t@t" "-c" "user.name=t"
         "add" "-A")
    (run "git" "-C" dir "-c" "user.email=t@t" "-c" "user.name=t"
         "commit" "-q" "-m" "fixture")
    (let [sha (str/trim (:out (run "git" "-C" dir "rev-parse" "HEAD")))]
      {:dir dir
       :sha sha})))

(deftest resolve-head-sha-returns-head-of-fixture
  (let [{:keys [dir sha]} (setup-fixture-repo!)]
    (is (= sha (cache/resolve-head-sha! (str "file://" dir))))
    (os/sh "rm" "-rf" dir)))

(deftest resolve-head-sha-throws-on-missing-repo
  (is (= :threw (threw? #(cache/resolve-head-sha! "file:///nonexistent/repo")))))

