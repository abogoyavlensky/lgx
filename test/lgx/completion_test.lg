;; Unit tests for lgx.completion — pure TAB-completion candidate logic.
;; Run with: lgx test  (from project root)

(ns lgx.completion-test
  (:require [lgx.completion :as completion]
            [lgx.config :as config]
            [string :as str]
            [clojure.test :refer [deftest is]]))

(def ^:private builtins
  ["build" "help" "install" "new" "nrepl" "run" "test" "version"])

;; Tasks map as complete! builds it: task-name string → :args decls (or nil).
(def ^:private deploy-tasks
  {"deploy" [{:name :env :type [:enum "staging" "prod"]}
             {:name :mode :type [:enum "fast" "full"] :default "fast"}
             {:name :count :type :int}
             {:name :note}]})

;; ---------------------------------------------------------------------------
;; candidates — command position
;; ---------------------------------------------------------------------------

(deftest all-commands-at-empty-prompt
  (is (= (vec (sort (concat builtins ["fmt" "lint"])))
         (completion/candidates [] "" {"fmt" nil "lint" nil}))))

(deftest builtins-only-without-tasks
  (is (= builtins (completion/candidates [] "" {}))))

(deftest prefix-filters-run
  (is (= ["run"] (completion/candidates [] "ru" {}))))

(deftest prefix-filters-test
  (is (= ["test"] (completion/candidates [] "te" {}))))

(deftest namespaced-task-name-offered
  (is (= ["foo/bar"] (completion/candidates [] "foo" {"foo/bar" nil}))))

(deftest hidden-commands-absent
  (let [cs (completion/candidates [] "" {})]
    (is (= [] (filterv #(= "completion" %) cs)))
    (is (= [] (filterv #(= "__complete" %) cs)))))

;; ---------------------------------------------------------------------------
;; candidates — leading global flags before the command
;; ---------------------------------------------------------------------------

(deftest verbose-prefix-still-completes
  (is (= ["run"] (completion/candidates ["--verbose"] "ru" {}))))

(deftest with-and-value-still-completes
  (is (= ["run"] (completion/candidates ["--with" "dev"] "ru" {}))))

(deftest unknown-flag-token-skipped
  ;; A stray -v / --foo is not mistaken for a command.
  (is (= ["run"] (completion/candidates ["--foo"] "ru" {})))
  (is (= ["run"] (completion/candidates ["-v"] "ru" {}))))

(deftest cursor-on-with-value-offers-nothing
  (is (= [] (completion/candidates ["--with"] "" {}))))

;; ---------------------------------------------------------------------------
;; candidates — nothing after the command or on flags
;; ---------------------------------------------------------------------------

(deftest nothing-after-command
  (is (= [] (completion/candidates ["run"] "" {}))))

(deftest nothing-after-flags-and-command
  (is (= [] (completion/candidates ["--verbose" "build"] "" {}))))

(deftest nothing-after-task-command
  (is (= [] (completion/candidates ["fmt"] "" {"fmt" nil}))))

(deftest nothing-for-flag-cursor
  (is (= [] (completion/candidates [] "-" {})))
  (is (= [] (completion/candidates [] "--" {}))))

;; ---------------------------------------------------------------------------
;; candidates — enum values at task arg positions
;; ---------------------------------------------------------------------------

(deftest enum-values-at-first-arg
  (is (= ["prod" "staging"]
         (completion/candidates ["deploy"] "" deploy-tasks))))

(deftest enum-values-prefix-filtered
  (is (= ["staging"]
         (completion/candidates ["deploy"] "st" deploy-tasks))))

(deftest defaulted-enum-at-second-arg
  (is (= ["fast" "full"]
         (completion/candidates ["deploy" "prod"] "" deploy-tasks))))

(deftest int-arg-offers-nothing
  (is (= [] (completion/candidates ["deploy" "prod" "fast"] "" deploy-tasks))))

(deftest string-arg-offers-nothing
  (is (= [] (completion/candidates ["deploy" "prod" "fast" "3"] "" deploy-tasks))))

(deftest past-last-arg-offers-nothing
  (is (= [] (completion/candidates ["deploy" "prod" "fast" "3" "hi"] ""
                                   deploy-tasks))))

(deftest global-flags-do-not-shift-arg-positions
  (is (= ["prod" "staging"]
         (completion/candidates ["--verbose" "--with" "dev" "deploy"] ""
                                deploy-tasks))))

(deftest enum-flag-cursor-offers-nothing
  (is (= [] (completion/candidates ["deploy"] "-" deploy-tasks))))

(deftest builtin-args-offer-nothing
  (is (= [] (completion/candidates ["run"] "" deploy-tasks))))

(deftest unknown-command-args-offer-nothing
  (is (= [] (completion/candidates ["mystery"] "" deploy-tasks))))

;; ---------------------------------------------------------------------------
;; completion-script — the bundled shell scripts
;; ---------------------------------------------------------------------------

(deftest bash-script-registers-completion
  (let [s (completion/completion-script "bash")]
    (is (str/includes? s "__complete"))
    (is (str/includes? s "complete -o default"))))

(deftest zsh-script-registers-completion
  (let [s (completion/completion-script "zsh")]
    (is (str/includes? s "__complete"))
    (is (str/includes? s "#compdef lgx"))))

(deftest fish-script-registers-completion
  (let [s (completion/completion-script "fish")]
    (is (str/includes? s "__complete"))
    (is (str/includes? s "complete -c lgx"))))

(deftest unknown-shell-has-no-script
  (is (nil? (completion/completion-script "nope"))))

;; ---------------------------------------------------------------------------
;; reserved task names — tasks may not shadow the completion commands
;; ---------------------------------------------------------------------------

(deftest completion-commands-reserved
  (is (contains? config/reserved-task-names "completion"))
  (is (contains? config/reserved-task-names "__complete")))
