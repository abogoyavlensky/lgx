;; Unit tests for lgx.test-runner.
;; Run with: lgx test  (from project root)

(ns lgx.test-runner-test
  (:require [edn :as edn]
            [lgx.path :as path]
            [lgx.test-runner :as tr]
            [string :as str]
            [clojure.test :refer [deftest is]]))

(def sep os/file-separator)

(defn- threw? [f]
  (try (f) :no-throw (catch _ :threw)))

(def fixture-dir
  (path/join (os/cwd) "tests" "fixtures" "sample-tests"))

;; ---------------------------------------------------------------------------
;; path->ns
;; ---------------------------------------------------------------------------

(deftest path-ns-happy-path
  (is (= 'foo-test
         (tr/path->ns "test" (path/join "test" "foo_test.lg")))))

(deftest path-ns-nested
  (is (= 'lgx.config-test
         (tr/path->ns "test"
                      (path/join "test" "lgx" "config_test.lg")))))

(deftest path-ns-cljc-extension
  (is (= 'foo-test
         (tr/path->ns "test" (path/join "test" "foo_test.cljc")))))

(deftest path-ns-clj-extension
  (is (= 'foo-test
         (tr/path->ns "test" (path/join "test" "foo_test.clj")))))

(deftest path-ns-clj-nested
  (is (= 'lgx.config-test
         (tr/path->ns "test"
                      (path/join "test" "lgx" "config_test.clj")))))

(deftest path-ns-absolute-test-dir
  (is (= 'foo.bar-test
         (tr/path->ns (path/join sep "abs" "test")
                      (path/join sep "abs" "test" "foo" "bar_test.lg")))))

(deftest test-entry-includes-display-file-and-ns
  (is (= [(path/join "test" "lgx" "config_test.lg") 'lgx.config-test]
         (tr/test-entry "test"
                        (path/join "test" "lgx" "config_test.lg")))))

;; ---------------------------------------------------------------------------
;; exclude-entries
;; ---------------------------------------------------------------------------

(def ^:private ab-entries
  [["test/a_test.lg" 'a-test] ["test/b_test.lg" 'b-test]])

(deftest exclude-nothing-keeps-every-entry
  (is (= {:entries ab-entries :unmatched []}
         (tr/exclude-entries ab-entries []))))

(deftest exclude-one-match-drops-it-and-keeps-order
  (is (= {:entries [["test/a_test.lg" 'a-test]] :unmatched []}
         (tr/exclude-entries ab-entries ['b-test])))
  (is (= {:entries [["test/b_test.lg" 'b-test]] :unmatched []}
         (tr/exclude-entries ab-entries ['a-test]))))

(deftest exclude-unmatched-name-is-reported-entries-untouched
  (is (= {:entries ab-entries :unmatched ['nope-test]}
         (tr/exclude-entries ab-entries ['nope-test]))))

(deftest exclude-mixed-reports-only-the-unmatched
  (is (= {:entries [["test/b_test.lg" 'b-test]] :unmatched ['nope-test]}
         (tr/exclude-entries ab-entries ['a-test 'nope-test]))))

(deftest exclude-several-unmatched-keep-given-order
  (is (= ['z-test 'y-test]
         (:unmatched (tr/exclude-entries ab-entries ['z-test 'a-test 'y-test])))))

(deftest exclude-duplicate-name-drops-once-and-matches
  (is (= {:entries [["test/b_test.lg" 'b-test]] :unmatched []}
         (tr/exclude-entries ab-entries ['a-test 'a-test]))))

(deftest exclude-on-empty-entries-reports-every-name
  (is (= {:entries [] :unmatched ['a-test 'b-test]}
         (tr/exclude-entries [] ['a-test 'b-test]))))

(deftest exclude-everything-yields-empty-entries
  (is (= {:entries [] :unmatched []}
         (tr/exclude-entries ab-entries ['a-test 'b-test]))))

(deftest exclude-returns-vectors
  (let [r (tr/exclude-entries ab-entries ['a-test 'nope-test])]
    (is (vector? (:entries r)))
    (is (vector? (:unmatched r)))))

;; ---------------------------------------------------------------------------
;; discover-test-files
;; ---------------------------------------------------------------------------

(deftest discover-finds-lg-and-cljc
  (let [files (tr/discover-test-files fixture-dir)]
    (is (some #(str/ends-with? % "alpha_test.lg") files))
    (is (some #(str/ends-with? % "beta_test.cljc") files))))

(deftest discover-finds-clj
  (let [files (tr/discover-test-files fixture-dir)]
    (is (some #(str/ends-with? % "delta_test.clj") files))))

(deftest discover-ignores-non-test-files
  (let [files (tr/discover-test-files fixture-dir)]
    (is (not (some #(str/ends-with? % "helpers.lg") files)))))

(deftest discover-recurses
  (let [files (tr/discover-test-files fixture-dir)]
    (is (some #(str/ends-with? % (path/join "nested" "gamma_test.lg"))
              files))))

(deftest discover-returns-sorted-vector
  (let [files (tr/discover-test-files fixture-dir)]
    (is (vector? files))
    (is (= files (vec (sort files))))))

(deftest discover-missing-dir-throws
  (is (= :threw
         (threw? #(tr/discover-test-files
                    (path/join fixture-dir "no-such-subdir"))))))

;; ---------------------------------------------------------------------------
;; harness-sources
;; ---------------------------------------------------------------------------

(defn- parses? [s]
  ;; Wrap in (do ...) so the reader consumes the whole source as one form;
  ;; otherwise read-string only returns the first top-level form.
  (try (edn/read-string (str "(do " s ")"))
       true
       (catch _ false)))

(def entry-file "harness.lg")
(def ui-file (path/join "lgx" "test_harness" "ui.lg"))
(def legacy-file (path/join "lgx" "test_harness" "legacy.lg"))
(def report-file (path/join "lgx" "test_harness" "report.lg"))

(defn- entry-src [entries] (get (tr/harness-sources entries) entry-file))

(defn- ns-form
  "A generated file's (ns ...) form: everything before the first blank
   line, which is where the body starts."
  [src]
  (first (str/split src "\n\n")))

(defn- before?
  "True if needle a occurs in src before needle b, and both occur."
  [src a b]
  (let [ia (str/index-of src a)
        ib (str/index-of src b)]
    (and (some? ia) (some? ib) (< ia ib))))

(deftest harness-sources-has-exactly-the-four-files
  (let [srcs (tr/harness-sources [])]
    (is (= #{entry-file ui-file legacy-file report-file} (set (keys srcs))))
    (doseq [[f src] srcs]
      (is (string? src) f)
      (is (parses? src) f))))

(deftest harness-sources-entry-empty-ns-list-parses
  (let [src (entry-src [])]
    (is (str/includes? src "(ns lgx.test-harness"))
    (is (str/includes? src "[os :as os]"))
    (is (str/includes? src "(os/exit"))))

(deftest harness-sources-entry-dispatches-at-run-time
  ;; The two run-phase variants read different let-go test internals, and a
  ;; dead branch still has to compile, so the entry must not name either
  ;; variant's symbols: it picks one by resolve and loads it by require.
  (let [src (entry-src [["test/foo_test.lg" 'foo-test]])]
    (is (str/includes? src "(resolve 'test/test-ns)"))
    (is (str/includes? src "(require 'lgx.test-harness.report)"))
    (is (str/includes? src "(require 'lgx.test-harness.legacy)"))
    (is (not (str/includes? src "*registered-tests*")))
    (is (not (str/includes? src "[test :refer")))
    (is (not (str/includes? src "(the-ns")))))

(deftest harness-sources-variants-define-run
  (let [srcs (tr/harness-sources [])
        legacy (get srcs legacy-file)
        report (get srcs report-file)]
    (is (str/includes? legacy "(ns lgx.test-harness.legacy"))
    (is (str/includes? legacy "*registered-tests*"))
    (is (str/includes? legacy "(defn run!"))
    (is (str/includes? report "(ns lgx.test-harness.report"))
    (is (str/includes? report "(defn run!"))
    (is (str/includes? (get srcs ui-file) "(ns lgx.test-harness.ui"))))

(deftest harness-sources-entry-includes-each-ns
  (let [src (entry-src [[(path/join "test" "lgx" "config_test.lg")
                         'lgx.config-test]
                        [(path/join "test" "lgx" "path_test.lg")
                         'lgx.path-test]])]
    ;; Test namespaces reach the harness through the test plan, which the
    ;; load phase requires one at a time. They must NOT be in the ns form:
    ;; there, one file that fails to compile takes the whole harness down.
    (is (str/includes? src "'lgx.config-test"))
    (is (str/includes? src "'lgx.path-test"))
    (is (str/includes? src (pr-str (path/join "test" "lgx" "config_test.lg"))))
    (is (str/includes? src (pr-str (path/join "test" "lgx" "path_test.lg"))))
    (is (not (str/includes? (ns-form src) "lgx.config-test")))
    (is (not (str/includes? (ns-form src) "lgx.path-test")))))

(deftest harness-sources-load-phase-is-guarded-and-precedes-the-marker
  (let [src (entry-src [["test/foo_test.lg" 'foo-test]])]
    (is (str/includes? src "(def load-failures"))
    (is (str/includes? src "(try (require"))
    (is (str/includes? src "(catch e"))
    ;; The marker still means "the load phase finished", so it has to come
    ;; after every require, not before.
    (is (before? src "(def load-failures" tr/harness-ready-marker))
    (is (before? src "(try (require" tr/harness-ready-marker))))

(deftest harness-sources-reports-load-failures-after-the-marker
  ;; Collected before the marker (the load phase), reported after it — a
  ;; report emitted before the marker would look like a load diagnostic.
  (let [src (entry-src [["test/foo_test.lg" 'foo-test]])
        after-marker (second (str/split src tr/harness-ready-marker))]
    (is (before? src "(def load-failures" tr/harness-ready-marker))
    (is (str/includes? after-marker "load-failures"))
    (is (str/includes? after-marker "failed to load"))))

(deftest harness-sources-run-phase-skips-namespaces-that-failed-to-load
  ;; the-ns throws for a namespace that never loaded, so the entry hands the
  ;; variants only the entries absent from the failure set, and the
  ;; variants are where the-ns is called.
  (let [srcs (tr/harness-sources [["test/foo_test.lg" 'foo-test]])
        entry (get srcs entry-file)]
    (is (str/includes? entry "(def failed-namespaces"))
    (is (str/includes? entry "(contains? failed-namespaces"))
    (is (before? entry "(contains? failed-namespaces" "runnable-plan)"))
    (is (str/includes? (get srcs legacy-file) "(the-ns"))
    (is (str/includes? (get srcs report-file) "(the-ns"))))

(deftest harness-sources-entry-emits-ready-marker
  (let [src (entry-src [["test/foo_test.lg" 'foo-test]])]
    (is (str/includes? src (str "(write! *err* \"" tr/harness-ready-marker)))))

(deftest harness-dir-is-per-version
  (is (str/ends-with? (tr/harness-dir "9.9.9") "lgx-test-9.9.9")))
