;; Unit tests for lgx.native — the pure half of `:target :native`: walking the
;; namespace graph from :main, the entry checks, the `lg compile` argv, and the
;; capability probe's predicate. The real build is covered by tests/e2e.sh.
;; Run with: lgx test  (from project root)

(ns lgx.native-test
  (:require [lgx.native :as native]
            [clojure.test :refer [deftest is]]))

;; ---------------------------------------------------------------------------
;; ns-form-libs
;; ---------------------------------------------------------------------------

(deftest ns-form-libs-reads-require-and-use
  (is (= '[c.d h.i e.f e.g j.k]
         (native/ns-form-libs
           '(ns a.b "doc" {:x 1}
              (:require [c.d :as d] h.i (e f [g :as gg]))
              (:use j.k))))))

(deftest ns-form-libs-reads-a-vector-prefix-list
  (is (= '[e.f e.g x.y]
         (native/ns-form-libs '(ns a (:require [e f [g :as gg]] [x.y]))))))

(deftest ns-form-libs-ignores-other-clauses
  (is (= '[c.d]
         (native/ns-form-libs '(ns a
                                 (:require-macros [m.n])
                                 (:import [java.util Date])
                                 (:require [c.d :refer [x]]))))))

(deftest ns-form-libs-is-empty-for-a-non-ns-form
  (is (= [] (native/ns-form-libs '(println "hi"))))
  (is (= [] (native/ns-form-libs nil))))

;; ---------------------------------------------------------------------------
;; lib-candidates
;; ---------------------------------------------------------------------------

(deftest lib-candidates-follow-the-resolver-order
  (is (= ["a/b-c.lg" "a/b_c.lg" "a/b-c.cljc" "a/b_c.cljc" "a/b-c.clj" "a/b_c.clj"]
         (native/lib-candidates 'a.b-c))))

;; ---------------------------------------------------------------------------
;; reachable-lg-files
;; ---------------------------------------------------------------------------

(defn- walk
  "Run reachable-lg-files over an in-memory {path form} map."
  [roots main files]
  (native/reachable-lg-files {:roots roots
                              :main main
                              :read-first-form (fn [p] (get files p))
                              :file? (fn [p] (contains? files p))}))

(deftest walk-follows-app-to-dep-across-roots
  (let [files {"/p/main.lg" '(ns app.core (:require [app.util :as u]))
               "/p/src/app/util.lg" '(ns app.util (:require [dep.core]))
               "/d/src/dep/core.lg" '(ns dep.core (:require [clojure.string :as str]))}]
    (is (= {:files ["/p/main.lg" "/p/src/app/util.lg" "/d/src/dep/core.lg"]
            :skipped []}
           (walk ["/p/src" "/d/src"] "/p/main.lg" files)))))

(deftest walk-first-root-wins-even-for-cljc
  (let [files {"/p/main.lg" '(ns app.core (:require [x.y]))
               "/r1/x/y.cljc" '(ns x.y)
               "/r2/x/y.lg" '(ns x.y)}]
    (is (= ["/p/main.lg"]
           (:files (walk ["/r1" "/r2"] "/p/main.lg" files))))))

(deftest walk-prefers-hyphen-then-lg-within-a-root
  (let [files {"/p/main.lg" '(ns app.core (:require [a.b-c] [d.e]))
               "/r/a/b-c.lg" '(ns a.b-c)
               "/r/a/b_c.lg" '(ns a.b-c)
               "/r/d/e.lg" '(ns d.e)
               "/r/d/e.cljc" '(ns d.e)}]
    (is (= ["/p/main.lg" "/r/a/b-c.lg" "/r/d/e.lg"]
           (:files (walk ["/r"] "/p/main.lg" files))))))

(deftest walk-traverses-cljc-but-lowers-only-lg
  (let [files {"/p/main.lg" '(ns app.core (:require [bridge]))
               "/r/bridge.cljc" '(ns bridge (:require [dep.core]))
               "/r/dep/core.lg" '(ns dep.core)}]
    (is (= ["/p/main.lg" "/r/dep/core.lg"]
           (:files (walk ["/r"] "/p/main.lg" files))))))

(deftest walk-terminates-on-a-cycle
  (let [files {"/p/main.lg" '(ns app.core (:require [a]))
               "/r/a.lg" '(ns a (:require [b]))
               "/r/b.lg" '(ns b (:require [a] [app.core]))}]
    (is (= ["/p/main.lg" "/r/a.lg" "/r/b.lg"]
           (:files (walk ["/r"] "/p/main.lg" files))))))

(deftest walk-skips-a-main-segment-but-follows-its-requires
  (let [files {"/p/main.lg" '(ns app.core (:require [tool.main]))
               "/r/tool/main.lg" '(ns tool.main (:require [tool.util]))
               "/r/tool/util.lg" '(ns tool.util)}]
    (is (= {:files ["/p/main.lg" "/r/tool/util.lg"]
            :skipped [{:ns 'tool.main
                       :path "/r/tool/main.lg"
                       :reason :main-segment}]}
           (walk ["/r"] "/p/main.lg" files)))))

(deftest walk-records-an-unreadable-file
  (let [files {"/p/main.lg" '(ns app.core (:require [bad]))
               "/r/bad.lg" nil}]
    (is (= {:files ["/p/main.lg" "/r/bad.lg"]
            :skipped [{:ns 'bad :path "/r/bad.lg" :reason :unreadable}]}
           (walk ["/r"] "/p/main.lg" files)))))
