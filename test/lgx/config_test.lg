;; Unit tests for lgx.config — config loading, schema validation, accessors.
;; Run with: lgx test  (from project root)

(ns lgx.config-test
  (:require [lgx.config :as config]
            [string :as str]
            [test :refer [deftest is]]))

(defn- threw? [f]
  (try (f) :no-throw (catch e :threw)))

;; Write the given EDN string as a throwaway project's lgx.edn and load it.
(defn- load-edn [edn-str]
  (let [dir (str "/tmp/lgx-load-config-test-" (rand-int 100000000))]
    (mkdir dir)
    (spit (str dir "/lgx.edn") edn-str)
    (let [r (config/load-config dir)]
      (os/sh "rm" "-rf" dir)
      r)))

;; Same, but from a config value (serialized through pr-str).
(defn- load-cfg [cfg]
  (load-edn (pr-str cfg)))

;; ---------------------------------------------------------------------------
;; load-config: valid configs
;; ---------------------------------------------------------------------------

(deftest load-accepts-valid-deps
  (let [cfg {:deps {'nooga/let-go {:git/url "https://github.com/nooga/let-go"
                                   :git/sha "abc"}}}]
    (is (= {:cfg cfg} (load-cfg cfg)))))

(deftest load-accepts-tag-only-coord
  (let [cfg {:deps {'foo/bar {:git/url "https://github.com/foo/bar"
                              :git/tag "v0.1.0"}}}]
    (is (= {:cfg cfg} (load-cfg cfg)))))

(deftest load-accepts-local-root
  (let [cfg {:deps {'my/lib {:local/root "../mylib"}}}]
    (is (= {:cfg cfg} (load-cfg cfg)))))

(deftest load-accepts-local-root-with-deps-root
  (let [cfg {:deps {'my/lib {:local/root "../mylib"
                             :deps/root "src/main/clojure"}}}]
    (is (= {:cfg cfg} (load-cfg cfg)))))

(deftest load-accepts-absolute-local-root
  (let [cfg {:deps {'my/lib {:local/root "/abs/path"}}}]
    (is (= {:cfg cfg} (load-cfg cfg)))))

(deftest load-accepts-empty-deps
  (is (= {:cfg {:deps {}}} (load-cfg {:deps {}})))
  (is (= {:cfg {}} (load-cfg {}))))

(deftest load-accepts-open-coord-keys
  ;; Coord maps are open: unknown keys are tools.deps forward-compat, not errors.
  (let [cfg {:deps {'foo/bar {:git/url "u"
                              :git/sha "s"
                              :git/branch "main"}}}]
    (is (= {:cfg cfg} (load-cfg cfg)))))

(deftest load-accepts-paths
  (let [cfg {:paths ["src" "resources"] :deps {}}]
    (is (= {:cfg cfg} (load-cfg cfg)))))

(deftest load-accepts-empty-paths
  (is (= {:cfg {:paths []}} (load-cfg {:paths []}))))

(deftest load-accepts-resource-paths
  (let [cfg {:resource-paths ["resources" "assets"] :deps {}}]
    (is (= {:cfg cfg} (load-cfg cfg)))))

(deftest load-accepts-deps-root
  (let [cfg {:deps {'foo/bar {:git/url "https://github.com/foo/bar"
                              :git/sha "abc"
                              :deps/root "src/main/clojure"}}}]
    (is (= {:cfg cfg} (load-cfg cfg)))))

(deftest load-accepts-main
  (is (= {:cfg {:main "main.lg"}} (load-cfg {:main "main.lg"})))
  (is (= {:cfg {:main "scripts/dev.lg"}} (load-cfg {:main "scripts/dev.lg"}))))

(deftest load-accepts-targets-bin
  (let [cfg {:targets {:bin {:out "bin/app"}}}]
    (is (= {:cfg cfg} (load-cfg cfg)))))

;; ---------------------------------------------------------------------------
;; load-config: top-level errors
;; ---------------------------------------------------------------------------

(deftest load-rejects-non-map-top-level
  (is (= {:errors [{:path [] :msg "must be a map, got [:not :a :map]"}]}
         (load-cfg [:not :a :map]))))

(deftest load-rejects-unknown-top-level-key
  (is (= {:errors [{:path []
                    :msg (str "unknown key :extra (allowed: :deps, :paths, "
                              ":resource-paths, :main, :targets, :contexts, "
                              ":tasks)")}]}
         (load-cfg {:deps {} :extra 1}))))

(deftest load-rejects-deps-not-a-map
  (is (= {:errors [{:path [:deps] :msg "must be a map, got [:not :a :map]"}]}
         (load-cfg {:deps [:not :a :map]}))))

(deftest load-rejects-paths-not-a-vector
  (is (= {:errors [{:path [:paths] :msg "must be a vector, got \"src\""}]}
         (load-cfg {:paths "src"}))))

(deftest load-rejects-resource-paths-not-a-vector
  (is (= {:errors [{:path [:resource-paths]
                    :msg "must be a vector, got \"resources\""}]}
         (load-cfg {:resource-paths "resources"}))))

(deftest load-reports-parse-error
  (let [r (load-edn "{:paths [")]
    (is (= 1 (count (:errors r))))
    (let [e (first (:errors r))]
      (is (= [] (:path e)))
      (is (str/starts-with? (:msg e) "could not parse lgx.edn: ")))))

;; ---------------------------------------------------------------------------
;; load-config: relative-path rules (:paths entries, :main, :out)
;; ---------------------------------------------------------------------------

(deftest load-rejects-bad-paths-entries
  (is (= {:errors [{:path [:paths 0] :msg "must be a string, got 5"}]}
         (load-cfg {:paths [5]})))
  (is (= {:errors [{:path [:paths 0] :msg "must be non-blank"}]}
         (load-cfg {:paths [""]})))
  (is (= {:errors [{:path [:paths 0] :msg "must be relative (no leading /)"}]}
         (load-cfg {:paths ["/abs"]})))
  (is (= {:errors [{:path [:paths 0] :msg "must not contain .. segments"}]}
         (load-cfg {:paths ["../etc"]}))))

(deftest load-rejects-resource-paths-with-dotdot
  (is (= {:errors [{:path [:resource-paths 0]
                    :msg "must not contain .. segments"}]}
         (load-cfg {:resource-paths ["../x"]})))
  (is (= {:errors [{:path [:resource-paths 0]
                    :msg "must be relative (no leading /)"}]}
         (load-cfg {:resource-paths ["/abs"]}))))

(deftest load-rejects-bad-main
  (is (= {:errors [{:path [:main] :msg "must be a string, got 5"}]}
         (load-cfg {:main 5})))
  (is (= {:errors [{:path [:main] :msg "must be non-blank"}]}
         (load-cfg {:main "   "})))
  (is (= {:errors [{:path [:main] :msg "must be relative (no leading /)"}]}
         (load-cfg {:main "/abs/main.lg"})))
  (is (= {:errors [{:path [:main] :msg "must not contain .. segments"}]}
         (load-cfg {:main "src/../etc.lg"}))))

;; ---------------------------------------------------------------------------
;; load-config: coord errors
;; ---------------------------------------------------------------------------

(deftest load-rejects-coord-missing-url
  (is (= {:errors [{:path [:deps 'foo/bar] :msg "missing :git/url"}]}
         (load-cfg {:deps {'foo/bar {:git/sha "abc"}}}))))

(deftest load-rejects-coord-without-sha-or-tag
  (is (= {:errors [{:path [:deps 'foo/bar]
                    :msg "must specify :git/sha or :git/tag"}]}
         (load-cfg {:deps {'foo/bar {:git/url "https://github.com/foo/bar"}}}))))

(deftest load-rejects-non-map-coord
  (is (= {:errors [{:path [:deps 'foo/bar]
                    :msg "must be a map, got \"not-a-map\""}]}
         (load-cfg {:deps {'foo/bar "not-a-map"}}))))

(deftest load-rejects-non-symbol-dep-name
  (is (= {:errors [{:path [:deps :foo] :msg "must be a symbol, got :foo"}]}
         (load-cfg {:deps {:foo {:git/url "u" :git/sha "s"}}}))))

(deftest load-rejects-blank-local-root
  (is (= {:errors [{:path [:deps 'my/lib :local/root] :msg "must be non-blank"}]}
         (load-cfg {:deps {'my/lib {:local/root "   "}}}))))

(deftest load-rejects-non-string-local-root
  (is (= {:errors [{:path [:deps 'my/lib :local/root]
                    :msg "must be a string, got 5"}]}
         (load-cfg {:deps {'my/lib {:local/root 5}}}))))

(deftest load-rejects-mixed-local-and-git
  (doseq [coord [{:local/root "../mylib" :git/url "https://github.com/foo/bar"}
                 {:local/root "../mylib" :git/sha "abc"}
                 {:local/root "../mylib" :git/tag "v0.1.0"}]]
    (is (= {:errors [{:path [:deps 'my/lib]
                      :msg "cannot mix :local/root with :git/* keys"}]}
           (load-cfg {:deps {'my/lib coord}})))))

(deftest load-rejects-bad-deps-root
  (let [base {:git/url "https://github.com/foo/bar" :git/sha "abc"}]
    (is (= {:errors [{:path [:deps 'foo/bar :deps/root]
                      :msg "must be non-blank"}]}
           (load-cfg {:deps {'foo/bar (assoc base :deps/root "   ")}})))
    (is (= {:errors [{:path [:deps 'foo/bar :deps/root]
                      :msg "must be a string, got 5"}]}
           (load-cfg {:deps {'foo/bar (assoc base :deps/root 5)}})))
    (is (= {:errors [{:path [:deps 'foo/bar :deps/root]
                      :msg "must be relative (no leading /)"}]}
           (load-cfg {:deps {'foo/bar (assoc base :deps/root "/src")}})))
    (is (= {:errors [{:path [:deps 'foo/bar :deps/root]
                      :msg "must not contain .. segments"}]}
           (load-cfg {:deps {'foo/bar (assoc base :deps/root "src/../etc")}})))))

;; ---------------------------------------------------------------------------
;; load-config: :targets errors
;; ---------------------------------------------------------------------------

(deftest load-rejects-targets-not-a-map
  (is (= {:errors [{:path [:targets] :msg "must be a map, got [:bin]"}]}
         (load-cfg {:targets [:bin]}))))

(deftest load-rejects-unknown-target
  (is (= {:errors [{:path [:targets] :msg "unknown key :wasm (allowed: :bin)"}]}
         (load-cfg {:targets {:wasm {:out "out/app.wasm"}}}))))

(deftest load-rejects-bin-not-a-map
  (is (= {:errors [{:path [:targets :bin] :msg "must be a map, got \"bin/app\""}]}
         (load-cfg {:targets {:bin "bin/app"}}))))

(deftest load-rejects-bin-without-out
  (is (= {:errors [{:path [:targets :bin] :msg "missing required key :out"}]}
         (load-cfg {:targets {:bin {}}}))))

(deftest load-rejects-unknown-bin-key
  (is (= {:errors [{:path [:targets :bin] :msg "unknown key :foo (allowed: :out)"}]}
         (load-cfg {:targets {:bin {:out "bin/app" :foo 1}}}))))

(deftest load-rejects-bad-out
  (is (= {:errors [{:path [:targets :bin :out] :msg "must be non-blank"}]}
         (load-cfg {:targets {:bin {:out "   "}}})))
  (is (= {:errors [{:path [:targets :bin :out]
                    :msg "must be relative (no leading /)"}]}
         (load-cfg {:targets {:bin {:out "/abs/app"}}})))
  (is (= {:errors [{:path [:targets :bin :out]
                    :msg "must not contain .. segments"}]}
         (load-cfg {:targets {:bin {:out "bin/../app"}}}))))

;; ---------------------------------------------------------------------------
;; load-config: :tasks
;; ---------------------------------------------------------------------------

(deftest load-accepts-tasks
  (let [cfg {:tasks {'fmt {:doc "Format"
                           :do [{:sh "echo hi"}]}
                     'check {:do [{:run "scripts/test.lg"}]}
                     'ci {:do [{:sh ["cljfmt" "check" "src"]}
                               {:run ["scripts/test.lg" "unit"]}]}}}]
    (is (= {:cfg cfg} (load-cfg cfg)))))

(deftest load-rejects-tasks-not-a-map
  (is (= {:errors [{:path [:tasks] :msg "must be a map, got [:not :a :map]"}]}
         (load-cfg {:tasks [:not :a :map]}))))

(deftest load-rejects-keyword-task-name
  ;; The pre-symbol format; the error names the fix instead of just the type.
  (is (= {:errors [{:path [:tasks :fmt]
                    :msg "task names are symbols; write fmt instead of :fmt"}]}
         (load-cfg {:tasks {:fmt {:do [{:sh "echo hi"}]}}}))))

(deftest load-rejects-namespaced-keyword-task-name
  ;; The hint must keep the namespace: :foo/bar migrates to foo/bar, not bar.
  (is (= {:errors [{:path [:tasks :foo/bar]
                    :msg "task names are symbols; write foo/bar instead of :foo/bar"}]}
         (load-cfg {:tasks {:foo/bar {:do [{:sh "echo hi"}]}}}))))

(deftest load-accepts-namespaced-task-name
  ;; foo/run is fine: dispatch sees "foo/run", which can't shadow built-in run.
  (let [cfg {:tasks {'foo/bar {:do [{:sh "echo hi"}]}
                     'foo/run {:do [{:sh "echo hi"}]}}}]
    (is (= {:cfg cfg} (load-cfg cfg)))))

(deftest load-rejects-non-symbol-task-name
  (is (= {:errors [{:path [:tasks "fmt"] :msg "must be a symbol, got \"fmt\""}]}
         (load-cfg {:tasks {"fmt" {:do [{:sh "echo hi"}]}}}))))

(deftest load-rejects-non-map-task
  (is (= {:errors [{:path [:tasks 'fmt] :msg "must be a map, got \"not-a-map\""}]}
         (load-cfg {:tasks {'fmt "not-a-map"}}))))

(deftest load-rejects-task-missing-do
  (is (= {:errors [{:path [:tasks 'fmt] :msg "missing required key :do"}]}
         (load-cfg {:tasks {'fmt {:doc "x"}}}))))

(deftest load-rejects-non-string-doc
  (is (= {:errors [{:path [:tasks 'fmt :doc] :msg "must be a string, got 5"}]}
         (load-cfg {:tasks {'fmt {:doc 5 :do [{:sh "echo hi"}]}}}))))

(deftest load-rejects-task-with-unknown-key
  (is (= {:errors [{:path [:tasks 'dev]
                    :msg (str "unknown key :extra-dep (allowed: :doc, :do, "
                              ":extra-paths, :extra-resource-paths, "
                              ":extra-deps, :with)")}]}
         (load-cfg {:tasks {'dev {:extra-dep {}
                                  :do [{:sh "echo hi"}]}}}))))

(deftest load-rejects-reserved-task-names
  (doseq [n config/reserved-task-names]
    (is (= {:errors [{:path [:tasks (symbol n)]
                      :msg (str "conflicts with built-in command \"" n "\"")}]}
           (load-cfg {:tasks {(symbol n) {:do [{:sh "echo hi"}]}}}))))
  ;; Explicit spot-checks: "test" and "nrepl" must stay reserved so projects
  ;; can't shadow them (dispatch would always win, leaving the task unreachable).
  (is (contains? config/reserved-task-names "test"))
  (is (contains? config/reserved-task-names "nrepl")))

;; ---------------------------------------------------------------------------
;; load-config: :do and step errors
;; ---------------------------------------------------------------------------

(deftest load-rejects-non-step-do
  (is (= {:errors [{:path [:tasks 'fmt :do]
                    :msg (str "must be a step map or non-empty vector of "
                              "steps, got \"echo hi\"")}]}
         (load-cfg {:tasks {'fmt {:do "echo hi"}}}))))

(deftest load-rejects-empty-do
  (is (= {:errors [{:path [:tasks 'fmt :do]
                    :msg "must contain at least 1 element"}]}
         (load-cfg {:tasks {'fmt {:do []}}}))))

(deftest load-rejects-step-not-a-map
  (is (= {:errors [{:path [:tasks 'fmt :do 0]
                    :msg "must be a map, got \"echo hi\""}]}
         (load-cfg {:tasks {'fmt {:do ["echo hi"]}}}))))

(deftest load-rejects-step-with-multiple-action-keys
  (is (= {:errors [{:path [:tasks 'fmt :do 0]
                    :msg "must contain exactly one of :sh, :run"}]}
         (load-cfg {:tasks {'fmt {:do [{:sh "echo a"
                                        :run "scripts/foo.lg"}]}}}))))

(deftest load-rejects-step-with-no-action-key
  (is (= {:errors [{:path [:tasks 'fmt :do 0]
                    :msg "must contain exactly one of :sh, :run"}]}
         (load-cfg {:tasks {'fmt {:do [{}]}}}))))

(deftest load-rejects-step-with-unknown-key
  (is (= {:errors [{:path [:tasks 'fmt :do 0]
                    :msg "unknown key :env (allowed: :sh, :run)"}]}
         (load-cfg {:tasks {'fmt {:do [{:sh "echo hi"
                                        :env {"FOO" "1"}}]}}}))))

(deftest load-rejects-bad-action-values
  (is (= {:errors [{:path [:tasks 'fmt :do 0 :sh]
                    :msg "must be a string or vector of strings, got 5"}]}
         (load-cfg {:tasks {'fmt {:do [{:sh 5}]}}})))
  (is (= {:errors [{:path [:tasks 'fmt :do 0 :sh]
                    :msg "must be a non-blank string"}]}
         (load-cfg {:tasks {'fmt {:do [{:sh ""}]}}})))
  (is (= {:errors [{:path [:tasks 'fmt :do 0 :sh]
                    :msg "must be a non-empty vector of strings"}]}
         (load-cfg {:tasks {'fmt {:do [{:sh []}]}}})))
  (is (= {:errors [{:path [:tasks 'fmt :do 0 :sh 1]
                    :msg "must be a string, got 5"}]}
         (load-cfg {:tasks {'fmt {:do [{:sh ["echo" 5]}]}}}))))

;; ---------------------------------------------------------------------------
;; load-config: single-step-map :do normalization
;; ---------------------------------------------------------------------------

(deftest load-normalizes-single-sh-step-map
  (let [r (load-cfg {:tasks {'fmt {:do {:sh "echo hi"}}}})]
    (is (= [{:sh "echo hi"}] (get-in r [:cfg :tasks 'fmt :do])))))

(deftest load-normalizes-single-run-step-map
  (let [r (load-cfg {:tasks {'check {:do {:run "scripts/test.lg"}}}})]
    (is (= [{:run "scripts/test.lg"}] (get-in r [:cfg :tasks 'check :do])))))

(deftest load-keeps-vector-do-as-is
  (let [r (load-cfg {:tasks {'ci {:do [{:sh "echo a"} {:run "t.lg"}]}}})]
    (is (= [{:sh "echo a"} {:run "t.lg"}] (get-in r [:cfg :tasks 'ci :do])))))

(deftest load-rejects-single-step-map-with-no-action-key
  (is (= {:errors [{:path [:tasks 'fmt :do]
                    :msg "must contain exactly one of :sh, :run"}]}
         (load-cfg {:tasks {'fmt {:do {}}}}))))

(deftest load-rejects-single-step-map-with-multiple-action-keys
  (is (= {:errors [{:path [:tasks 'fmt :do]
                    :msg "must contain exactly one of :sh, :run"}]}
         (load-cfg {:tasks {'fmt {:do {:sh "echo a"
                                       :run "scripts/foo.lg"}}}}))))

;; ---------------------------------------------------------------------------
;; load-config: task extras
;; ---------------------------------------------------------------------------

(deftest load-accepts-task-extras
  (let [cfg {:tasks {'dev {:doc "Dev"
                           :extra-paths ["dev"]
                           :extra-resource-paths ["assets"]
                           :extra-deps {'foo/bar {:git/url "u" :git/sha "s"}}
                           :do [{:run "dev/repl.lg"}]}}}]
    (is (= {:cfg cfg} (load-cfg cfg)))))

(deftest load-rejects-task-extra-paths-not-a-vector
  (is (= {:errors [{:path [:tasks 'dev :extra-paths]
                    :msg "must be a vector, got \"dev\""}]}
         (load-cfg {:tasks {'dev {:extra-paths "dev"
                                  :do [{:sh "echo hi"}]}}}))))

(deftest load-rejects-task-extra-paths-with-dotdot
  (is (= {:errors [{:path [:tasks 'dev :extra-paths 0]
                    :msg "must not contain .. segments"}]}
         (load-cfg {:tasks {'dev {:extra-paths ["../x"]
                                  :do [{:sh "echo hi"}]}}}))))

(deftest load-rejects-task-extra-resource-paths-not-a-vector
  (is (= {:errors [{:path [:tasks 'dev :extra-resource-paths]
                    :msg "must be a vector, got \"assets\""}]}
         (load-cfg {:tasks {'dev {:extra-resource-paths "assets"
                                  :do [{:sh "echo hi"}]}}}))))

(deftest load-rejects-task-extra-deps-not-a-map
  (is (= {:errors [{:path [:tasks 'dev :extra-deps]
                    :msg "must be a map, got [:not :a :map]"}]}
         (load-cfg {:tasks {'dev {:extra-deps [:not :a :map]
                                  :do [{:sh "echo hi"}]}}}))))

(deftest load-rejects-task-extra-deps-bad-coord
  (is (= {:errors [{:path [:tasks 'dev :extra-deps 'foo/bar]
                    :msg "must specify :git/sha or :git/tag"}]}
         (load-cfg {:tasks {'dev {:extra-deps {'foo/bar {:git/url "u"}}
                                  :do [{:sh "echo hi"}]}}}))))

;; ---------------------------------------------------------------------------
;; load-config: :with references defined contexts
;; ---------------------------------------------------------------------------

(deftest load-accepts-task-with-defined-context
  (let [cfg {:contexts {:dev {:extra-paths ["dev"]}}
             :tasks {'repl {:with [:dev]
                            :do [{:sh "echo hi"}]}}}]
    (is (= {:cfg cfg} (load-cfg cfg)))))

(deftest load-rejects-task-with-unknown-context
  (is (= {:errors [{:path [:tasks 'repl :with]
                    :msg "references unknown context :typo (defined: :dev)"}]}
         (load-cfg {:contexts {:dev {:extra-paths ["dev"]}}
                    :tasks {'repl {:with [:typo]
                                   :do [{:sh "echo hi"}]}}}))))

(deftest load-rejects-task-with-when-no-contexts-defined
  (is (= {:errors [{:path [:tasks 'repl :with]
                    :msg "references unknown context :dev (no contexts defined)"}]}
         (load-cfg {:tasks {'repl {:with [:dev]
                                   :do [{:sh "echo hi"}]}}}))))

(deftest load-rejects-with-not-a-vector
  (is (= {:errors [{:path [:tasks 'repl :with]
                    :msg "must be a vector, got \"dev\""}]}
         (load-cfg {:contexts {:dev {:extra-paths ["dev"]}}
                    :tasks {'repl {:with "dev"
                                   :do [{:sh "echo hi"}]}}}))))

(deftest load-rejects-with-non-keyword-element
  (is (= {:errors [{:path [:tasks 'repl :with 0]
                    :msg "must be a keyword, got \"dev\""}]}
         (load-cfg {:contexts {:dev {:extra-paths ["dev"]}}
                    :tasks {'repl {:with ["dev"]
                                   :do [{:sh "echo hi"}]}}}))))

;; ---------------------------------------------------------------------------
;; load-config: :contexts
;; ---------------------------------------------------------------------------

(deftest load-accepts-contexts
  (let [cfg {:contexts {:dev {:extra-paths ["dev"]
                              :extra-resource-paths ["assets"]
                              :extra-deps {'foo/bar {:git/url "u"
                                                     :git/sha "s"}}}
                        :empty {}}}]
    (is (= {:cfg cfg} (load-cfg cfg)))))

(deftest load-rejects-contexts-not-a-map
  (is (= {:errors [{:path [:contexts] :msg "must be a map, got [:not :a :map]"}]}
         (load-cfg {:contexts [:not :a :map]}))))

(deftest load-rejects-non-keyword-context-name
  (is (= {:errors [{:path [:contexts "dev"]
                    :msg "must be a keyword, got \"dev\""}]}
         (load-cfg {:contexts {"dev" {:extra-paths ["dev"]}}}))))

(deftest load-rejects-context-with-unknown-key
  (is (= {:errors [{:path [:contexts :dev]
                    :msg (str "unknown key :extra-path (allowed: :extra-deps, "
                              ":extra-paths, :extra-resource-paths)")}]}
         (load-cfg {:contexts {:dev {:extra-path ["x"]}}}))))

(deftest load-rejects-context-with-bad-coord
  (is (= {:errors [{:path [:contexts :dev :extra-deps 'foo/bar]
                    :msg "must specify :git/sha or :git/tag"}]}
         (load-cfg {:contexts {:dev {:extra-deps {'foo/bar {:git/url "u"}}}}}))))

(deftest load-rejects-context-with-dotdot-path
  (is (= {:errors [{:path [:contexts :dev :extra-paths 0]
                    :msg "must not contain .. segments"}]}
         (load-cfg {:contexts {:dev {:extra-paths ["../x"]}}}))))

;; ---------------------------------------------------------------------------
;; load-config: error aggregation
;; ---------------------------------------------------------------------------

(deftest load-collects-multiple-errors-in-schema-order
  (is (= {:errors [{:path [:paths] :msg "must be a vector, got \"src\""}
                   {:path [:targets :bin] :msg "missing required key :out"}
                   {:path [:tasks 'lint :do 0]
                    :msg "unknown key :shh (allowed: :sh, :run)"}]}
         (load-cfg {:paths "src"
                    :targets {:bin {}}
                    :tasks {'lint {:do [{:shh "x"}]}}}))))

;; ---------------------------------------------------------------------------
;; accessors — pure functions over a loaded cfg map, no I/O
;; ---------------------------------------------------------------------------

(deftest accessors-read-cfg-values
  (let [cfg {:deps {'foo/a {:git/url "u" :git/sha "s"}}
             :paths ["src"]
             :resource-paths ["resources"]
             :main "main.lg"
             :targets {:bin {:out "bin/app"}}
             :contexts {:dev {}}
             :tasks {'fmt {:do [{:sh "echo hi"}]}}}]
    (is (= [['foo/a {:git/url "u" :git/sha "s"}]] (config/coords cfg)))
    (is (= ["src"] (config/paths cfg)))
    (is (= ["resources"] (config/resource-paths cfg)))
    (is (= "main.lg" (config/main cfg)))
    (is (= {:bin {:out "bin/app"}} (config/targets cfg)))
    (is (= {:dev {}} (config/contexts cfg)))
    (is (= {'fmt {:do [{:sh "echo hi"}]}} (config/tasks cfg)))))

(deftest accessors-default-on-empty-cfg
  (is (= [] (config/coords {})))
  (is (= [] (config/paths {})))
  (is (= [] (config/resource-paths {})))
  (is (nil? (config/main {})))
  (is (= {} (config/targets {})))
  (is (= {} (config/contexts {})))
  (is (= {} (config/tasks {}))))

(deftest accessors-read-loaded-fixture
  (let [cfg (:cfg (config/load-config "tests/fixtures/sample-project"))
        m (into {} (config/coords cfg))]
    (is (= 2 (count (config/coords cfg))))
    (is (= "https://github.com/nooga/let-go" (:git/url (get m 'nooga/let-go))))
    (is (= "46ce159c9b23021ff7bf38c14e812516c1e2e359"
           (:git/sha (get m 'nooga/let-go))))
    (is (= "v0.1.0" (:git/tag (get m 'example/tagged))))
    (is (= ["src" "test"] (config/paths cfg)))
    (is (= ["resources"] (config/resource-paths cfg)))
    (is (= "main.lg" (config/main cfg)))
    (is (= {:bin {:out "bin/sample"}} (config/targets cfg)))))

;; ---------------------------------------------------------------------------
;; merge-coords (task extras over project deps; extra wins)
;; ---------------------------------------------------------------------------

(deftest merge-coords-no-extras-returns-project-unchanged
  (let [project [['foo/a {:git/url "ua" :git/sha "sa"}]
                 ['foo/b {:git/url "ub" :git/sha "sb"}]]]
    (is (= project (config/merge-coords project [])))))

(deftest merge-coords-new-lib-is-appended-after-project
  (let [project [['foo/a {:git/url "ua" :git/sha "sa"}]]
        extra   [['foo/b {:git/url "ub" :git/sha "sb"}]]
        merged  (config/merge-coords project extra)]
    (is (= ['foo/a 'foo/b] (mapv first merged)))
    (is (= {:git/url "ub" :git/sha "sb"} (second (second merged))))))

(deftest merge-coords-colliding-lib-overrides-in-place
  (let [project [['foo/a {:git/url "ua" :git/sha "v1"}]
                 ['foo/b {:git/url "ub" :git/sha "sb"}]]
        extra   [['foo/a {:git/url "ua" :git/sha "v2"}]]
        merged  (config/merge-coords project extra)]
    ;; same length, same order, foo/a's coord replaced by the extra
    (is (= 2 (count merged)))
    (is (= ['foo/a 'foo/b] (mapv first merged)))
    (is (= {:git/url "ua" :git/sha "v2"} (second (first merged))))))

;; ---------------------------------------------------------------------------
;; context-overlay (named contexts -> combined deps-pairs + paths; last-wins)
;; ---------------------------------------------------------------------------

(deftest context-overlay-empty-names-returns-empty
  (is (= {:deps-pairs [] :paths [] :resource-paths []}
         (config/context-overlay {:dev {:extra-paths ["dev"]}} []))))

(deftest context-overlay-single-context
  (let [contexts {:dev {:extra-paths ["dev"]
                        :extra-deps {'foo/a {:git/url "ua" :git/sha "sa"}}}}
        overlay (config/context-overlay contexts [:dev])]
    (is (= ['foo/a] (mapv first (:deps-pairs overlay))))
    (is (= {:git/url "ua" :git/sha "sa"} (second (first (:deps-pairs overlay)))))
    (is (= ["dev"] (:paths overlay)))))

(deftest context-overlay-two-contexts-union
  (let [contexts {:dev {:extra-paths ["dev"]
                        :extra-deps {'foo/a {:git/url "ua" :git/sha "sa"}}}
                  :test {:extra-paths ["test-support"]
                         :extra-deps {'foo/b {:git/url "ub" :git/sha "sb"}}}}
        overlay (config/context-overlay contexts [:dev :test])]
    (is (= ['foo/a 'foo/b] (mapv first (:deps-pairs overlay))))
    (is (= ["dev" "test-support"] (:paths overlay)))))

(deftest context-overlay-overlap-last-wins-in-place
  (let [contexts {:dev {:extra-deps {'foo/c {:git/url "uc" :git/sha "v1"}}}
                  :test {:extra-deps {'foo/c {:git/url "uc" :git/sha "v2"}}}}
        overlay (config/context-overlay contexts [:dev :test])]
    ;; foo/c appears once, at its first position, with the later coord
    (is (= ['foo/c] (mapv first (:deps-pairs overlay))))
    (is (= {:git/url "uc" :git/sha "v2"}
           (second (first (:deps-pairs overlay)))))))

(deftest context-overlay-unknown-name-throws
  (is (= :threw (threw? #(config/context-overlay {:dev {:extra-paths ["dev"]}}
                                                 [:nope])))))

(deftest context-overlay-empty-names-has-empty-resource-paths
  (is (= [] (:resource-paths
              (config/context-overlay {:dev {:extra-resource-paths ["assets"]}}
                                      [])))))

(deftest context-overlay-single-context-resource-paths
  (let [contexts {:dev {:extra-resource-paths ["assets"]}}
        overlay (config/context-overlay contexts [:dev])]
    (is (= ["assets"] (:resource-paths overlay)))))

(deftest context-overlay-two-contexts-concat-resource-paths
  (let [contexts {:dev {:extra-resource-paths ["assets"]}
                  :test {:extra-resource-paths ["fixtures"]}}
        overlay (config/context-overlay contexts [:dev :test])]
    (is (= ["assets" "fixtures"] (:resource-paths overlay)))))

;; ---------------------------------------------------------------------------
;; coords-at (transitive: a fetched dep's own deps)
;; ---------------------------------------------------------------------------

(deftest coords-at-reads-fixture-deps
  (let [cs (config/coords-at "tests/fixtures/sample-project")
        m (into {} cs)]
    (is (= 2 (count cs)))
    (is (= "https://github.com/nooga/let-go" (:git/url (get m 'nooga/let-go))))))

(deftest coords-at-returns-empty-when-no-lgx-edn
  (let [dir (str "/tmp/lgx-coords-at-test-" (rand-int 100000000))]
    (mkdir dir)
    (is (= [] (config/coords-at dir)))
    (os/sh "rm" "-rf" dir)))

(deftest coords-at-returns-empty-when-deps-absent
  (let [dir (str "/tmp/lgx-coords-at-test-" (rand-int 100000000))]
    (mkdir dir)
    (spit (str dir "/lgx.edn") "{:paths [\"src\"]}")
    (is (= [] (config/coords-at dir)))
    (os/sh "rm" "-rf" dir)))

(deftest coords-at-rejects-non-map-top-level
  (let [dir (str "/tmp/lgx-coords-at-test-" (rand-int 100000000))]
    (mkdir dir)
    (spit (str dir "/lgx.edn") "[:not :a :map]")
    (is (= :threw (threw? #(config/coords-at dir))))
    (os/sh "rm" "-rf" dir)))

(deftest coords-at-rejects-deps-not-a-map
  (doseq [form ["{:deps []}" "{:deps \"not-a-map\"}"]]
    (let [dir (str "/tmp/lgx-coords-at-test-" (rand-int 100000000))]
      (mkdir dir)
      (spit (str dir "/lgx.edn") form)
      (is (= :threw (threw? #(config/coords-at dir))))
      (os/sh "rm" "-rf" dir))))

(deftest coords-at-is-lenient-about-other-keys
  ;; A dep's lgx.edn may carry a malformed :tasks or a top-level key a newer
  ;; lgx added; only its :deps matter and must still be returned.
  (let [dir (str "/tmp/lgx-coords-at-test-" (rand-int 100000000))]
    (mkdir dir)
    (spit (str dir "/lgx.edn")
          (str "{:deps {foo/bar {:git/url \"https://github.com/foo/bar\" :git/sha \"abc\"}}"
               " :tasks \"not-a-valid-tasks-map\""
               " :future/key 123}"))
    (let [m (into {} (config/coords-at dir))]
      (is (= "abc" (:git/sha (get m 'foo/bar)))))
    (os/sh "rm" "-rf" dir)))

(deftest coords-at-still-validates-its-coords
  ;; Leniency is only about non-:deps keys; a broken coord must still throw.
  (let [dir (str "/tmp/lgx-coords-at-test-" (rand-int 100000000))]
    (mkdir dir)
    (spit (str dir "/lgx.edn")
          "{:deps {bad/coord {:local/root \"x\" :git/url \"y\" :git/sha \"z\"}}}")
    (is (= :threw (threw? #(config/coords-at dir))))
    (os/sh "rm" "-rf" dir)))

(deftest coords-at-error-carries-rendered-report-and-marker
  ;; The thrown ex-info's message is the full report naming the dep dir, and
  ;; ex-data carries :lgx/invalid-dep-config so the caller can catch, print,
  ;; and exit without a stack trace.
  (let [dir (str "/tmp/lgx-coords-at-test-" (rand-int 100000000))]
    (mkdir dir)
    (spit (str dir "/lgx.edn") "{:deps {foo/bar {:git/url \"u\"}}}")
    (let [r (try
              (config/coords-at dir)
              (catch e {:msg (ex-message e) :data (ex-data e)}))]
      (is (= dir (:lgx/invalid-dep-config (:data r))))
      (is (str/includes? (:msg r) (str "invalid lgx.edn in " dir " (1 error)")))
      (is (str/includes? (:msg r) "must specify :git/sha or :git/tag")))
    (os/sh "rm" "-rf" dir)))
