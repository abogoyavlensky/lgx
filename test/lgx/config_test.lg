;; Unit tests for lgx.config — config loading, schema validation, accessors.
;; Run with: lgx test  (from project root)

(ns lgx.config-test
  (:require [lgx.config :as config]
            [string :as str]
            [clojure.test :refer [deftest is]]))

(defn- threw? [f]
  (try (f) :no-throw (catch e :threw)))

;; Write the given EDN string as a throwaway project's lgx.edn and load it.
(defn- load-edn [edn-str]
  (let [dir (str "/tmp/lgx-load-config-test-" (rand-int 100000000))]
    (mkdir dir)
    (spit (str dir "/lgx.edn") edn-str)
    (let [r (config/load-config dir)]
      (os/sh "rm" "-rf" dir)
      r)))

;; Same, but from a config value (serialized through pr-str).
(defn- load-cfg [cfg]
  (load-edn (pr-str cfg)))

;; ---------------------------------------------------------------------------
;; load-config: valid configs
;; ---------------------------------------------------------------------------

(deftest load-accepts-valid-deps
  (let [cfg {:deps {'nooga/let-go {:git/url "https://github.com/nooga/let-go"
                                   :git/sha "abc"}}}]
    (is (= {:cfg cfg} (load-cfg cfg)))))

(deftest load-accepts-tag-only-coord
  (let [cfg {:deps {'foo/bar {:git/url "https://github.com/foo/bar"
                              :git/tag "v0.1.0"}}}]
    (is (= {:cfg cfg} (load-cfg cfg)))))

(deftest load-accepts-local-root
  (let [cfg {:deps {'my/lib {:local/root "../mylib"}}}]
    (is (= {:cfg cfg} (load-cfg cfg)))))

(deftest load-accepts-local-root-with-deps-root
  (let [cfg {:deps {'my/lib {:local/root "../mylib"
                             :deps/root "src/main/clojure"}}}]
    (is (= {:cfg cfg} (load-cfg cfg)))))

(deftest load-accepts-absolute-local-root
  (let [cfg {:deps {'my/lib {:local/root "/abs/path"}}}]
    (is (= {:cfg cfg} (load-cfg cfg)))))

(deftest load-accepts-empty-deps
  (is (= {:cfg {:deps {}}} (load-cfg {:deps {}})))
  (is (= {:cfg {}} (load-cfg {}))))

(deftest load-accepts-open-coord-keys
  ;; Coord maps are open: unknown keys are tools.deps forward-compat, not errors.
  (let [cfg {:deps {'foo/bar {:git/url "u"
                              :git/sha "s"
                              :git/branch "main"}}}]
    (is (= {:cfg cfg} (load-cfg cfg)))))

(deftest load-accepts-exclusions-on-git-coord
  (let [cfg {:deps {'foo/bar {:git/url "https://github.com/foo/bar"
                              :git/tag "v1.0"
                              :exclusions ['a/b 'c/d]}}}]
    (is (= {:cfg cfg} (load-cfg cfg)))))

(deftest load-accepts-exclusions-on-local-coord
  (let [cfg {:deps {'my/lib {:local/root "../mylib"
                             :exclusions ['a/b]}}}]
    (is (= {:cfg cfg} (load-cfg cfg)))))

(deftest load-accepts-empty-exclusions
  (let [cfg {:deps {'foo/bar {:git/url "u" :git/sha "s" :exclusions []}}}]
    (is (= {:cfg cfg} (load-cfg cfg)))))

(deftest load-accepts-paths
  (let [cfg {:paths ["src" "resources"] :deps {}}]
    (is (= {:cfg cfg} (load-cfg cfg)))))

(deftest load-accepts-empty-paths
  (is (= {:cfg {:paths []}} (load-cfg {:paths []}))))

(deftest load-accepts-resource-paths
  (let [cfg {:resource-paths ["resources" "assets"] :deps {}}]
    (is (= {:cfg cfg} (load-cfg cfg)))))

(deftest load-accepts-deps-root
  (let [cfg {:deps {'foo/bar {:git/url "https://github.com/foo/bar"
                              :git/sha "abc"
                              :deps/root "src/main/clojure"}}}]
    (is (= {:cfg cfg} (load-cfg cfg)))))

(deftest load-accepts-main
  (is (= {:cfg {:main "main.lg"}} (load-cfg {:main "main.lg"})))
  (is (= {:cfg {:main "scripts/dev.lg"}} (load-cfg {:main "scripts/dev.lg"}))))

(deftest load-accepts-lg-version
  (is (= {:cfg {:lg-version "1.10.0"}} (load-cfg {:lg-version "1.10.0"}))))

(deftest lg-version-accessor
  (is (= "1.10.0" (config/lg-version {:lg-version "1.10.0"})))
  (is (nil? (config/lg-version {}))))

(deftest load-accepts-targets-bin
  (let [cfg {:targets {:bin {:out "bin/app"}}}]
    (is (= {:cfg cfg} (load-cfg cfg)))))

;; ---------------------------------------------------------------------------
;; load-config: top-level errors
;; ---------------------------------------------------------------------------

(deftest load-rejects-non-map-top-level
  (is (= {:errors [{:path [] :msg "must be a map, got [:not :a :map]"}]}
         (load-cfg [:not :a :map]))))

(deftest load-rejects-unknown-top-level-key
  (is (= {:errors [{:path []
                    :msg (str "unknown key :extra (allowed: :deps, :paths, "
                              ":resource-paths, :main, :lg-version, :targets, "
                              ":contexts, :tasks)")}]}
         (load-cfg {:deps {} :extra 1}))))

(deftest load-rejects-blank-lg-version
  (is (= {:errors [{:path [:lg-version] :msg "must be non-blank"}]}
         (load-cfg {:lg-version ""}))))

(deftest load-rejects-deps-not-a-map
  (is (= {:errors [{:path [:deps] :msg "must be a map, got [:not :a :map]"}]}
         (load-cfg {:deps [:not :a :map]}))))

(deftest load-rejects-paths-not-a-vector
  (is (= {:errors [{:path [:paths] :msg "must be a vector, got \"src\""}]}
         (load-cfg {:paths "src"}))))

(deftest load-rejects-resource-paths-not-a-vector
  (is (= {:errors [{:path [:resource-paths]
                    :msg "must be a vector, got \"resources\""}]}
         (load-cfg {:resource-paths "resources"}))))

(deftest load-reports-parse-error
  (let [r (load-edn "{:paths [")]
    (is (= 1 (count (:errors r))))
    (let [e (first (:errors r))]
      (is (= [] (:path e)))
      (is (str/starts-with? (:msg e) "could not parse lgx.edn: ")))))

;; ---------------------------------------------------------------------------
;; load-config: relative-path rules (:paths entries, :main, :out)
;; ---------------------------------------------------------------------------

(deftest load-rejects-bad-paths-entries
  (is (= {:errors [{:path [:paths 0] :msg "must be a string, got 5"}]}
         (load-cfg {:paths [5]})))
  (is (= {:errors [{:path [:paths 0] :msg "must be non-blank"}]}
         (load-cfg {:paths [""]})))
  (is (= {:errors [{:path [:paths 0] :msg "must be relative (no leading /)"}]}
         (load-cfg {:paths ["/abs"]})))
  (is (= {:errors [{:path [:paths 0] :msg "must not contain .. segments"}]}
         (load-cfg {:paths ["../etc"]}))))

(deftest load-rejects-resource-paths-with-dotdot
  (is (= {:errors [{:path [:resource-paths 0]
                    :msg "must not contain .. segments"}]}
         (load-cfg {:resource-paths ["../x"]})))
  (is (= {:errors [{:path [:resource-paths 0]
                    :msg "must be relative (no leading /)"}]}
         (load-cfg {:resource-paths ["/abs"]}))))

(deftest load-rejects-bad-main
  (is (= {:errors [{:path [:main] :msg "must be a string, got 5"}]}
         (load-cfg {:main 5})))
  (is (= {:errors [{:path [:main] :msg "must be non-blank"}]}
         (load-cfg {:main "   "})))
  (is (= {:errors [{:path [:main] :msg "must be relative (no leading /)"}]}
         (load-cfg {:main "/abs/main.lg"})))
  (is (= {:errors [{:path [:main] :msg "must not contain .. segments"}]}
         (load-cfg {:main "src/../etc.lg"}))))

;; ---------------------------------------------------------------------------
;; load-config: coord errors
;; ---------------------------------------------------------------------------

(deftest load-rejects-coord-missing-url
  (is (= {:errors [{:path [:deps 'foo/bar] :msg "missing :git/url"}]}
         (load-cfg {:deps {'foo/bar {:git/sha "abc"}}}))))

(deftest load-rejects-coord-without-sha-or-tag
  (is (= {:errors [{:path [:deps 'foo/bar]
                    :msg "must specify :git/sha or :git/tag"}]}
         (load-cfg {:deps {'foo/bar {:git/url "https://github.com/foo/bar"}}}))))

(deftest load-rejects-non-map-coord
  (is (= {:errors [{:path [:deps 'foo/bar]
                    :msg "must be a map, got \"not-a-map\""}]}
         (load-cfg {:deps {'foo/bar "not-a-map"}}))))

(deftest load-rejects-non-symbol-dep-name
  (is (= {:errors [{:path [:deps :foo] :msg "must be a symbol, got :foo"}]}
         (load-cfg {:deps {:foo {:git/url "u" :git/sha "s"}}}))))

(deftest load-rejects-blank-local-root
  (is (= {:errors [{:path [:deps 'my/lib :local/root] :msg "must be non-blank"}]}
         (load-cfg {:deps {'my/lib {:local/root "   "}}}))))

(deftest load-rejects-non-string-local-root
  (is (= {:errors [{:path [:deps 'my/lib :local/root]
                    :msg "must be a string, got 5"}]}
         (load-cfg {:deps {'my/lib {:local/root 5}}}))))

(deftest load-rejects-mixed-local-and-git
  (doseq [coord [{:local/root "../mylib" :git/url "https://github.com/foo/bar"}
                 {:local/root "../mylib" :git/sha "abc"}
                 {:local/root "../mylib" :git/tag "v0.1.0"}]]
    (is (= {:errors [{:path [:deps 'my/lib]
                      :msg "cannot mix :local/root with :git/* keys"}]}
           (load-cfg {:deps {'my/lib coord}})))))

(deftest load-rejects-bad-deps-root
  (let [base {:git/url "https://github.com/foo/bar" :git/sha "abc"}]
    (is (= {:errors [{:path [:deps 'foo/bar :deps/root]
                      :msg "must be non-blank"}]}
           (load-cfg {:deps {'foo/bar (assoc base :deps/root "   ")}})))
    (is (= {:errors [{:path [:deps 'foo/bar :deps/root]
                      :msg "must be a string, got 5"}]}
           (load-cfg {:deps {'foo/bar (assoc base :deps/root 5)}})))
    (is (= {:errors [{:path [:deps 'foo/bar :deps/root]
                      :msg "must be relative (no leading /)"}]}
           (load-cfg {:deps {'foo/bar (assoc base :deps/root "/src")}})))
    (is (= {:errors [{:path [:deps 'foo/bar :deps/root]
                      :msg "must not contain .. segments"}]}
           (load-cfg {:deps {'foo/bar (assoc base :deps/root "src/../etc")}})))))

(deftest load-rejects-non-vector-exclusions
  (is (= {:errors [{:path [:deps 'foo/bar :exclusions]
                    :msg "must be a vector of symbols, got :nope"}]}
         (load-cfg {:deps {'foo/bar {:git/url "u"
                                     :git/sha "s"
                                     :exclusions :nope}}}))))

(deftest load-rejects-non-symbol-exclusion-entry
  (is (= {:errors [{:path [:deps 'foo/bar :exclusions 1]
                    :msg "must be a symbol, got \"c/d\""}]}
         (load-cfg {:deps {'foo/bar {:git/url "u"
                                     :git/sha "s"
                                     :exclusions ['a/b "c/d"]}}}))))

(deftest load-rejects-exclusions-on-local-coord
  (is (= {:errors [{:path [:deps 'my/lib :exclusions]
                    :msg "must be a vector of symbols, got \"a/b\""}]}
         (load-cfg {:deps {'my/lib {:local/root "../mylib"
                                    :exclusions "a/b"}}}))))

;; ---------------------------------------------------------------------------
;; load-config: :mvn/version teaching error
;; ---------------------------------------------------------------------------

(deftest load-rejects-mvn-version-with-one-teaching-error
  ;; Someone pasting a deps.edn coord from a README gets taught, not buried in
  ;; generic missing-:git/url noise: exactly one error, and it explains why.
  (let [errors (:errors (load-cfg {:deps {'foo/bar {:mvn/version "1.0"}}}))
        msg (:msg (first errors))]
    (is (= 1 (count errors)))
    (is (= [:deps 'foo/bar] (:path (first errors))))
    (is (str/includes? msg ":mvn/version is not supported"))
    (is (str/includes? msg ":git/url"))
    (is (str/includes? msg "see examples/clojure-libs/"))
    (is (not (str/includes? msg "missing :git/url")))))

(deftest load-rejects-mvn-version-even-alongside-git-keys
  (let [errors (:errors (load-cfg {:deps {'foo/bar {:git/url "u"
                                                    :git/sha "s"
                                                    :mvn/version "1.0"}}}))]
    (is (= 1 (count errors)))
    (is (str/includes? (:msg (first errors))
                       ":mvn/version is not supported"))))

;; ---------------------------------------------------------------------------
;; load-config: :targets errors
;; ---------------------------------------------------------------------------

(deftest load-rejects-targets-not-a-map
  (is (= {:errors [{:path [:targets] :msg "must be a map, got [:bin]"}]}
         (load-cfg {:targets [:bin]}))))

(deftest load-rejects-unknown-target
  (is (= {:errors [{:path [:targets] :msg "unknown key :wasm (allowed: :bin)"}]}
         (load-cfg {:targets {:wasm {:out "out/app.wasm"}}}))))

(deftest load-rejects-bin-not-a-map
  (is (= {:errors [{:path [:targets :bin] :msg "must be a map, got \"bin/app\""}]}
         (load-cfg {:targets {:bin "bin/app"}}))))

(deftest load-rejects-bin-without-out
  (is (= {:errors [{:path [:targets :bin] :msg "missing required key :out"}]}
         (load-cfg {:targets {:bin {}}}))))

(deftest load-rejects-unknown-bin-key
  (is (= {:errors [{:path [:targets :bin] :msg "unknown key :foo (allowed: :out)"}]}
         (load-cfg {:targets {:bin {:out "bin/app" :foo 1}}}))))

(deftest load-rejects-bad-out
  (is (= {:errors [{:path [:targets :bin :out] :msg "must be non-blank"}]}
         (load-cfg {:targets {:bin {:out "   "}}})))
  (is (= {:errors [{:path [:targets :bin :out]
                    :msg "must be relative (no leading /)"}]}
         (load-cfg {:targets {:bin {:out "/abs/app"}}})))
  (is (= {:errors [{:path [:targets :bin :out]
                    :msg "must not contain .. segments"}]}
         (load-cfg {:targets {:bin {:out "bin/../app"}}}))))

;; ---------------------------------------------------------------------------
;; load-config: :tasks
;; ---------------------------------------------------------------------------

(deftest load-accepts-tasks
  (let [cfg {:tasks {'fmt {:doc "Format"
                           :do [{:sh "echo hi"}]}
                     'check {:do [{:run "scripts/test.lg"}]}
                     'ci {:do [{:sh ["cljfmt" "check" "src"]}
                               {:run ["scripts/test.lg" "unit"]}]}}}]
    (is (= {:cfg cfg} (load-cfg cfg)))))

(deftest load-rejects-tasks-not-a-map
  (is (= {:errors [{:path [:tasks] :msg "must be a map, got [:not :a :map]"}]}
         (load-cfg {:tasks [:not :a :map]}))))

(deftest load-rejects-keyword-task-name
  ;; The pre-symbol format; the error names the fix instead of just the type.
  (is (= {:errors [{:path [:tasks :fmt]
                    :msg "task names are symbols; write fmt instead of :fmt"}]}
         (load-cfg {:tasks {:fmt {:do [{:sh "echo hi"}]}}}))))

(deftest load-rejects-namespaced-keyword-task-name
  ;; The hint must keep the namespace: :foo/bar migrates to foo/bar, not bar.
  (is (= {:errors [{:path [:tasks :foo/bar]
                    :msg "task names are symbols; write foo/bar instead of :foo/bar"}]}
         (load-cfg {:tasks {:foo/bar {:do [{:sh "echo hi"}]}}}))))

(deftest load-accepts-namespaced-task-name
  ;; foo/run is fine: dispatch sees "foo/run", which can't shadow built-in run.
  (let [cfg {:tasks {'foo/bar {:do [{:sh "echo hi"}]}
                     'foo/run {:do [{:sh "echo hi"}]}}}]
    (is (= {:cfg cfg} (load-cfg cfg)))))

(deftest load-rejects-non-symbol-task-name
  (is (= {:errors [{:path [:tasks "fmt"] :msg "must be a symbol, got \"fmt\""}]}
         (load-cfg {:tasks {"fmt" {:do [{:sh "echo hi"}]}}}))))

(deftest load-rejects-non-map-task
  (is (= {:errors [{:path [:tasks 'fmt] :msg "must be a map, got \"not-a-map\""}]}
         (load-cfg {:tasks {'fmt "not-a-map"}}))))

(deftest load-rejects-task-missing-do
  (is (= {:errors [{:path [:tasks 'fmt] :msg "missing required key :do"}]}
         (load-cfg {:tasks {'fmt {:doc "x"}}}))))

(deftest load-rejects-non-string-doc
  (is (= {:errors [{:path [:tasks 'fmt :doc] :msg "must be a string, got 5"}]}
         (load-cfg {:tasks {'fmt {:doc 5 :do [{:sh "echo hi"}]}}}))))

(deftest load-rejects-task-with-unknown-key
  (is (= {:errors [{:path [:tasks 'dev]
                    :msg (str "unknown key :extra-dep (allowed: :doc, :args, "
                              ":do, :extra-paths, :extra-resource-paths, "
                              ":extra-deps, :with)")}]}
         (load-cfg {:tasks {'dev {:extra-dep {}
                                  :do [{:sh "echo hi"}]}}}))))

(deftest load-rejects-reserved-task-names
  (doseq [n config/reserved-task-names]
    (is (= {:errors [{:path [:tasks (symbol n)]
                      :msg (str "conflicts with built-in command \"" n "\"")}]}
           (load-cfg {:tasks {(symbol n) {:do [{:sh "echo hi"}]}}}))))
  ;; Explicit spot-checks: "test" and "nrepl" must stay reserved so projects
  ;; can't shadow them (dispatch would always win, leaving the task unreachable).
  (is (contains? config/reserved-task-names "test"))
  (is (contains? config/reserved-task-names "nrepl")))

;; ---------------------------------------------------------------------------
;; load-config: :do and step errors
;; ---------------------------------------------------------------------------

(deftest load-rejects-non-step-do
  (is (= {:errors [{:path [:tasks 'fmt :do]
                    :msg (str "must be a step map or non-empty vector of "
                              "steps, got \"echo hi\"")}]}
         (load-cfg {:tasks {'fmt {:do "echo hi"}}}))))

(deftest load-rejects-empty-do
  (is (= {:errors [{:path [:tasks 'fmt :do]
                    :msg "must contain at least 1 element"}]}
         (load-cfg {:tasks {'fmt {:do []}}}))))

(deftest load-rejects-step-not-a-map
  (is (= {:errors [{:path [:tasks 'fmt :do 0]
                    :msg "must be a map, got \"echo hi\""}]}
         (load-cfg {:tasks {'fmt {:do ["echo hi"]}}}))))

(deftest load-rejects-step-with-multiple-action-keys
  (is (= {:errors [{:path [:tasks 'fmt :do 0]
                    :msg "must contain exactly one of :sh, :run"}]}
         (load-cfg {:tasks {'fmt {:do [{:sh "echo a"
                                        :run "scripts/foo.lg"}]}}}))))

(deftest load-rejects-step-with-no-action-key
  (is (= {:errors [{:path [:tasks 'fmt :do 0]
                    :msg "must contain exactly one of :sh, :run"}]}
         (load-cfg {:tasks {'fmt {:do [{}]}}}))))

(deftest load-rejects-step-with-unknown-key
  (is (= {:errors [{:path [:tasks 'fmt :do 0]
                    :msg "unknown key :env (allowed: :sh, :run)"}]}
         (load-cfg {:tasks {'fmt {:do [{:sh "echo hi"
                                        :env {"FOO" "1"}}]}}}))))

(deftest load-rejects-bad-action-values
  (is (= {:errors [{:path [:tasks 'fmt :do 0 :sh]
                    :msg "must be a string or vector of strings, got 5"}]}
         (load-cfg {:tasks {'fmt {:do [{:sh 5}]}}})))
  (is (= {:errors [{:path [:tasks 'fmt :do 0 :sh]
                    :msg "must be a non-blank string"}]}
         (load-cfg {:tasks {'fmt {:do [{:sh ""}]}}})))
  (is (= {:errors [{:path [:tasks 'fmt :do 0 :sh]
                    :msg "must be a non-empty vector of strings"}]}
         (load-cfg {:tasks {'fmt {:do [{:sh []}]}}})))
  (is (= {:errors [{:path [:tasks 'fmt :do 0 :sh 1]
                    :msg "must be a string or :arg/<name> placeholder, got 5"}]}
         (load-cfg {:tasks {'fmt {:do [{:sh ["echo" 5]}]}}}))))

;; ---------------------------------------------------------------------------
;; load-config: task :args declarations
;; ---------------------------------------------------------------------------

(deftest load-accepts-task-args
  (let [cfg {:tasks {'deploy {:args [{:name :env
                                      :type [:enum "prod" "staging"]}
                                     {:name :port :type :int}
                                     {:name :version
                                      :type :string
                                      :default "latest"}]
                              :do [{:sh ["./deploy.sh" :arg/env :arg/version]}
                                   {:run ["notify.lg" :arg/env :arg/port]}]}}}]
    (is (= {:cfg cfg} (load-cfg cfg)))))

(deftest load-accepts-unused-declared-arg
  (let [cfg {:tasks {'d {:args [{:name :env}]
                         :do [{:sh "echo hi"}]}}}]
    (is (= {:cfg cfg} (load-cfg cfg)))))

(deftest load-rejects-empty-args
  (is (= {:errors [{:path [:tasks 'd :args]
                    :msg "must contain at least 1 element"}]}
         (load-cfg {:tasks {'d {:args []
                                :do [{:sh "echo hi"}]}}}))))

(deftest load-rejects-arg-with-unknown-key
  (is (= {:errors [{:path [:tasks 'd :args 0]
                    :msg "unknown key :typ (allowed: :name, :type, :default)"}]}
         (load-cfg {:tasks {'d {:args [{:name :env :typ :int}]
                                :do [{:sh "echo hi"}]}}}))))

(deftest load-rejects-arg-missing-name
  (is (= {:errors [{:path [:tasks 'd :args 0]
                    :msg "missing required key :name"}]}
         (load-cfg {:tasks {'d {:args [{:type :int}]
                                :do [{:sh "echo hi"}]}}}))))

(deftest load-rejects-non-keyword-arg-name
  (is (= {:errors [{:path [:tasks 'd :args 0 :name]
                    :msg "must be a keyword, got \"env\""}]}
         (load-cfg {:tasks {'d {:args [{:name "env"}]
                                :do [{:sh "echo hi"}]}}}))))

(deftest load-rejects-namespaced-arg-name
  (is (= {:errors [{:path [:tasks 'd :args 0 :name]
                    :msg "must be an unqualified keyword, got :foo/env"}]}
         (load-cfg {:tasks {'d {:args [{:name :foo/env}]
                                :do [{:sh "echo hi"}]}}}))))

(deftest load-rejects-duplicate-arg-name
  (is (= {:errors [{:path [:tasks 'd :args 1 :name]
                    :msg "duplicate arg name :env"}]}
         (load-cfg {:tasks {'d {:args [{:name :env} {:name :env}]
                                :do [{:sh "echo hi"}]}}}))))

(deftest load-rejects-bad-arg-type
  (is (= {:errors [{:path [:tasks 'd :args 0 :type]
                    :msg "must be :int, :string, or [:enum ...], got :float"}]}
         (load-cfg {:tasks {'d {:args [{:name :env :type :float}]
                                :do [{:sh "echo hi"}]}}}))))

(deftest load-rejects-enum-with-one-value
  (is (= {:errors [{:path [:tasks 'd :args 0 :type]
                    :msg "must list at least 2 enum values"}]}
         (load-cfg {:tasks {'d {:args [{:name :env :type [:enum "prod"]}]
                                :do [{:sh "echo hi"}]}}}))))

(deftest load-rejects-enum-with-non-string-value
  (is (= {:errors [{:path [:tasks 'd :args 0 :type]
                    :msg "enum values must be non-blank strings"}]}
         (load-cfg {:tasks {'d {:args [{:name :env :type [:enum "prod" 5]}]
                                :do [{:sh "echo hi"}]}}}))))

(deftest load-rejects-enum-with-duplicate-values
  (is (= {:errors [{:path [:tasks 'd :args 0 :type]
                    :msg "enum values must be distinct"}]}
         (load-cfg {:tasks {'d {:args [{:name :env
                                        :type [:enum "prod" "prod"]}]
                                :do [{:sh "echo hi"}]}}}))))

(deftest load-rejects-string-arg-with-non-string-default
  ;; :type omitted defaults to :string.
  (is (= {:errors [{:path [:tasks 'd :args 0 :default]
                    :msg "must be a string (type :string), got 5"}]}
         (load-cfg {:tasks {'d {:args [{:name :env :default 5}]
                                :do [{:sh "echo hi"}]}}}))))

(deftest load-rejects-int-arg-with-string-default
  (is (= {:errors [{:path [:tasks 'd :args 0 :default]
                    :msg "must be an integer (type :int), got \"x\""}]}
         (load-cfg {:tasks {'d {:args [{:name :port :type :int :default "x"}]
                                :do [{:sh "echo hi"}]}}}))))

(deftest load-rejects-enum-arg-with-non-member-default
  (is (= {:errors [{:path [:tasks 'd :args 0 :default]
                    :msg "must be one of: prod, staging, got \"qa\""}]}
         (load-cfg {:tasks {'d {:args [{:name :env
                                        :type [:enum "prod" "staging"]
                                        :default "qa"}]
                                :do [{:sh "echo hi"}]}}}))))

(deftest load-rejects-required-arg-after-defaulted
  (is (= {:errors [{:path [:tasks 'd :args 1]
                    :msg "required arg :env cannot follow an arg with :default"}]}
         (load-cfg {:tasks {'d {:args [{:name :version :default "latest"}
                                       {:name :env}]
                                :do [{:sh "echo hi"}]}}}))))

;; ---------------------------------------------------------------------------
;; load-config: :arg/* placeholders in steps
;; ---------------------------------------------------------------------------

(deftest load-rejects-unknown-placeholder
  (is (= {:errors [{:path [:tasks 'd :do 0 :sh 1]
                    :msg "unknown placeholder :arg/typo (declared: :env)"}]}
         (load-cfg {:tasks {'d {:args [{:name :env}]
                                :do [{:sh ["echo" :arg/typo]}]}}}))))

(deftest load-rejects-placeholder-without-args
  (is (= {:errors [{:path [:tasks 'd :do 0 :sh 1]
                    :msg "placeholder :arg/x used but no :args declared"}]}
         (load-cfg {:tasks {'d {:do [{:sh ["echo" :arg/x]}]}}}))))

(deftest load-rejects-placeholder-in-single-step-map-do
  ;; Validation runs before normalization, so the map form is walked too.
  (is (= {:errors [{:path [:tasks 'd :do :sh 1]
                    :msg "placeholder :arg/x used but no :args declared"}]}
         (load-cfg {:tasks {'d {:do {:sh ["echo" :arg/x]}}}}))))

(deftest load-rejects-placeholder-in-run-step
  (is (= {:errors [{:path [:tasks 'd :do 0 :run 1]
                    :msg "unknown placeholder :arg/typo (declared: :env)"}]}
         (load-cfg {:tasks {'d {:args [{:name :env}]
                                :do [{:run ["t.lg" :arg/typo]}]}}}))))

(deftest load-rejects-non-arg-keyword-in-step-vector
  (is (= {:errors [{:path [:tasks 'd :do 0 :sh 1]
                    :msg "must be a string or :arg/<name> placeholder, got :env"}]}
         (load-cfg {:tasks {'d {:do [{:sh ["echo" :env]}]}}})))
  (is (= {:errors [{:path [:tasks 'd :do 0 :sh 1]
                    :msg (str "must be a string or :arg/<name> placeholder, "
                              "got :foo/env")}]}
         (load-cfg {:tasks {'d {:do [{:sh ["echo" :foo/env]}]}}}))))

;; ---------------------------------------------------------------------------
;; load-config: single-step-map :do normalization
;; ---------------------------------------------------------------------------

(deftest load-normalizes-single-sh-step-map
  (let [r (load-cfg {:tasks {'fmt {:do {:sh "echo hi"}}}})]
    (is (= [{:sh "echo hi"}] (get-in r [:cfg :tasks 'fmt :do])))))

(deftest load-normalizes-single-run-step-map
  (let [r (load-cfg {:tasks {'check {:do {:run "scripts/test.lg"}}}})]
    (is (= [{:run "scripts/test.lg"}] (get-in r [:cfg :tasks 'check :do])))))

(deftest load-keeps-vector-do-as-is
  (let [r (load-cfg {:tasks {'ci {:do [{:sh "echo a"} {:run "t.lg"}]}}})]
    (is (= [{:sh "echo a"} {:run "t.lg"}] (get-in r [:cfg :tasks 'ci :do])))))

(deftest load-rejects-single-step-map-with-no-action-key
  (is (= {:errors [{:path [:tasks 'fmt :do]
                    :msg "must contain exactly one of :sh, :run"}]}
         (load-cfg {:tasks {'fmt {:do {}}}}))))

(deftest load-rejects-single-step-map-with-multiple-action-keys
  (is (= {:errors [{:path [:tasks 'fmt :do]
                    :msg "must contain exactly one of :sh, :run"}]}
         (load-cfg {:tasks {'fmt {:do {:sh "echo a"
                                       :run "scripts/foo.lg"}}}}))))

;; ---------------------------------------------------------------------------
;; load-config: task extras
;; ---------------------------------------------------------------------------

(deftest load-accepts-task-extras
  (let [cfg {:tasks {'dev {:doc "Dev"
                           :extra-paths ["dev"]
                           :extra-resource-paths ["assets"]
                           :extra-deps {'foo/bar {:git/url "u" :git/sha "s"}}
                           :do [{:run "dev/repl.lg"}]}}}]
    (is (= {:cfg cfg} (load-cfg cfg)))))

(deftest load-rejects-task-extra-paths-not-a-vector
  (is (= {:errors [{:path [:tasks 'dev :extra-paths]
                    :msg "must be a vector, got \"dev\""}]}
         (load-cfg {:tasks {'dev {:extra-paths "dev"
                                  :do [{:sh "echo hi"}]}}}))))

(deftest load-rejects-task-extra-paths-with-dotdot
  (is (= {:errors [{:path [:tasks 'dev :extra-paths 0]
                    :msg "must not contain .. segments"}]}
         (load-cfg {:tasks {'dev {:extra-paths ["../x"]
                                  :do [{:sh "echo hi"}]}}}))))

(deftest load-rejects-task-extra-resource-paths-not-a-vector
  (is (= {:errors [{:path [:tasks 'dev :extra-resource-paths]
                    :msg "must be a vector, got \"assets\""}]}
         (load-cfg {:tasks {'dev {:extra-resource-paths "assets"
                                  :do [{:sh "echo hi"}]}}}))))

(deftest load-rejects-task-extra-deps-not-a-map
  (is (= {:errors [{:path [:tasks 'dev :extra-deps]
                    :msg "must be a map, got [:not :a :map]"}]}
         (load-cfg {:tasks {'dev {:extra-deps [:not :a :map]
                                  :do [{:sh "echo hi"}]}}}))))

(deftest load-rejects-task-extra-deps-bad-coord
  (is (= {:errors [{:path [:tasks 'dev :extra-deps 'foo/bar]
                    :msg "must specify :git/sha or :git/tag"}]}
         (load-cfg {:tasks {'dev {:extra-deps {'foo/bar {:git/url "u"}}
                                  :do [{:sh "echo hi"}]}}}))))

;; ---------------------------------------------------------------------------
;; load-config: :with references defined contexts
;; ---------------------------------------------------------------------------

(deftest load-accepts-task-with-defined-context
  (let [cfg {:contexts {:dev {:extra-paths ["dev"]}}
             :tasks {'deploy {:with [:dev]
                            :do [{:sh "echo hi"}]}}}]
    (is (= {:cfg cfg} (load-cfg cfg)))))

(deftest load-rejects-task-with-unknown-context
  (is (= {:errors [{:path [:tasks 'deploy :with]
                    :msg "references unknown context :typo (defined: :dev)"}]}
         (load-cfg {:contexts {:dev {:extra-paths ["dev"]}}
                    :tasks {'deploy {:with [:typo]
                                   :do [{:sh "echo hi"}]}}}))))

(deftest load-rejects-task-with-when-no-contexts-defined
  (is (= {:errors [{:path [:tasks 'deploy :with]
                    :msg "references unknown context :dev (no contexts defined)"}]}
         (load-cfg {:tasks {'deploy {:with [:dev]
                                   :do [{:sh "echo hi"}]}}}))))

(deftest load-rejects-with-not-a-vector
  (is (= {:errors [{:path [:tasks 'deploy :with]
                    :msg "must be a vector, got \"dev\""}]}
         (load-cfg {:contexts {:dev {:extra-paths ["dev"]}}
                    :tasks {'deploy {:with "dev"
                                   :do [{:sh "echo hi"}]}}}))))

(deftest load-rejects-with-non-keyword-element
  (is (= {:errors [{:path [:tasks 'deploy :with 0]
                    :msg "must be a keyword, got \"dev\""}]}
         (load-cfg {:contexts {:dev {:extra-paths ["dev"]}}
                    :tasks {'deploy {:with ["dev"]
                                   :do [{:sh "echo hi"}]}}}))))

;; ---------------------------------------------------------------------------
;; load-config: :contexts
;; ---------------------------------------------------------------------------

(deftest load-accepts-contexts
  (let [cfg {:contexts {:dev {:extra-paths ["dev"]
                              :extra-resource-paths ["assets"]
                              :extra-deps {'foo/bar {:git/url "u"
                                                     :git/sha "s"}}}
                        :empty {}}}]
    (is (= {:cfg cfg} (load-cfg cfg)))))

(deftest load-rejects-contexts-not-a-map
  (is (= {:errors [{:path [:contexts] :msg "must be a map, got [:not :a :map]"}]}
         (load-cfg {:contexts [:not :a :map]}))))

(deftest load-rejects-non-keyword-context-name
  (is (= {:errors [{:path [:contexts "dev"]
                    :msg "must be a keyword, got \"dev\""}]}
         (load-cfg {:contexts {"dev" {:extra-paths ["dev"]}}}))))

(deftest load-rejects-context-with-unknown-key
  (is (= {:errors [{:path [:contexts :dev]
                    :msg (str "unknown key :extra-path (allowed: :extra-deps, "
                              ":extra-paths, :extra-resource-paths)")}]}
         (load-cfg {:contexts {:dev {:extra-path ["x"]}}}))))

(deftest load-rejects-context-with-bad-coord
  (is (= {:errors [{:path [:contexts :dev :extra-deps 'foo/bar]
                    :msg "must specify :git/sha or :git/tag"}]}
         (load-cfg {:contexts {:dev {:extra-deps {'foo/bar {:git/url "u"}}}}}))))

(deftest load-rejects-context-with-dotdot-path
  (is (= {:errors [{:path [:contexts :dev :extra-paths 0]
                    :msg "must not contain .. segments"}]}
         (load-cfg {:contexts {:dev {:extra-paths ["../x"]}}}))))

;; ---------------------------------------------------------------------------
;; load-config: error aggregation
;; ---------------------------------------------------------------------------

(deftest load-collects-multiple-errors-in-schema-order
  (is (= {:errors [{:path [:paths] :msg "must be a vector, got \"src\""}
                   {:path [:targets :bin] :msg "missing required key :out"}
                   {:path [:tasks 'lint :do 0]
                    :msg "unknown key :shh (allowed: :sh, :run)"}]}
         (load-cfg {:paths "src"
                    :targets {:bin {}}
                    :tasks {'lint {:do [{:shh "x"}]}}}))))

;; ---------------------------------------------------------------------------
;; accessors — pure functions over a loaded cfg map, no I/O
;; ---------------------------------------------------------------------------

(deftest accessors-read-cfg-values
  (let [cfg {:deps {'foo/a {:git/url "u" :git/sha "s"}}
             :paths ["src"]
             :resource-paths ["resources"]
             :main "main.lg"
             :targets {:bin {:out "bin/app"}}
             :contexts {:dev {}}
             :tasks {'fmt {:do [{:sh "echo hi"}]}}}]
    (is (= [['foo/a {:git/url "u" :git/sha "s"}]] (config/coords cfg)))
    (is (= ["src"] (config/paths cfg)))
    (is (= ["resources"] (config/resource-paths cfg)))
    (is (= "main.lg" (config/main cfg)))
    (is (= {:bin {:out "bin/app"}} (config/targets cfg)))
    (is (= {:dev {}} (config/contexts cfg)))
    (is (= {'fmt {:do [{:sh "echo hi"}]}} (config/tasks cfg)))))

(deftest accessors-default-on-empty-cfg
  (is (= [] (config/coords {})))
  (is (= [] (config/paths {})))
  (is (= [] (config/resource-paths {})))
  (is (nil? (config/main {})))
  (is (= {} (config/targets {})))
  (is (= {} (config/contexts {})))
  (is (= {} (config/tasks {}))))

(deftest accessors-read-loaded-fixture
  (let [cfg (:cfg (config/load-config "tests/fixtures/sample-project"))
        m (into {} (config/coords cfg))]
    (is (= 2 (count (config/coords cfg))))
    (is (= "https://github.com/nooga/let-go" (:git/url (get m 'nooga/let-go))))
    (is (= "46ce159c9b23021ff7bf38c14e812516c1e2e359"
           (:git/sha (get m 'nooga/let-go))))
    (is (= "v0.1.0" (:git/tag (get m 'example/tagged))))
    (is (= ["src" "test"] (config/paths cfg)))
    (is (= ["resources"] (config/resource-paths cfg)))
    (is (= "main.lg" (config/main cfg)))
    (is (= {:bin {:out "bin/sample"}} (config/targets cfg)))))

;; ---------------------------------------------------------------------------
;; merge-coords (task extras over project deps; extra wins)
;; ---------------------------------------------------------------------------

(deftest merge-coords-no-extras-returns-project-unchanged
  (let [project [['foo/a {:git/url "ua" :git/sha "sa"}]
                 ['foo/b {:git/url "ub" :git/sha "sb"}]]]
    (is (= project (config/merge-coords project [])))))

(deftest merge-coords-new-lib-is-appended-after-project
  (let [project [['foo/a {:git/url "ua" :git/sha "sa"}]]
        extra   [['foo/b {:git/url "ub" :git/sha "sb"}]]
        merged  (config/merge-coords project extra)]
    (is (= ['foo/a 'foo/b] (mapv first merged)))
    (is (= {:git/url "ub" :git/sha "sb"} (second (second merged))))))

(deftest merge-coords-colliding-lib-overrides-in-place
  (let [project [['foo/a {:git/url "ua" :git/sha "v1"}]
                 ['foo/b {:git/url "ub" :git/sha "sb"}]]
        extra   [['foo/a {:git/url "ua" :git/sha "v2"}]]
        merged  (config/merge-coords project extra)]
    ;; same length, same order, foo/a's coord replaced by the extra
    (is (= 2 (count merged)))
    (is (= ['foo/a 'foo/b] (mapv first merged)))
    (is (= {:git/url "ua" :git/sha "v2"} (second (first merged))))))

;; ---------------------------------------------------------------------------
;; context-overlay (named contexts -> combined deps-pairs + paths; last-wins)
;; ---------------------------------------------------------------------------

(deftest context-overlay-empty-names-returns-empty
  (is (= {:deps-pairs [] :paths [] :resource-paths []}
         (config/context-overlay {:dev {:extra-paths ["dev"]}} []))))

(deftest context-overlay-single-context
  (let [contexts {:dev {:extra-paths ["dev"]
                        :extra-deps {'foo/a {:git/url "ua" :git/sha "sa"}}}}
        overlay (config/context-overlay contexts [:dev])]
    (is (= ['foo/a] (mapv first (:deps-pairs overlay))))
    (is (= {:git/url "ua" :git/sha "sa"} (second (first (:deps-pairs overlay)))))
    (is (= ["dev"] (:paths overlay)))))

(deftest context-overlay-two-contexts-union
  (let [contexts {:dev {:extra-paths ["dev"]
                        :extra-deps {'foo/a {:git/url "ua" :git/sha "sa"}}}
                  :test {:extra-paths ["test-support"]
                         :extra-deps {'foo/b {:git/url "ub" :git/sha "sb"}}}}
        overlay (config/context-overlay contexts [:dev :test])]
    (is (= ['foo/a 'foo/b] (mapv first (:deps-pairs overlay))))
    (is (= ["dev" "test-support"] (:paths overlay)))))

(deftest context-overlay-overlap-last-wins-in-place
  (let [contexts {:dev {:extra-deps {'foo/c {:git/url "uc" :git/sha "v1"}}}
                  :test {:extra-deps {'foo/c {:git/url "uc" :git/sha "v2"}}}}
        overlay (config/context-overlay contexts [:dev :test])]
    ;; foo/c appears once, at its first position, with the later coord
    (is (= ['foo/c] (mapv first (:deps-pairs overlay))))
    (is (= {:git/url "uc" :git/sha "v2"}
           (second (first (:deps-pairs overlay)))))))

(deftest context-overlay-unknown-name-throws
  (is (= :threw (threw? #(config/context-overlay {:dev {:extra-paths ["dev"]}}
                                                 [:nope])))))

(deftest context-overlay-empty-names-has-empty-resource-paths
  (is (= [] (:resource-paths
              (config/context-overlay {:dev {:extra-resource-paths ["assets"]}}
                                      [])))))

(deftest context-overlay-single-context-resource-paths
  (let [contexts {:dev {:extra-resource-paths ["assets"]}}
        overlay (config/context-overlay contexts [:dev])]
    (is (= ["assets"] (:resource-paths overlay)))))

(deftest context-overlay-two-contexts-concat-resource-paths
  (let [contexts {:dev {:extra-resource-paths ["assets"]}
                  :test {:extra-resource-paths ["fixtures"]}}
        overlay (config/context-overlay contexts [:dev :test])]
    (is (= ["assets" "fixtures"] (:resource-paths overlay)))))

;; ---------------------------------------------------------------------------
;; auto-context (convention contexts auto-applied by run/nrepl/test)
;; ---------------------------------------------------------------------------

(deftest auto-context-returns-name-when-defined
  (is (= [:dev] (config/auto-context {:contexts {:dev {:extra-paths ["dev"]}}}
                                     :dev))))

(deftest auto-context-returns-empty-when-name-absent
  (is (= [] (config/auto-context {:contexts {:dev {:extra-paths ["dev"]}}}
                                 :test))))

(deftest auto-context-returns-empty-without-contexts
  (is (= [] (config/auto-context {} :dev))))

;; ---------------------------------------------------------------------------
;; coords-at (transitive: a fetched dep's own deps)
;; ---------------------------------------------------------------------------

(deftest coords-at-reads-fixture-deps
  (let [cs (config/coords-at "tests/fixtures/sample-project")
        m (into {} cs)]
    (is (= 2 (count cs)))
    (is (= "https://github.com/nooga/let-go" (:git/url (get m 'nooga/let-go))))))

(deftest coords-at-returns-empty-when-no-lgx-edn
  (let [dir (str "/tmp/lgx-coords-at-test-" (rand-int 100000000))]
    (mkdir dir)
    (is (= [] (config/coords-at dir)))
    (os/sh "rm" "-rf" dir)))

(deftest coords-at-returns-empty-when-deps-absent
  (let [dir (str "/tmp/lgx-coords-at-test-" (rand-int 100000000))]
    (mkdir dir)
    (spit (str dir "/lgx.edn") "{:paths [\"src\"]}")
    (is (= [] (config/coords-at dir)))
    (os/sh "rm" "-rf" dir)))

(deftest coords-at-rejects-non-map-top-level
  (let [dir (str "/tmp/lgx-coords-at-test-" (rand-int 100000000))]
    (mkdir dir)
    (spit (str dir "/lgx.edn") "[:not :a :map]")
    (is (= :threw (threw? #(config/coords-at dir))))
    (os/sh "rm" "-rf" dir)))

(deftest coords-at-rejects-deps-not-a-map
  (doseq [form ["{:deps []}" "{:deps \"not-a-map\"}"]]
    (let [dir (str "/tmp/lgx-coords-at-test-" (rand-int 100000000))]
      (mkdir dir)
      (spit (str dir "/lgx.edn") form)
      (is (= :threw (threw? #(config/coords-at dir))))
      (os/sh "rm" "-rf" dir))))

(deftest coords-at-is-lenient-about-other-keys
  ;; A dep's lgx.edn may carry a malformed :tasks or a top-level key a newer
  ;; lgx added; only its :deps matter and must still be returned.
  (let [dir (str "/tmp/lgx-coords-at-test-" (rand-int 100000000))]
    (mkdir dir)
    (spit (str dir "/lgx.edn")
          (str "{:deps {foo/bar {:git/url \"https://github.com/foo/bar\" :git/sha \"abc\"}}"
               " :tasks \"not-a-valid-tasks-map\""
               " :future/key 123}"))
    (let [m (into {} (config/coords-at dir))]
      (is (= "abc" (:git/sha (get m 'foo/bar)))))
    (os/sh "rm" "-rf" dir)))

(deftest coords-at-still-validates-its-coords
  ;; Leniency is only about non-:deps keys; a broken coord must still throw.
  (let [dir (str "/tmp/lgx-coords-at-test-" (rand-int 100000000))]
    (mkdir dir)
    (spit (str dir "/lgx.edn")
          "{:deps {bad/coord {:local/root \"x\" :git/url \"y\" :git/sha \"z\"}}}")
    (is (= :threw (threw? #(config/coords-at dir))))
    (os/sh "rm" "-rf" dir)))

(deftest coords-at-error-carries-rendered-report-and-marker
  ;; The thrown ex-info's message is the full report naming the dep dir, and
  ;; ex-data carries :lgx/invalid-dep-config so the caller can catch, print,
  ;; and exit without a stack trace.
  (let [dir (str "/tmp/lgx-coords-at-test-" (rand-int 100000000))]
    (mkdir dir)
    (spit (str dir "/lgx.edn") "{:deps {foo/bar {:git/url \"u\"}}}")
    (let [r (try
              (config/coords-at dir)
              (catch e {:msg (ex-message e) :data (ex-data e)}))]
      (is (= dir (:lgx/invalid-dep-config (:data r))))
      (is (str/includes? (:msg r) (str "invalid lgx.edn in " dir " (1 error)")))
      (is (str/includes? (:msg r) "must specify :git/sha or :git/tag")))
    (os/sh "rm" "-rf" dir)))

;; ---------------------------------------------------------------------------
;; declared-deps-at / project-clj-deps-at (third-party metadata, best-effort)
;; ---------------------------------------------------------------------------

;; Write `files` ({name content}) into a throwaway dir and call f with it.
(defn- with-dir [files f]
  (let [dir (str "/tmp/lgx-declared-deps-test-" (rand-int 100000000))]
    (mkdir dir)
    (doseq [[nm content] files]
      (spit (str dir "/" nm) content))
    (let [r (f dir)]
      (os/sh "rm" "-rf" dir)
      r)))

(deftest declared-deps-at-returns-empty-when-no-deps-edn
  (is (= [] (with-dir {} config/declared-deps-at))))

(deftest declared-deps-at-reads-top-level-deps
  (is (= {'a/b {:mvn/version "1.2"}
          'c/d {:git/url "u" :git/sha "s"}}
         (with-dir {"deps.edn" (str "{:paths [\"src\"]"
                                    " :deps {a/b {:mvn/version \"1.2\"}"
                                    "        c/d {:git/url \"u\" :git/sha \"s\"}}}")}
           (fn [dir] (into {} (config/declared-deps-at dir)))))))

(deftest declared-deps-at-ignores-aliases
  (is (= ['a/b]
         (with-dir {"deps.edn" (str "{:deps {a/b {:mvn/version \"1\"}}"
                                    " :aliases {:test {:extra-deps"
                                    " {only/in-alias {:mvn/version \"2\"}}}}}")}
           (fn [dir] (mapv first (config/declared-deps-at dir)))))))

(deftest declared-deps-at-returns-empty-on-unparsable-file
  ;; Third-party metadata: a parse failure is not this project's problem.
  (is (= [] (with-dir {"deps.edn" "{:deps {a/b "} config/declared-deps-at))))

(deftest declared-deps-at-returns-empty-on-non-map-top-level
  (is (= [] (with-dir {"deps.edn" "[:not :a :map]"} config/declared-deps-at))))

(deftest declared-deps-at-returns-empty-on-non-map-deps
  (doseq [form ["{:deps []}" "{:deps \"nope\"}" "{:paths [\"src\"]}"]]
    (is (= [] (with-dir {"deps.edn" form} config/declared-deps-at)))))

(deftest declared-deps-at-drops-non-symbol-lib-names
  (is (= ['a/b]
         (with-dir {"deps.edn" "{:deps {a/b {:mvn/version \"1\"} :kw {} \"s\" {}}}"}
           (fn [dir] (mapv first (config/declared-deps-at dir)))))))

(deftest project-clj-deps-at-returns-empty-when-absent
  (is (= [] (with-dir {} config/project-clj-deps-at))))

(deftest project-clj-deps-at-translates-dependencies-to-mvn-coords
  (is (= {'a/b {:mvn/version "1.2"}
          'c {:mvn/version "3.4"}}
         (with-dir {"project.clj" (str "(defproject foo \"1.0\""
                                       " :dependencies [[a/b \"1.2\"] [c \"3.4\"]])")}
           (fn [dir] (into {} (config/project-clj-deps-at dir)))))))

(deftest project-clj-deps-at-keeps-bare-symbol-as-written
  ;; No group inference: `c` stays `c`, not `c/c`. Matching is the
  ;; suppression heuristic's job, not the reader's.
  (is (= ['c]
         (with-dir {"project.clj" "(defproject foo \"1.0\" :dependencies [[c \"3.4\"]])"}
           (fn [dir] (mapv first (config/project-clj-deps-at dir)))))))

(deftest project-clj-deps-at-ignores-trailing-entry-options
  ;; Leiningen entries may carry :scope/:exclusions after the version.
  (is (= {'org.clojure/clojure {:mvn/version "1.7.0"}}
         (with-dir {"project.clj"
                    (str "(defproject foo \"1.0\" :dependencies"
                         " [[org.clojure/clojure \"1.7.0\" :scope \"provided\"]])")}
           (fn [dir] (into {} (config/project-clj-deps-at dir)))))))

(deftest project-clj-deps-at-ignores-profile-dependencies
  ;; Only the top-level :dependencies vector counts; profiles are out of scope.
  (is (= ['a/b]
         (with-dir {"project.clj"
                    (str "(defproject foo \"1.0\" :dependencies [[a/b \"1.2\"]]"
                         " :profiles {:dev {:dependencies [[only/dev \"9\"]]}})")}
           (fn [dir] (mapv first (config/project-clj-deps-at dir)))))))

(deftest project-clj-deps-at-tolerates-reader-unfriendly-content
  ;; ~unquote, @deref, and #"regex" appear in real project.clj files; whatever
  ;; the reader makes of them, the :dependencies vector must still come out.
  (is (= ['a/b]
         (with-dir {"project.clj"
                    (str ";; a comment\n(defproject foo \"1.0\""
                         " :username ~(System/getenv \"U\")"
                         " :ns [#\"^a\\.b\"]"
                         " :dependencies [[a/b \"1.2\"]])\n(println :extra)")}
           (fn [dir] (mapv first (config/project-clj-deps-at dir)))))))

(deftest project-clj-deps-at-returns-empty-on-unparsable-file
  (doseq [content ["" "(defproject foo" "not-a-list"]]
    (is (= [] (with-dir {"project.clj" content} config/project-clj-deps-at)))))

(deftest project-clj-deps-at-returns-empty-when-not-defproject
  (is (= [] (with-dir {"project.clj" "(ns foo.bar)"} config/project-clj-deps-at))))

(deftest project-clj-deps-at-returns-empty-without-dependencies-key
  (is (= [] (with-dir {"project.clj" "(defproject foo \"1.0\" :url \"u\")"}
              config/project-clj-deps-at))))

;; ---------------------------------------------------------------------------
;; Deterministic coord ordering
;;
;; let-go's map iteration order follows the bundle's intern layout, so it is
;; neither insertion order nor stable across unrelated edits. Resolution order
;; is observable (first-wins conflicts, dep source-path precedence), so every
;; coord map is ordered by lib name on the way in.
;; ---------------------------------------------------------------------------

(deftest dep-pairs-orders-by-lib-name
  (is (= ['a/z 'b/a 'c/m]
         (mapv first (config/dep-pairs {'c/m {} 'a/z {} 'b/a {}}))))
  (is (= [] (config/dep-pairs {})))
  (is (= [] (config/dep-pairs nil))))

(deftest dep-pairs-orders-by-full-name-not-just-group
  (is (= ['dev.weavejester/dependency 'dev.weavejester/medley]
         (mapv first (config/dep-pairs {'dev.weavejester/medley {}
                                        'dev.weavejester/dependency {}})))))

(deftest coords-are-ordered-by-lib-name
  (let [cfg (:cfg (load-cfg {:deps {'z/last {:git/url "u" :git/sha "s"}
                                    'a/first {:git/url "u" :git/sha "s"}
                                    'm/mid {:git/url "u" :git/sha "s"}}}))]
    (is (= ['a/first 'm/mid 'z/last] (mapv first (config/coords cfg))))))

(deftest coords-at-is-ordered-by-lib-name
  (let [dir (str "/tmp/lgx-coord-order-test-" (rand-int 100000000))]
    (mkdir dir)
    (spit (str dir "/lgx.edn")
          (str "{:deps {z/last {:git/url \"u\" :git/sha \"s\"}"
               "        a/first {:git/url \"u\" :git/sha \"s\"}}}"))
    (is (= ['a/first 'z/last] (mapv first (config/coords-at dir))))
    (os/sh "rm" "-rf" dir)))

(deftest declared-deps-at-is-ordered-by-lib-name
  (is (= ['a/first 'z/last]
         (with-dir {"deps.edn" (str "{:deps {z/last {:mvn/version \"1\"}"
                                    "        a/first {:mvn/version \"1\"}}}")}
           (fn [dir] (mapv first (config/declared-deps-at dir)))))))

;; ---------------------------------------------------------------------------
;; classify-declared (what one declared transitive dep means to lgx)
;; ---------------------------------------------------------------------------

(deftest classify-well-formed-git-coord-resolves-as-is
  (let [coord {:git/url "https://github.com/foo/bar" :git/sha "abc"}]
    (is (= {:action :resolve :coord coord}
           (config/classify-declared 'foo/bar coord)))))

(deftest classify-git-tag-coord-resolves
  (let [coord {:git/url "https://github.com/foo/bar" :git/tag "v1.0"}]
    (is (= {:action :resolve :coord coord}
           (config/classify-declared 'foo/bar coord)))))

(deftest classify-normalizes-bare-sha-key
  ;; Real deps.edn files use both :sha and :git/sha for the same thing.
  (is (= {:action :resolve
          :coord {:git/url "https://github.com/foo/bar" :git/sha "abc"}}
         (config/classify-declared 'foo/bar
                                   {:git/url "https://github.com/foo/bar"
                                    :sha "abc"}))))

(deftest classify-infers-github-url-from-io-github-group
  (is (= {:action :resolve
          :coord {:git/sha "abc"
                  :git/url "https://github.com/cognitect-labs/test-runner"}}
         (config/classify-declared 'io.github.cognitect-labs/test-runner
                                   {:git/sha "abc"}))))

(deftest classify-infers-github-url-from-com-github-group
  (is (= {:action :resolve
          :coord {:git/tag "v1.0" :git/url "https://github.com/owner/repo"}}
         (config/classify-declared 'com.github.owner/repo {:git/tag "v1.0"}))))

(deftest classify-does-not-infer-url-without-a-ref
  ;; No sha and no tag means nothing to pin to — inference alone is not enough.
  (is (= :warn (:action (config/classify-declared 'io.github.owner/repo {})))))

(deftest classify-keeps-explicit-url-over-inferred-one
  (let [coord {:git/url "https://example.com/mirror/repo" :git/sha "abc"}]
    (is (= {:action :resolve :coord coord}
           (config/classify-declared 'io.github.owner/repo coord)))))

(deftest classify-mvn-version-reports-the-version
  (is (= {:action :mvn :version "0.2.1"}
         (config/classify-declared 'weavejester/dependency
                                   {:mvn/version "0.2.1"}))))

(deftest classify-local-root-resolves
  (let [coord {:local/root "../sibling"}]
    (is (= {:action :resolve :coord coord}
           (config/classify-declared 'my/lib coord)))))

(deftest classify-skips-clojure-itself
  (doseq [lib ['org.clojure/clojure
               'org.clojure/spec.alpha
               'org.clojure/core.specs.alpha]]
    (is (= {:action :skip}
           (config/classify-declared lib {:mvn/version "1.11.4"})))))

(deftest classify-skip-wins-over-every-other-shape
  (is (= {:action :skip}
         (config/classify-declared 'org.clojure/clojure
                                   {:git/url "u" :git/sha "s"}))))

(deftest classify-warns-on-malformed-coords
  (doseq [coord [{} nil "not-a-map" {:git/url "u"} {:git/sha "abc"}
                 {:mvn/version 5}]]
    (is (= :warn (:action (config/classify-declared 'foo/bar coord)))
        (pr-str coord))))

(deftest classify-warns-on-blank-local-root
  ;; A blank root would resolve to the declaring dep's own directory, quietly
  ;; passing that dep off as its child. lgx's own schema rejects blank roots;
  ;; third-party metadata gets the same treatment.
  (doseq [coord [{:local/root ""} {:local/root "   "} {:local/root 5}]]
    (is (= :warn (:action (config/classify-declared 'foo/bar coord)))
        (pr-str coord))))

;; ---------------------------------------------------------------------------
;; without-exclusions (drop what the consuming coord excluded)
;; ---------------------------------------------------------------------------

(deftest without-exclusions-drops-exact-symbol-matches
  (is (= ['keep/me]
         (mapv first (config/without-exclusions
                       ['drop/me]
                       [['drop/me {:mvn/version "1"}]
                        ['keep/me {:mvn/version "2"}]])))))

(deftest without-exclusions-is-exact-not-fuzzy
  ;; Exclusions name what the dep declares, verbatim — no group inference.
  (is (= ['dev.weavejester/dependency]
         (mapv first (config/without-exclusions
                       ['weavejester/dependency]
                       [['dev.weavejester/dependency {:mvn/version "1"}]])))))

(deftest without-exclusions-with-no-exclusions-is-identity
  (let [declared [['a/b {:mvn/version "1"}]]]
    (is (= declared (config/without-exclusions nil declared)))
    (is (= declared (config/without-exclusions [] declared)))))

;; ---------------------------------------------------------------------------
;; unresolved-declared (suppression: is this declared dep already resolved?)
;; ---------------------------------------------------------------------------

(defn- pending [lib coord]
  {:declaring 'some/dep :declared [lib coord]})

(deftest unresolved-declared-suppresses-on-normalized-url-match
  ;; Trailing .git and trailing slash are noise, not identity.
  (doseq [resolved-url ["https://github.com/foo/bar"
                        "https://github.com/foo/bar.git"
                        "https://github.com/foo/bar/"]]
    (is (= []
           (config/unresolved-declared
             {'other/name {:git/url resolved-url :git/sha "s"}}
             [(pending 'foo/bar {:git/url "https://github.com/foo/bar"
                                 :git/sha "abc"})])))))

(deftest unresolved-declared-suppresses-on-inferred-url-match
  (is (= []
         (config/unresolved-declared
           {'anything/atall {:git/url "https://github.com/owner/repo"
                             :git/tag "v1"}}
           [(pending 'io.github.owner/repo {:git/sha "abc"})]))))

(deftest unresolved-declared-keeps-entry-when-url-differs
  (is (= 1
         (count (config/unresolved-declared
                  {'foo/bar {:git/url "https://github.com/other/repo"
                             :git/sha "s"}}
                  [(pending 'foo/bar {:git/url "https://github.com/foo/bar"
                                      :git/sha "abc"})])))))

(deftest unresolved-declared-suppresses-on-exact-lib-match
  (is (= []
         (config/unresolved-declared
           {'weavejester/dependency {:git/url "https://github.com/w/d"
                                     :git/tag "1.0.1"}}
           [(pending 'weavejester/dependency {:mvn/version "0.2.1"})]))))

(deftest unresolved-declared-suppresses-on-artifact-segment-match
  ;; The user pinned the lib under its new Clojars group; the dep declares the
  ;; old one. Same artifact, so stay quiet.
  (is (= []
         (config/unresolved-declared
           {'dev.weavejester/dependency {:git/url "https://github.com/w/d"
                                         :git/tag "1.0.1"}}
           [(pending 'weavejester/dependency {:mvn/version "0.2.1"})]))))

(deftest unresolved-declared-keeps-genuinely-missing-dep
  (let [p (pending 'unknown/lib {:mvn/version "1.2.3"})]
    (is (= [p]
           (config/unresolved-declared
             {'dev.weavejester/dependency {:git/url "u" :git/tag "t"}}
             [p])))))

(deftest unresolved-declared-ignores-local-coords-when-url-matching
  ;; A resolved :local/root coord has no URL; it must not blow up the match.
  (is (= 1
         (count (config/unresolved-declared
                  {'my/lib {:local/root "/abs/path"}}
                  [(pending 'foo/bar {:git/url "https://github.com/foo/bar"
                                      :git/sha "abc"})])))))

(deftest unresolved-declared-empty-inputs
  (is (= [] (config/unresolved-declared {} [])))
  (is (= [] (config/unresolved-declared {'a/b {:git/url "u" :git/sha "s"}} []))))

(deftest project-clj-deps-at-skips-malformed-entries
  ;; A bare symbol, an empty vector, and a non-string version are dropped;
  ;; well-formed neighbours still come through.
  (is (= ['a/b]
         (with-dir {"project.clj"
                    (str "(defproject foo \"1.0\" :dependencies"
                         " [bare [] [no/version] [x/y 5] [a/b \"1.2\"]])")}
           (fn [dir] (mapv first (config/project-clj-deps-at dir)))))))
