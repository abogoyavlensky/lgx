;; Unit tests for lgx.runner.
;; Run with: lgx test  (from project root)

(ns lgx.runner-test
  (:require [lgx.runner :as runner]
            [clojure.test :refer [deftest is]]))

(deftest env-trace-line-lists-set-vars-in-order
  (is (= "+ env LG_READ_CLJ=1 LGX_RUN=1\n"
         (runner/env-trace-line {"LG_READ_CLJ" "1" "LGX_RUN" "1"}))))

(deftest env-trace-line-includes-suppress-warning
  (is (= "+ env LG_READ_CLJ=1 LG_SUPPRESS_SOURCE_PATHS_WARNING=1 LGX_RUN=1\n"
         (runner/env-trace-line {"LG_READ_CLJ" "1"
                                 "LG_SUPPRESS_SOURCE_PATHS_WARNING" "1"
                                 "LGX_RUN" "1"}))))

(deftest env-trace-line-omits-missing-vars
  (is (= "+ env LG_READ_CLJ=1\n"
         (runner/env-trace-line {"LG_READ_CLJ" "1"}))))

(deftest env-trace-line-omits-blank-vars
  (is (= "+ env LG_READ_CLJ=1\n"
         (runner/env-trace-line {"LG_READ_CLJ" "1" "LGX_RUN" ""}))))

(deftest env-trace-line-nil-when-none-set
  (is (nil? (runner/env-trace-line {"LG_READ_CLJ" "" "LGX_RUN" ""}))))

;; ---------------------------------------------------------------------------
;; binary-trace-line
;; ---------------------------------------------------------------------------

(deftest binary-trace-line-version-and-path
  (is (= "+ lg 1.10.0 (/usr/local/bin/lg)\n"
         (runner/binary-trace-line "1.10.0" "/usr/local/bin/lg" "lg"))))

(deftest binary-trace-line-omits-blank-version
  (is (= "+ lg (/usr/local/bin/lg)\n"
         (runner/binary-trace-line nil "/usr/local/bin/lg" "lg")))
  (is (= "+ lg (/usr/local/bin/lg)\n"
         (runner/binary-trace-line "" "/usr/local/bin/lg" "lg"))))

(deftest binary-trace-line-falls-back-to-bin-when-path-blank
  (is (= "+ lg 1.10.0 (lg)\n"
         (runner/binary-trace-line "1.10.0" nil "lg")))
  (is (= "+ lg 1.10.0 (mylg)\n"
         (runner/binary-trace-line "1.10.0" "" "mylg"))))

;; ---------------------------------------------------------------------------
;; display-path (explicit LGX_LG-path branch)
;; ---------------------------------------------------------------------------

(deftest display-path-keeps-absolute-bin
  (is (= "/opt/lg"
         (runner/display-path "/opt/lg" "/home/u/proj"))))

(deftest display-path-resolves-relative-against-cwd
  (is (= "/home/u/proj/.tmp/lg"
         (runner/display-path "./.tmp/lg" "/home/u/proj"))))

;; ---------------------------------------------------------------------------
;; lg-args
;; ---------------------------------------------------------------------------

(deftest lg-args-builds-full-argv
  (is (= ["-source-paths" (str "a" os/path-separator "b")
          "-resource-paths" "res"
          "main.lg" "--"]
         (runner/lg-args ["a" "b"] ["res"] ["main.lg" "--"]))))

(deftest lg-args-omits-empty-path-flags
  (is (= ["main.lg"]
         (runner/lg-args [] [] ["main.lg"]))))

(deftest lg-args-empty-everything
  (is (= [] (runner/lg-args [] [] []))))

;; ---------------------------------------------------------------------------
;; plan-run-args
;;
;; Pure decision for cmd-run's lg argv: inject :main where needed, drop the
;; lgx/app separator `--`, and never emit a `--` of lgx's own. A second,
;; user-authored `--` is preserved as a literal arg.
;; ---------------------------------------------------------------------------

(deftest plan-run-args-empty-with-main-injects
  (is (= {:argv ["main.lg"] :inject? true}
         (runner/plan-run-args [] "main.lg"))))

(deftest plan-run-args-empty-without-main-is-repl-passthrough
  (is (= {:argv [] :inject? false}
         (runner/plan-run-args [] nil))))

(deftest plan-run-args-double-dash-injects-main-before-args
  (is (= {:argv ["main.lg" "list"] :inject? true}
         (runner/plan-run-args ["--" "list"] "main.lg"))))

(deftest plan-run-args-double-dash-shields-flag-looking-arg
  (is (= {:argv ["main.lg" "-v"] :inject? true}
         (runner/plan-run-args ["--" "-v"] "main.lg"))))

(deftest plan-run-args-lg-flag-before-separator-stays-before-main
  (is (= {:argv ["-r" "main.lg" "foo"] :inject? true}
         (runner/plan-run-args ["-r" "--" "foo"] "main.lg"))))

(deftest plan-run-args-second-double-dash-preserved-as-literal
  (is (= {:argv ["main.lg" "a" "--" "b"] :inject? true}
         (runner/plan-run-args ["--" "a" "--" "b"] "main.lg"))))

(deftest plan-run-args-explicit-script-drops-separator
  (is (= {:argv ["other.lg" "bar"] :inject? false}
         (runner/plan-run-args ["other.lg" "--" "bar"] "main.lg"))))

(deftest plan-run-args-explicit-script-without-main-set
  (is (= {:argv ["other.lg" "bar"] :inject? false}
         (runner/plan-run-args ["other.lg" "--" "bar"] nil))))

(deftest plan-run-args-no-separator-passes-through
  (is (= {:argv ["other.lg" "arg"] :inject? false}
         (runner/plan-run-args ["other.lg" "arg"] "main.lg")))
  (is (= {:argv ["-e" "(prn 1)"] :inject? false}
         (runner/plan-run-args ["-e" "(prn 1)"] "main.lg"))))

(deftest plan-run-args-double-dash-without-main-errors
  (is (= {:error :needs-main}
         (runner/plan-run-args ["--" "foo"] nil))))
