;; Unit tests for lgx.runner.
;; Run with: lgx test  (from project root)

(ns lgx.runner-test
  (:require [lgx.runner :as runner]
            [clojure.test :refer [deftest is]]))

(deftest env-trace-line-lists-set-vars-in-order
  (is (= "+ env LG_READ_CLJ=1 LGX_RUN=1\n"
         (runner/env-trace-line {"LG_READ_CLJ" "1" "LGX_RUN" "1"}))))

(deftest env-trace-line-includes-suppress-warning
  (is (= "+ env LG_READ_CLJ=1 LG_SUPPRESS_SOURCE_PATHS_WARNING=1 LGX_RUN=1\n"
         (runner/env-trace-line {"LG_READ_CLJ" "1"
                                 "LG_SUPPRESS_SOURCE_PATHS_WARNING" "1"
                                 "LGX_RUN" "1"}))))

(deftest env-trace-line-omits-missing-vars
  (is (= "+ env LG_READ_CLJ=1\n"
         (runner/env-trace-line {"LG_READ_CLJ" "1"}))))

(deftest env-trace-line-omits-blank-vars
  (is (= "+ env LG_READ_CLJ=1\n"
         (runner/env-trace-line {"LG_READ_CLJ" "1" "LGX_RUN" ""}))))

(deftest env-trace-line-nil-when-none-set
  (is (nil? (runner/env-trace-line {"LG_READ_CLJ" "" "LGX_RUN" ""}))))

;; ---------------------------------------------------------------------------
;; lg-args
;; ---------------------------------------------------------------------------

(deftest lg-args-builds-full-argv
  (is (= ["-source-paths" (str "a" os/path-separator "b")
          "-resource-paths" "res"
          "main.lg" "--"]
         (runner/lg-args ["a" "b"] ["res"] ["main.lg" "--"]))))

(deftest lg-args-omits-empty-path-flags
  (is (= ["main.lg"]
         (runner/lg-args [] [] ["main.lg"]))))

(deftest lg-args-empty-everything
  (is (= [] (runner/lg-args [] [] []))))
