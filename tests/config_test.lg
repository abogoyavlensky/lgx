;; Unit tests for lgx.config — pure parsing/validation helpers.
;; Run with: lg tests/config_test.lg  (from project root)

(ns lgx.config-test
  (:require [lgx.config :as config]
            [test :refer [deftest is run-tests]]))

(defn- threw? [f]
  (try (f) :no-throw (catch e :threw)))

;; ---------------------------------------------------------------------------
;; validate-config!
;; ---------------------------------------------------------------------------

(deftest validate-config-accepts-valid-deps
  (is (= {:deps {'nooga/let-go {:git/url "https://github.com/nooga/let-go"
                                :git/sha "abc"}}}
         (config/validate-config!
           {:deps {'nooga/let-go {:git/url "https://github.com/nooga/let-go"
                                  :git/sha "abc"}}}))))

(deftest validate-config-accepts-tag-only-coord
  (is (= {:deps {'foo/bar {:git/url "https://github.com/foo/bar"
                           :git/tag "v0.1.0"}}}
         (config/validate-config!
           {:deps {'foo/bar {:git/url "https://github.com/foo/bar"
                             :git/tag "v0.1.0"}}}))))

(deftest validate-config-accepts-local-root
  (let [cfg {:deps {'my/lib {:local/root "../mylib"}}}]
    (is (= cfg (config/validate-config! cfg)))))

(deftest validate-config-accepts-local-root-with-deps-root
  (let [cfg {:deps {'my/lib {:local/root "../mylib"
                             :deps/root "src/main/clojure"}}}]
    (is (= cfg (config/validate-config! cfg)))))

(deftest validate-config-accepts-absolute-local-root
  (let [cfg {:deps {'my/lib {:local/root "/abs/path"}}}]
    (is (= cfg (config/validate-config! cfg)))))

(deftest validate-config-accepts-local-root-with-dotdot
  (let [cfg {:deps {'my/lib {:local/root "../sibling"}}}]
    (is (= cfg (config/validate-config! cfg)))))

(deftest validate-config-accepts-empty-deps
  (is (= {:deps {}} (config/validate-config! {:deps {}})))
  (is (= {} (config/validate-config! {}))))

(deftest validate-config-accepts-paths
  (is (= {:paths ["src" "resources"]
          :deps {}}
         (config/validate-config! {:paths ["src" "resources"]
                                   :deps {}}))))

(deftest validate-config-accepts-empty-paths
  (is (= {:paths []}
         (config/validate-config! {:paths []}))))

(deftest validate-config-rejects-non-map-top-level
  (is (= :threw (threw? #(config/validate-config! [:not :a :map])))))

(deftest validate-config-rejects-unknown-top-level-key
  (is (= :threw (threw? #(config/validate-config! {:deps {}
                                                   :extra 1})))))

(deftest validate-config-rejects-deps-not-a-map
  (is (= :threw (threw? #(config/validate-config! {:deps [:not :a :map]})))))

(deftest validate-config-rejects-paths-not-a-vector
  (is (= :threw (threw? #(config/validate-config! {:paths "src"})))))

(deftest validate-config-rejects-coord-missing-url
  (is (= :threw (threw? #(config/validate-config!
                           {:deps {'foo/bar {:git/sha "abc"}}})))))

(deftest validate-config-rejects-coord-without-sha-or-tag
  (is (= :threw (threw? #(config/validate-config!
                           {:deps {'foo/bar {:git/url "https://github.com/foo/bar"}}})))))

(deftest validate-config-rejects-non-map-coord
  (is (= :threw (threw? #(config/validate-config!
                           {:deps {'foo/bar "not-a-map"}})))))

(deftest validate-config-rejects-blank-local-root
  (is (= :threw (threw? #(config/validate-config!
                           {:deps {'my/lib {:local/root ""}}}))))
  (is (= :threw (threw? #(config/validate-config!
                           {:deps {'my/lib {:local/root "   "}}})))))

(deftest validate-config-rejects-non-string-local-root
  (is (= :threw (threw? #(config/validate-config!
                           {:deps {'my/lib {:local/root 5}}})))))

(deftest validate-config-rejects-mixed-local-and-git
  (doseq [coord [{:local/root "../mylib"
                  :git/url "https://github.com/foo/bar"}
                 {:local/root "../mylib"
                  :git/sha "abc"}
                 {:local/root "../mylib"
                  :git/tag "v0.1.0"}]]
    (is (= :threw (threw? #(config/validate-config!
                             {:deps {'my/lib coord}}))))))

(deftest validate-config-accepts-deps-root
  (let [cfg {:deps {'foo/bar {:git/url "https://github.com/foo/bar"
                              :git/sha "abc"
                              :deps/root "src/main/clojure"}}}]
    (is (= cfg (config/validate-config! cfg)))))

(deftest validate-config-rejects-blank-deps-root
  (is (= :threw (threw? #(config/validate-config!
                           {:deps {'foo/bar {:git/url "https://github.com/foo/bar"
                                             :git/sha "abc"
                                             :deps/root ""}}}))))
  (is (= :threw (threw? #(config/validate-config!
                           {:deps {'foo/bar {:git/url "https://github.com/foo/bar"
                                             :git/sha "abc"
                                             :deps/root "   "}}})))))

(deftest validate-config-rejects-non-string-deps-root
  (is (= :threw (threw? #(config/validate-config!
                           {:deps {'foo/bar {:git/url "https://github.com/foo/bar"
                                             :git/sha "abc"
                                             :deps/root 5}}})))))

(deftest validate-config-rejects-absolute-deps-root
  (is (= :threw (threw? #(config/validate-config!
                           {:deps {'foo/bar {:git/url "https://github.com/foo/bar"
                                             :git/sha "abc"
                                             :deps/root "/src"}}})))))

(deftest validate-config-rejects-parent-traversal
  (is (= :threw (threw? #(config/validate-config!
                           {:deps {'foo/bar {:git/url "https://github.com/foo/bar"
                                             :git/sha "abc"
                                             :deps/root ".."}}}))))
  (is (= :threw (threw? #(config/validate-config!
                           {:deps {'foo/bar {:git/url "https://github.com/foo/bar"
                                             :git/sha "abc"
                                             :deps/root "src/../etc"}}})))))

(deftest validate-config-rejects-blank-paths-entry
  (is (= :threw (threw? #(config/validate-config! {:paths [""]})))))

(deftest validate-config-rejects-non-string-paths-entry
  (is (= :threw (threw? #(config/validate-config! {:paths [5]})))))

(deftest validate-config-rejects-absolute-paths-entry
  (is (= :threw (threw? #(config/validate-config! {:paths ["/abs"]})))))

(deftest validate-config-rejects-parent-traversal-paths-entry
  (is (= :threw (threw? #(config/validate-config! {:paths ["../etc"]})))))

;; ---------------------------------------------------------------------------
;; coords
;; ---------------------------------------------------------------------------

(deftest coords-reads-and-parses-fixture
  (let [cs (config/coords "tests/fixtures/sample-project")
        m (into {} cs)]
    (is (= 2 (count cs)))
    (is (= "https://github.com/nooga/let-go" (:git/url (get m 'nooga/let-go))))
    (is (= "46ce159c9b23021ff7bf38c14e812516c1e2e359"
           (:git/sha (get m 'nooga/let-go))))
    (is (= "v0.1.0" (:git/tag (get m 'example/tagged))))))

;; ---------------------------------------------------------------------------
;; paths
;; ---------------------------------------------------------------------------

(deftest paths-returns-empty-when-absent
  (is (= [] (or (:paths (config/validate-config! {:deps {}})) []))))

(deftest paths-reads-fixture
  (is (= ["src" "test"] (config/paths "tests/fixtures/sample-project"))))

;; ---------------------------------------------------------------------------
;; :main validation
;; ---------------------------------------------------------------------------

(deftest validate-config-accepts-main
  (let [cfg {:main "main.lg"}]
    (is (= cfg (config/validate-config! cfg)))))

(deftest validate-config-accepts-nested-main
  (let [cfg {:main "scripts/dev.lg"}]
    (is (= cfg (config/validate-config! cfg)))))

(deftest validate-config-rejects-non-string-main
  (is (= :threw (threw? #(config/validate-config! {:main 5})))))

(deftest validate-config-rejects-blank-main
  (is (= :threw (threw? #(config/validate-config! {:main ""}))))
  (is (= :threw (threw? #(config/validate-config! {:main "   "})))))

(deftest validate-config-rejects-absolute-main
  (is (= :threw (threw? #(config/validate-config! {:main "/abs/main.lg"})))))

(deftest validate-config-rejects-parent-traversal-main
  (is (= :threw (threw? #(config/validate-config! {:main "../main.lg"}))))
  (is (= :threw (threw? #(config/validate-config! {:main "src/../etc.lg"})))))

;; ---------------------------------------------------------------------------
;; main accessor
;; ---------------------------------------------------------------------------

(deftest main-returns-nil-when-absent
  (is (nil? (:main (config/validate-config! {:deps {}})))))

(deftest main-reads-fixture
  (is (= "main.lg" (config/main "tests/fixtures/sample-project"))))

;; ---------------------------------------------------------------------------
;; :targets validation
;; ---------------------------------------------------------------------------

(deftest validate-config-accepts-targets-bin
  (let [cfg {:targets {:bin {:out "bin/app"}}}]
    (is (= cfg (config/validate-config! cfg)))))

(deftest validate-config-rejects-targets-not-a-map
  (is (= :threw (threw? #(config/validate-config! {:targets [:bin]})))))

(deftest validate-config-rejects-unknown-target
  (is (= :threw (threw? #(config/validate-config!
                           {:targets {:wasm {:out "out/app.wasm"}}})))))

(deftest validate-config-rejects-bin-not-a-map
  (is (= :threw (threw? #(config/validate-config!
                           {:targets {:bin "bin/app"}})))))

(deftest validate-config-rejects-bin-without-out
  (is (= :threw (threw? #(config/validate-config!
                           {:targets {:bin {}}})))))

(deftest validate-config-rejects-unknown-bin-key
  (is (= :threw (threw? #(config/validate-config!
                           {:targets {:bin {:out "bin/app"
                                            :foo 1}}})))))

(deftest validate-config-rejects-blank-out
  (is (= :threw (threw? #(config/validate-config!
                           {:targets {:bin {:out ""}}}))))
  (is (= :threw (threw? #(config/validate-config!
                           {:targets {:bin {:out "   "}}})))))

(deftest validate-config-rejects-absolute-out
  (is (= :threw (threw? #(config/validate-config!
                           {:targets {:bin {:out "/abs/app"}}})))))

(deftest validate-config-rejects-parent-traversal-out
  (is (= :threw (threw? #(config/validate-config!
                           {:targets {:bin {:out "../app"}}}))))
  (is (= :threw (threw? #(config/validate-config!
                           {:targets {:bin {:out "bin/../app"}}})))))

;; ---------------------------------------------------------------------------
;; targets accessor
;; ---------------------------------------------------------------------------

(deftest targets-returns-empty-when-absent
  (is (= {} (or (:targets (config/validate-config! {:deps {}})) {}))))

(deftest targets-reads-fixture
  (is (= {:bin {:out "bin/sample"}}
         (config/targets "tests/fixtures/sample-project"))))

;; ---------------------------------------------------------------------------
;; :tasks validation
;; ---------------------------------------------------------------------------

(deftest validate-config-accepts-minimal-task
  (let [cfg {:tasks {:fmt {:doc "Format"
                           :do [{:sh "echo hi"}]}}}]
    (is (= cfg (config/validate-config! cfg)))))

(deftest validate-config-accepts-task-without-doc
  (let [cfg {:tasks {:fmt {:do [{:sh "echo hi"}]}}}]
    (is (= cfg (config/validate-config! cfg)))))

(deftest validate-config-accepts-task-with-run-step
  (let [cfg {:tasks {:check {:do [{:run "scripts/test.lg"}]}}}]
    (is (= cfg (config/validate-config! cfg)))))

(deftest validate-config-accepts-task-with-vector-step-values
  (let [cfg {:tasks {:ci {:do [{:sh ["cljfmt" "check" "src"]}
                               {:run ["scripts/test.lg" "unit"]}]}}}]
    (is (= cfg (config/validate-config! cfg)))))

(deftest validate-config-accepts-multiple-tasks
  (let [cfg {:tasks {:fmt {:do [{:sh "echo a"}]}
                     :check {:do [{:run "scripts/test.lg"}]}
                     :ci {:do [{:sh "echo a"}
                               {:run "scripts/test.lg"}]}}}]
    (is (= cfg (config/validate-config! cfg)))))

(deftest validate-config-rejects-tasks-not-a-map
  (is (= :threw (threw? #(config/validate-config! {:tasks [:not :a :map]})))))

(deftest validate-config-rejects-non-keyword-task-name
  (is (= :threw (threw? #(config/validate-config!
                           {:tasks {"fmt" {:do [{:sh "echo hi"}]}}})))))

(deftest validate-config-rejects-non-map-task
  (is (= :threw (threw? #(config/validate-config!
                           {:tasks {:fmt "not-a-map"}})))))

(deftest validate-config-rejects-task-missing-do
  (is (= :threw (threw? #(config/validate-config!
                           {:tasks {:fmt {:doc "x"}}})))))

(deftest validate-config-rejects-task-with-non-string-doc
  (is (= :threw (threw? #(config/validate-config!
                           {:tasks {:fmt {:doc 5
                                          :do [{:sh "echo hi"}]}}})))))

(deftest validate-config-rejects-task-with-non-vector-do
  (is (= :threw (threw? #(config/validate-config!
                           {:tasks {:fmt {:do "echo hi"}}})))))

(deftest validate-config-rejects-task-with-empty-do
  (is (= :threw (threw? #(config/validate-config!
                           {:tasks {:fmt {:do []}}})))))

(deftest validate-config-rejects-step-not-a-map
  (is (= :threw (threw? #(config/validate-config!
                           {:tasks {:fmt {:do ["echo hi"]}}})))))

(deftest validate-config-rejects-step-with-multiple-action-keys
  (is (= :threw (threw? #(config/validate-config!
                           {:tasks {:fmt {:do [{:sh "echo a"
                                                :run "scripts/foo.lg"}]}}})))))

(deftest validate-config-rejects-step-with-no-action-key
  (is (= :threw (threw? #(config/validate-config!
                           {:tasks {:fmt {:do [{}]}}})))))

(deftest validate-config-rejects-step-with-unknown-key
  (is (= :threw (threw? #(config/validate-config!
                           {:tasks {:fmt {:do [{:sh "echo hi"
                                                :env {"FOO" "1"}}]}}})))))

(deftest validate-config-rejects-step-with-non-string-non-vector-value
  (is (= :threw (threw? #(config/validate-config!
                           {:tasks {:fmt {:do [{:sh 5}]}}})))))

(deftest validate-config-rejects-step-with-blank-string-value
  (is (= :threw (threw? #(config/validate-config!
                           {:tasks {:fmt {:do [{:sh ""}]}}})))))

(deftest validate-config-rejects-step-with-non-string-vector-item
  (is (= :threw (threw? #(config/validate-config!
                           {:tasks {:fmt {:do [{:sh ["echo" 5]}]}}})))))

(deftest validate-config-rejects-step-with-empty-vector-value
  (is (= :threw (threw? #(config/validate-config!
                           {:tasks {:fmt {:do [{:sh []}]}}})))))

(deftest validate-config-rejects-tasks-conflicting-with-builtins
  (doseq [n config/reserved-task-names]
    (is (= :threw (threw? #(config/validate-config!
                             {:tasks {(keyword n) {:do [{:sh "echo hi"}]}}})))))
  ;; Explicit spot-check: "test" must be reserved so projects can't shadow it.
  (is (contains? config/reserved-task-names "test"))
  (is (= :threw (threw? #(config/validate-config!
                           {:tasks {:test {:do [{:sh "echo hi"}]}}})))))

;; ---------------------------------------------------------------------------
;; Run
;; ---------------------------------------------------------------------------

(run-tests)
(when-not test/*test-result* (os/exit 1))
