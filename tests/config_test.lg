;; Unit tests for lgx.config — pure parsing/validation helpers.
;; Run with: lg tests/config_test.lg  (from project root)

(ns lgx.config-test
  (:require [lgx.config :as config]
            [test :refer [deftest is run-tests]]))

(defn- threw? [f]
  (try (f) :no-throw (catch e :threw)))

;; ---------------------------------------------------------------------------
;; validate-config!
;; ---------------------------------------------------------------------------

(deftest validate-config-accepts-valid-deps
  (is (= {:deps {'nooga/let-go {:git/url "https://github.com/nooga/let-go"
                                :git/sha "abc"}}}
         (config/validate-config!
           {:deps {'nooga/let-go {:git/url "https://github.com/nooga/let-go"
                                  :git/sha "abc"}}}))))

(deftest validate-config-accepts-tag-only-coord
  (is (= {:deps {'foo/bar {:git/url "https://github.com/foo/bar"
                           :git/tag "v0.1.0"}}}
         (config/validate-config!
           {:deps {'foo/bar {:git/url "https://github.com/foo/bar"
                             :git/tag "v0.1.0"}}}))))

(deftest validate-config-accepts-empty-deps
  (is (= {:deps {}} (config/validate-config! {:deps {}})))
  (is (= {} (config/validate-config! {}))))

(deftest validate-config-accepts-paths
  (is (= {:paths ["src" "resources"]
          :deps {}}
         (config/validate-config! {:paths ["src" "resources"]
                                   :deps {}}))))

(deftest validate-config-accepts-empty-paths
  (is (= {:paths []}
         (config/validate-config! {:paths []}))))

(deftest validate-config-rejects-non-map-top-level
  (is (= :threw (threw? #(config/validate-config! [:not :a :map])))))

(deftest validate-config-rejects-unknown-top-level-key
  (is (= :threw (threw? #(config/validate-config! {:deps {}
                                                   :extra 1})))))

(deftest validate-config-rejects-deps-not-a-map
  (is (= :threw (threw? #(config/validate-config! {:deps [:not :a :map]})))))

(deftest validate-config-rejects-paths-not-a-vector
  (is (= :threw (threw? #(config/validate-config! {:paths "src"})))))

(deftest validate-config-rejects-coord-missing-url
  (is (= :threw (threw? #(config/validate-config!
                           {:deps {'foo/bar {:git/sha "abc"}}})))))

(deftest validate-config-rejects-coord-without-sha-or-tag
  (is (= :threw (threw? #(config/validate-config!
                           {:deps {'foo/bar {:git/url "https://github.com/foo/bar"}}})))))

(deftest validate-config-rejects-non-map-coord
  (is (= :threw (threw? #(config/validate-config!
                           {:deps {'foo/bar "not-a-map"}})))))

(deftest validate-config-accepts-deps-root
  (let [cfg {:deps {'foo/bar {:git/url "https://github.com/foo/bar"
                              :git/sha "abc"
                              :deps/root "src/main/clojure"}}}]
    (is (= cfg (config/validate-config! cfg)))))

(deftest validate-config-rejects-blank-deps-root
  (is (= :threw (threw? #(config/validate-config!
                           {:deps {'foo/bar {:git/url "https://github.com/foo/bar"
                                             :git/sha "abc"
                                             :deps/root ""}}}))))
  (is (= :threw (threw? #(config/validate-config!
                           {:deps {'foo/bar {:git/url "https://github.com/foo/bar"
                                             :git/sha "abc"
                                             :deps/root "   "}}})))))

(deftest validate-config-rejects-non-string-deps-root
  (is (= :threw (threw? #(config/validate-config!
                           {:deps {'foo/bar {:git/url "https://github.com/foo/bar"
                                             :git/sha "abc"
                                             :deps/root 5}}})))))

(deftest validate-config-rejects-absolute-deps-root
  (is (= :threw (threw? #(config/validate-config!
                           {:deps {'foo/bar {:git/url "https://github.com/foo/bar"
                                             :git/sha "abc"
                                             :deps/root "/src"}}})))))

(deftest validate-config-rejects-parent-traversal
  (is (= :threw (threw? #(config/validate-config!
                           {:deps {'foo/bar {:git/url "https://github.com/foo/bar"
                                             :git/sha "abc"
                                             :deps/root ".."}}}))))
  (is (= :threw (threw? #(config/validate-config!
                           {:deps {'foo/bar {:git/url "https://github.com/foo/bar"
                                             :git/sha "abc"
                                             :deps/root "src/../etc"}}})))))

(deftest validate-config-rejects-blank-paths-entry
  (is (= :threw (threw? #(config/validate-config! {:paths [""]})))))

(deftest validate-config-rejects-non-string-paths-entry
  (is (= :threw (threw? #(config/validate-config! {:paths [5]})))))

(deftest validate-config-rejects-absolute-paths-entry
  (is (= :threw (threw? #(config/validate-config! {:paths ["/abs"]})))))

(deftest validate-config-rejects-parent-traversal-paths-entry
  (is (= :threw (threw? #(config/validate-config! {:paths ["../etc"]})))))

;; ---------------------------------------------------------------------------
;; coords
;; ---------------------------------------------------------------------------

(deftest coords-reads-and-parses-fixture
  (let [cs (config/coords "tests/fixtures/sample-project")
        m (into {} cs)]
    (is (= 2 (count cs)))
    (is (= "https://github.com/nooga/let-go" (:git/url (get m 'nooga/let-go))))
    (is (= "46ce159c9b23021ff7bf38c14e812516c1e2e359"
           (:git/sha (get m 'nooga/let-go))))
    (is (= "v0.1.0" (:git/tag (get m 'example/tagged))))))

;; ---------------------------------------------------------------------------
;; paths
;; ---------------------------------------------------------------------------

(deftest paths-returns-empty-when-absent
  (is (= [] (or (:paths (config/validate-config! {:deps {}})) []))))

(deftest paths-reads-fixture
  (is (= ["src" "test"] (config/paths "tests/fixtures/sample-project"))))

;; ---------------------------------------------------------------------------
;; Run
;; ---------------------------------------------------------------------------

(run-tests)
(when-not test/*test-result* (os/exit 1))
